{%- if settings.size_guide_enabled -%}
  <size-guide-modal
    class="theme-modal size-guide-modal"
    data-size-guide-modal
    data-size-guide-error="{{ 'products.product.size_guide_error' | t | escape }}"
    data-size-guide-empty="{{ 'products.product.size_guide_unavailable' | t | escape }}"
    aria-hidden="true"
    role="dialog"
    aria-modal="false"
    aria-label="{{ settings.size_guide_title | default: 'Size guide' | escape }}"
  >
    <div class="theme-modal__aligner">
      <div class="theme-modal__overlay"></div>
      <div class="theme-modal__panel">
        <div
          class="theme-modal__handle"
          data-theme-modal-drag
          aria-label="{{ 'general.modal.handle_drag_close' | t }}"
        ></div>
        <div class="theme-modal__loading" data-size-guide-loading>
          <span class="theme-modal__spinner" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </size-guide-modal>
{%- endif -%}
