{%- comment -%}
  Product grid card — shared across collection, search, and any product grid.

  @param {object}  product             - Product (or search result) object
  @param {boolean} show_secondary_image - Show second image on hover (default: false)
  @param {boolean} show_vendor          - Show vendor name (default: false)
  @param {boolean} show_quick_add       - Show quick-add button (default: false)
{%- endcomment -%}

{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif

  assign has_second = false
  if show_secondary_image and product.images.size > 1
    assign has_second = true
  endif

  assign primary_alt = product.featured_image.alt | default: product.title
  if has_second
    assign secondary_alt = product.images[1].alt | default: product.title
  endif
-%}

<article class="tcard{% if has_second %} tcard--has-alt{% endif %}{% unless product.available %} tcard--unavailable{% endunless %}">
  <a class="tcard__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image != blank -%}
      {{
        product.featured_image
        | image_url: width: 900
        | image_tag:
            loading: 'lazy',
            alt: primary_alt,
            class: 'tcard__img tcard__img--primary',
            widths: '360,480,640,900',
            sizes: '(min-width:75em) 25vw, (min-width:48em) 33vw, 50vw'
      }}
      {%- if has_second -%}
        {{
          product.images[1]
          | image_url: width: 900
          | image_tag:
              loading: 'lazy',
              alt: secondary_alt,
              class: 'tcard__img tcard__img--secondary',
              widths: '360,480,640,900',
              sizes: '(min-width:75em) 25vw, (min-width:48em) 33vw, 50vw'
        }}
      {%- endif -%}
    {%- else -%}
      <div class="tcard__placeholder" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
      </div>
    {%- endif -%}

    {%- if on_sale -%}
      <span class="tcard__badge tcard__badge--sale">{{ 'products.product.sale' | t | default: 'Sale' }}</span>
    {%- elsif product.available == false -%}
      <span class="tcard__badge tcard__badge--soldout">{{ 'products.product.sold_out' | t | default: 'Sold out' }}</span>
    {%- endif -%}
  </a>

  <div class="tcard__body">
    {%- if show_vendor and product.vendor != blank -%}
      <span class="tcard__vendor">{{ product.vendor }}</span>
    {%- endif -%}

    <a class="tcard__title" href="{{ product.url }}">
      {{ product.title | escape }}
    </a>

    <div class="tcard__prices">
      <span class="tcard__price{% if on_sale %} tcard__price--sale{% endif %}">
        {%- render 'price-display', price: product.price, variant: 'card' -%}
      </span>
      {%- if on_sale -%}
        <s class="tcard__price tcard__price--compare">
          {%- render 'price-display', price: product.compare_at_price, variant: 'card' -%}
        </s>
      {%- endif -%}
    </div>

    {%- if show_quick_add -%}
      {%- liquid
        assign first_variant = product.first_available_variant | default: product.variants.first
        assign has_multiple_variants = false
        if product.has_only_default_variant == false
          assign has_multiple_variants = true
        endif
      -%}
      {%- if first_variant -%}
        {%- if has_multiple_variants -%}
          <div class="tcard__atc">
            <a href="{{ product.url }}" class="tcard__atc-btn tcard__atc-btn--options">
              {{ 'products.product.choose_options' | t | default: 'Choose options' }}
            </a>
          </div>
        {%- else -%}
          <form
            action="{{ routes.cart_add_url }}"
            method="post"
            data-ajax-add-to-cart
            class="tcard__atc"
          >
            <input type="hidden" name="id" value="{{ first_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button
              type="submit"
              class="tcard__atc-btn"
              data-product-submit
              data-product-available="{{ first_variant.available }}"
              {% unless first_variant.available %}disabled{% endunless %}
            >
              {%- if first_variant.available -%}
                {{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}
              {%- else -%}
                {{ 'products.product.sold_out' | t | default: 'Sold out' }}
              {%- endif -%}
            </button>
          </form>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</article>
