{%- comment -%}
  Product grid card — shared across collection, search, and any product grid.

  @param {object}  product             - Product (or search result) object
  @param {boolean} show_secondary_image - Show second image on hover (default: false)
  @param {boolean} show_vendor          - Show vendor name (default: false)
  @param {boolean} show_quick_add       - Show quick-add button (default: false)
{%- endcomment -%}

{%- liquid
  assign on_sale = false
  assign sale_discount_pct = 0
  if product.compare_at_price > product.price
    assign on_sale = true
    if product.compare_at_price > 0
      assign sale_save = product.compare_at_price | minus: product.price
      assign sale_discount_pct = sale_save | times: 100.0 | divided_by: product.compare_at_price | round
      if sale_discount_pct < 1
        assign sale_discount_pct = 1
      endif
    endif
  endif

  assign first_media = blank
  assign leading_is_video = false
  if product.media.size > 0
    assign first_media = product.media.first
    if first_media.media_type == 'video' or first_media.media_type == 'external_video'
      assign leading_is_video = true
    endif
  endif

  assign has_second = false
  unless leading_is_video
    if show_secondary_image and product.images.size > 1
      assign has_second = true
      assign secondary_alt = product.images[1].alt | default: product.title
    endif
  endunless

  assign primary_alt = product.featured_image.alt | default: product.title
  if leading_is_video
    assign primary_alt = first_media.alt | default: product.title
  endif

  assign tcard_hover_video = leading_is_video
-%}

<article class="tcard{% if leading_is_video %} tcard--leading-video{% endif %}{% if has_second %} tcard--has-alt{% endif %}{% unless product.available %} tcard--unavailable{% endunless %}">
  <a
    class="tcard__media{% if leading_is_video %} tcard__media--video-lead{% endif %}"
    href="{{ product.url }}"
    tabindex="-1"
    aria-hidden="true"
    {% if tcard_hover_video %}data-tcard-hover-video{% endif %}
  >
    {%- if leading_is_video -%}
      <span class="tcard__video-track">
        {{
          first_media
          | video_tag:
            image_size: '900x',
            autoplay: false,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'metadata',
            class: 'tcard__video'
        }}
      </span>
    {%- elsif product.featured_image != blank -%}
      {{
        product.featured_image
        | image_url: width: 900
        | image_tag:
            loading: 'lazy',
            alt: primary_alt,
            class: 'tcard__img tcard__img--primary',
            widths: '360,480,640,900',
            sizes: '(min-width:75em) 25vw, (min-width:48em) 33vw, 50vw'
      }}
      {%- if has_second -%}
        {{
          product.images[1]
          | image_url: width: 900
          | image_tag:
              loading: 'lazy',
              alt: secondary_alt,
              class: 'tcard__img tcard__img--secondary',
              widths: '360,480,640,900',
              sizes: '(min-width:75em) 25vw, (min-width:48em) 33vw, 50vw'
        }}
      {%- endif -%}
    {%- else -%}
      <div class="tcard__placeholder" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
      </div>
    {%- endif -%}

    {%- if on_sale or leading_is_video or product.available == false -%}
      <div class="tcard__badges">
        {%- if leading_is_video -%}
          <span class="tcard__badge tcard__badge--video">
            <svg 
              class="tcard__badge-video-icon tcard__badge-video-icon--play"
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            ><path d="M8 5v14l11-7L8 5z"/></svg>
            <svg
              class="tcard__badge-video-icon tcard__badge-video-icon--pause"
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            ><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
          </span>
        {%- endif -%}
        {%- if on_sale -%}
          <span class="tcard__badge tcard__badge--sale">{{ 'products.product.sale_badge_percent' | t: percent: sale_discount_pct }}</span>
        {%- endif -%}
        {%- if product.available == false -%}
          <span class="tcard__badge tcard__badge--soldout">{{ 'products.product.sold_out' | t | default: 'Sold out' }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </a> 

  <div class="tcard__body">
    {%- if show_vendor and product.vendor != blank -%}
      <span class="tcard__vendor">{{ product.vendor }}</span>
    {%- endif -%}

    <a class="tcard__title" href="{{ product.url }}">
      {{ product.title | escape }}
    </a>

    <div class="tcard__prices">
      <span class="tcard__price{% if on_sale %} tcard__price--sale{% endif %}">
        {%- render 'price-display', price: product.price, variant: 'card' -%}
      </span>
      {%- if on_sale -%}
        <s class="tcard__price tcard__price--compare">
          {%- render 'price-display', price: product.compare_at_price, variant: 'card' -%}
        </s>
      {%- endif -%}
    </div>

    {%- if show_quick_add -%}
      {%- liquid
        assign first_variant = product.first_available_variant | default: product.variants.first
        assign has_multiple_variants = false
        if product.has_only_default_variant == false
          assign has_multiple_variants = true
        endif
      -%}
      {%- if first_variant -%}
        {%- if has_multiple_variants -%}
          <div class="tcard__atc">
            <a href="{{ product.url }}" class="tcard__atc-btn tcard__atc-btn--options">
              {{ 'products.product.choose_options' | t | default: 'Choose options' }}
            </a>
          </div>
        {%- else -%}
          <form
            action="{{ routes.cart_add_url }}"
            method="post"
            data-ajax-add-to-cart
            class="tcard__atc"
          >
            <input type="hidden" name="id" value="{{ first_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button
              type="submit"
              class="tcard__atc-btn"
              data-product-submit
              data-product-available="{{ first_variant.available }}"
              {% unless first_variant.available %}disabled{% endunless %}
            >
              {%- if first_variant.available -%}
                {{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}
              {%- else -%}
                {{ 'products.product.sold_out' | t | default: 'Sold out' }}
              {%- endif -%}
            </button>
          </form>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</article>
