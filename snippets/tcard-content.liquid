{%- comment -%}
  Content card for articles and pages — used in search results.

  @param {object} result - Article or page search result object
{%- endcomment -%}

{%- liquid
  assign result_image = result.featured_image | default: result.image
  assign type_key = 'search.result_type_' | append: result.object_type
-%}

<a class="tcard-content" href="{{ result.url }}">
  <div class="tcard-content__media">
    {%- if result_image != blank -%}
      {{
        result_image
        | image_url: width: 600
        | image_tag:
            loading: 'lazy',
            class: 'tcard-content__img',
            sizes: '(min-width: 62em) 280px, (min-width: 36em) 40vw, 100vw',
            widths: '240, 360, 480, 600'
      }}
    {%- else -%}
      <span class="tcard-content__placeholder" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          {%- if result.object_type == 'article' -%}
            <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/>
          {%- else -%}
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/>
          {%- endif -%}
        </svg>
      </span>
    {%- endif -%}
  </div>
  <div class="tcard-content__body">
    <span class="tcard-content__type">{{ type_key | t }}</span>
    <span class="tcard-content__title">{{ result.title | escape }}</span>
    {%- if result.object_type == 'article' -%}
      {%- liquid
        assign excerpt_source = result.excerpt | default: result.content
      -%}
      {%- if excerpt_source != blank -%}
        <span class="tcard-content__excerpt">
          {{- excerpt_source | strip_html | truncate: 120 -}}
        </span>
      {%- endif -%}
    {%- endif -%}
  </div>
</a>
