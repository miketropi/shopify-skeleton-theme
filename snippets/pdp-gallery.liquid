{%- comment -%}
  PDP media column: placeholder, single image, stacked gallery, or Swiper + optional thumbs.

  Pass: `product`, `section`, `show_compare`, `off_pct`, `block` (gallery block — optional, layout defaults if blank)

  Layout values: carousel_thumbs_left | carousel_thumbs_bottom | carousel_no_thumbs | stacked
{%- endcomment -%}
{%- liquid
  assign gallery_layout = 'carousel_thumbs_left'
  if block != blank and block.settings.gallery_layout != blank
    assign gallery_layout = block.settings.gallery_layout
  endif
  assign show_thumbs = true
  if gallery_layout == 'carousel_no_thumbs' or gallery_layout == 'stacked'
    assign show_thumbs = false
  endif
  assign gallery_frame_modifier = ''
  if gallery_layout == 'carousel_thumbs_bottom'
    assign gallery_frame_modifier = ' main-product__gallery-frame--layout-carousel-thumbs-bottom'
  elsif gallery_layout == 'carousel_no_thumbs'
    assign gallery_frame_modifier = ' main-product__gallery-frame--layout-carousel-no-thumbs'
  elsif gallery_layout == 'stacked'
    assign gallery_frame_modifier = ' main-product__gallery-frame--layout-stacked'
  endif
-%}
<div
  class="main-product__media"
  data-product-gallery
  data-gallery-layout="{{ gallery_layout }}"
  data-active-media-id="{{ product.media.first.id }}"
>
  {%- if product.media.size == 0 -%}
    <div class="main-product__media-inner">
      <div class="main-product__media-placeholder" aria-hidden="true"></div>
    </div>
  {%- elsif product.media.size == 1 -%}
    {%- assign one_media = product.media.first -%}
    <div class="main-product__media-inner main-product__media-inner--static">
      {%- if section.settings.show_sale_badge -%}
        <span
          class="main-product__badge{% unless show_compare and off_pct > 0 %} is-visually-hidden{% endunless %}"
          data-product-badge
          {% unless show_compare and off_pct > 0 %}
            hidden
          {% endunless %} 
        >
          {%- if show_compare and off_pct > 0 -%}
            {{- 'products.product.sale_percent' | t: percent: off_pct -}} 
          {%- endif -%}
        </span>
      {%- endif -%}
      {%- render 'pdp-gallery-slide-media',
        media: one_media,
        product: product,
        section: section,
        figure_layout: 'slide',
        is_first: true,
        sizes: '(min-width: 900px) 48vw, 100vw',
        stack_item: false
      -%}
    </div>
  {%- elsif gallery_layout == 'stacked' -%}
    <div class="main-product__gallery-frame{{ gallery_frame_modifier }}" data-product-gallery-frame>
      {%- if section.settings.show_sale_badge -%}
        <span
          class="main-product__badge{% unless show_compare and off_pct > 0 %} is-visually-hidden{% endunless %}"
          data-product-badge
          {% unless show_compare and off_pct > 0 %}
            hidden
          {% endunless %}
        >
          {%- if show_compare and off_pct > 0 -%}
            {{- 'products.product.sale_percent' | t: percent: off_pct -}}
          {%- endif -%}
        </span>
      {%- endif -%}
      <div class="main-product__gallery-stack">
        {%- for media in product.media -%}
          {%- render 'pdp-gallery-slide-media',
            media: media,
            product: product,
            section: section,
            figure_layout: 'stack',
            is_first: forloop.first,
            sizes: '(min-width: 900px) 48vw, 100vw',
            stack_item: true
          -%}
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <div class="main-product__gallery-frame{{ gallery_frame_modifier }}" data-product-gallery-frame>
      <div class="main-product__gallery-main">
        {%- if section.settings.show_sale_badge -%}
          <span
            class="main-product__badge{% unless show_compare and off_pct > 0 %} is-visually-hidden{% endunless %}"
            data-product-badge
            {% unless show_compare and off_pct > 0 %}
              hidden
            {% endunless %}
          >
            {%- if show_compare and off_pct > 0 -%}
              {{- 'products.product.sale_percent' | t: percent: off_pct -}}
            {%- endif -%}
          </span>
        {%- endif -%}

        <div class="swiper main-product__swiper" data-product-swiper>
          <div class="swiper-wrapper">
            {%- for media in product.media -%}
              <div class="swiper-slide main-product__slide" data-media-id="{{ media.id }}">
                {%- render 'pdp-gallery-slide-media',
                  media: media,
                  product: product,
                  section: section,
                  figure_layout: 'slide',
                  is_first: forloop.first,
                  sizes: '(min-width: 900px) 42vw, 100vw',
                  stack_item: false
                -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div
          class="main-product__gallery-toolbar"
          role="group"
          aria-label="{{ 'products.product.gallery_toolbar' | t }}"
          data-product-gallery-toolbar
        >
          <button
            type="button"
            class="main-product__nav-btn main-product__nav-btn--prev"
            data-product-nav-prev
            aria-label="{{ 'products.product.slideshow_prev' | t }}"
          >
            <span class="main-product__nav-icon" aria-hidden="true">‹</span>
          </button>
          <button
            type="button"
            class="main-product__nav-btn main-product__nav-btn--next"
            data-product-nav-next
            aria-label="{{ 'products.product.slideshow_next' | t }}"
          >
            <span class="main-product__nav-icon" aria-hidden="true">›</span>
          </button>
        </div>
      </div>

      {%- if show_thumbs -%}
        <div class="main-product__thumbs-outer">
          <div class="swiper main-product__thumbs-swiper" data-product-thumbs-swiper>
            <div class="swiper-wrapper">
              {%- for media in product.media -%}
                {%- liquid
                  assign thumb_image = media
                  if media.media_type != 'image'
                    assign thumb_image = media.preview_image
                  endif
                  assign t_alt = media.alt | default: product.title
                  assign thumb_is_video = false
                  if media.media_type == 'video' or media.media_type == 'external_video'
                    assign thumb_is_video = true
                  endif
                -%}
                <div class="swiper-slide main-product__thumb-slide" data-media-id="{{ media.id }}">
                  <button
                    type="button"
                    class="main-product__thumb{% if thumb_is_video %} main-product__thumb--video{% endif %}"
                    data-product-thumb
                    data-media-id="{{ media.id }}"
                    aria-label="{{ 'products.product.open_image' | t }}"
                    aria-pressed="{% if forloop.first -%}true{%- else -%}false{%- endif -%}"
                  >
                    {%- if thumb_image != blank -%}
                      {{
                        thumb_image
                        | image_url: width: 400
                        | image_tag:
                          loading: 'lazy',
                          class: 'main-product__thumb-img',
                          widths: '200, 400',
                          sizes: '80px',
                          alt: '',
                          title: t_alt
                      }}
                    {%- endif -%}
                  </button>
                </div>
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
