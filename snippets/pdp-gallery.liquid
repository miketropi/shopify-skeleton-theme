{%- comment -%}
  PDP media column: placeholder, single image, or Swiper gallery + thumbs.
  Pass: `product`, `section`, `show_compare`, `off_pct`
{%- endcomment -%}
<div
  class="main-product__media"
  data-product-gallery
  data-active-media-id="{{ product.media.first.id }}"
>
  {%- if product.media.size == 0 -%}
    <div class="main-product__media-inner">
      <div class="main-product__media-placeholder" aria-hidden="true"></div>
    </div>
  {%- elsif product.media.size == 1 -%}
    {%- assign one_media = product.media.first -%}
    {%- assign one_alt = one_media.alt | default: product.title -%}
    <div class="main-product__media-inner main-product__media-inner--static">
      {%- if section.settings.show_sale_badge -%}
        <span
          class="main-product__badge{% unless show_compare and off_pct > 0 %} is-visually-hidden{% endunless %}"
          data-product-badge
          {% unless show_compare and off_pct > 0 %}
            hidden
          {% endunless %}
        >
          {%- if show_compare and off_pct > 0 -%}
            {{- 'products.product.sale_percent' | t: percent: off_pct -}}
          {%- endif -%}
        </span>
      {%- endif -%}
      <figure
        class="main-product__figure main-product__figure--slide"
        data-product-feature-figure
        data-media-id="{{ one_media.id }}"
      >
        <img
          class="main-product__image"
          data-product-slide-img
          src="{{ one_media | image_url: width: 1600 }}"
          srcset="{{ one_media | image_url: width: 480 }} 480w, {{ one_media | image_url: width: 720 }} 720w, {{ one_media | image_url: width: 960 }} 960w, {{ one_media | image_url: width: 1200 }} 1200w, {{ one_media | image_url: width: 1600 }} 1600w"
          sizes="(min-width: 900px) 48vw, 100vw"
          width="1600"
          height="{{ 1600 | divided_by: one_media.aspect_ratio | ceil }}"
          alt="{{ one_alt | escape }}"
          fetchpriority="high"
          loading="eager"
        >
      </figure>
    </div>
  {%- else -%}
    <div class="main-product__gallery-frame" data-product-gallery-frame>
      <div class="main-product__gallery-main">
        {%- if section.settings.show_sale_badge -%}
          <span
            class="main-product__badge{% unless show_compare and off_pct > 0 %} is-visually-hidden{% endunless %}"
            data-product-badge
            {% unless show_compare and off_pct > 0 %}
              hidden
            {% endunless %}
          >
            {%- if show_compare and off_pct > 0 -%}
              {{- 'products.product.sale_percent' | t: percent: off_pct -}}
            {%- endif -%}
          </span>
        {%- endif -%}

        <div class="swiper main-product__swiper" data-product-swiper>
          <div class="swiper-wrapper">
            {%- for media in product.media -%}
              {%- assign slide_alt = media.alt | default: product.title -%}
              <div class="swiper-slide main-product__slide" data-media-id="{{ media.id }}">
                <figure
                  class="main-product__figure main-product__figure--slide"
                  data-product-feature-figure
                  data-media-id="{{ media.id }}"
                >
                  <img
                    class="main-product__image"
                    data-product-slide-img
                    src="{{ media | image_url: width: 1600 }}"
                    srcset="{{ media | image_url: width: 480 }} 480w, {{ media | image_url: width: 720 }} 720w, {{ media | image_url: width: 960 }} 960w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1600 }} 1600w"
                    sizes="(min-width: 900px) 42vw, 100vw"
                    width="1600"
                    height="{{ 1600 | divided_by: media.aspect_ratio | ceil }}"
                    alt="{{ slide_alt | escape }}"
                    loading="{% if forloop.first -%}eager{%- else -%}lazy{%- endif -%}"
                    {%- if forloop.first -%}
                      fetchpriority="high"
                    {%- endif -%}
                  >
                </figure>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div
          class="main-product__gallery-toolbar"
          role="group"
          aria-label="{{ 'products.product.gallery_toolbar' | t }}"
          data-product-gallery-toolbar
        >
          <button
            type="button"
            class="main-product__nav-btn main-product__nav-btn--prev"
            data-product-nav-prev
            aria-label="{{ 'products.product.slideshow_prev' | t }}"
          >
            <span class="main-product__nav-icon" aria-hidden="true">‹</span>
          </button>
          <button
            type="button"
            class="main-product__nav-btn main-product__nav-btn--next"
            data-product-nav-next
            aria-label="{{ 'products.product.slideshow_next' | t }}"
          >
            <span class="main-product__nav-icon" aria-hidden="true">›</span>
          </button>
        </div>
      </div>

      <div class="main-product__thumbs-outer">
        <div class="swiper main-product__thumbs-swiper" data-product-thumbs-swiper>
          <div class="swiper-wrapper">
            {%- for media in product.media -%}
              {%- assign t_alt = media.alt | default: product.title -%}
              <div class="swiper-slide main-product__thumb-slide" data-media-id="{{ media.id }}">
                <button
                  type="button"
                  class="main-product__thumb"
                  data-product-thumb
                  data-media-id="{{ media.id }}"
                  aria-label="{{ 'products.product.open_image' | t }}"
                  aria-pressed="{% if forloop.first -%}true{%- else -%}false{%- endif -%}"
                >
                  {{
                    media
                    | image_url: width: 400
                    | image_tag:
                      loading: 'lazy',
                      class: 'main-product__thumb-img',
                      widths: '200, 400',
                      sizes: '80px',
                      alt: '',
                      title: t_alt
                  }}
                </button>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}
</div>
