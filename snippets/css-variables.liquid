{%- liquid
  assign use_custom_fonts = false
  if settings.typography_mode == 'custom'
    assign use_custom_fonts = true
  endif

  assign use_custom_colors = false
  if settings.color_mode == 'custom'
    assign use_custom_colors = true
  endif

  assign s = false
  unless use_custom_colors
    assign gs = settings.global_color_scheme
    if gs == blank or gs.settings == blank
      assign gs = settings.color_schemes['scheme-6']
    endif
    if gs != blank and gs.settings != blank
      assign s = gs.settings
    endif
  endunless

  unless use_custom_fonts
    assign fp = settings.font_pairing
    case fp
      when 'arial'
        assign root_font_heading = "Arial, 'Helvetica Neue', Helvetica, system-ui, sans-serif"
        assign root_font_body = "Arial, 'Helvetica Neue', Helvetica, system-ui, sans-serif"
        assign root_font_mono = "ui-monospace, 'Cascadia Mono', 'Segoe UI Mono', 'Roboto Mono', Menlo, Consolas, monospace"
      when 'neutral', 'modern'
        assign root_font_heading = "'Plus Jakarta Sans', system-ui, sans-serif"
        assign root_font_body = "'DM Sans', system-ui, sans-serif"
        assign root_font_mono = "'DM Mono', monospace"
      when 'vision', 'atelier', 'meridian'
        assign root_font_heading = "'Fraunces', Georgia, serif"
        assign root_font_body = "'Manrope', system-ui, sans-serif"
        assign root_font_mono = "'Fira Code', ui-monospace, monospace"
      when 'technology', 'technical'
        assign root_font_heading = "'JetBrains Mono', ui-monospace, 'Cascadia Code', monospace"
        assign root_font_body = "'Inter', system-ui, sans-serif"
        assign root_font_mono = "'JetBrains Mono', ui-monospace, monospace"
      else
        assign root_font_heading = "'Plus Jakarta Sans', system-ui, sans-serif"
        assign root_font_body = "'DM Sans', system-ui, sans-serif"
        assign root_font_mono = "'DM Mono', monospace"
    endcase
  endunless

  assign fsb_key = settings.font_size_base | append: ''
  if fsb_key == blank
    assign fsb_key = '16'
  endif
  case fsb_key
    when '18'
      assign base_num = 18
    when '20'
      assign base_num = 20
    else
      assign base_num = 16
  endcase

  assign fs_xs = base_num | times: 0.64 | round: 2
  assign fs_sm = base_num | times: 0.8 | round: 2
  assign fs_base = base_num | round: 2
  assign fs_lg = base_num | times: 1.25 | round: 2
  assign fs_xl = base_num | times: 1.5625 | round: 2
  assign fs_2xl = base_num | times: 1.953125 | round: 2
  assign fs_3xl = base_num | times: 2.44140625 | round: 2
  assign fs_4xl = base_num | times: 3.0517578125 | round: 2

  assign fs_base_min = base_num | times: 0.875 | round: 2
  assign fs_lg_min = fs_lg | times: 0.85 | round: 2
  assign fs_xl_min = fs_xl | times: 0.8 | round: 2
  assign fs_2xl_min = fs_2xl | times: 0.75 | round: 2
  assign fs_3xl_min = fs_3xl | times: 0.7 | round: 2
  assign fs_4xl_min = fs_4xl | times: 0.65 | round: 2
-%}
{% style %}
  {%- if use_custom_fonts -%}
    {%- unless settings.type_font_heading.system? -%}
      {{ settings.type_font_heading | font_face: font_display: 'swap' }}
      {{ settings.type_font_heading | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
    {%- endunless -%}
    {%- unless settings.type_font_body.system? -%}
      {{ settings.type_font_body | font_face: font_display: 'swap' }}
      {{ settings.type_font_body | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
      {{ settings.type_font_body | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
      {{ settings.type_font_body | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
    {%- endunless -%}
    {%- unless settings.type_font_mono.system? -%}
      {{ settings.type_font_mono | font_face: font_display: 'swap' }}
    {%- endunless -%}
  {%- endif -%}

  :root {
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --style-border-radius-inputs: 8px;
    {%- if use_custom_colors -%}
      --cs-background: {{ settings.custom_color_background | default: '#ffffff' }};
      --cs-background-secondary: {{ settings.custom_color_background_secondary | default: '#f5f3ef' }};
      --cs-border: {{ settings.custom_color_border | default: '#e8e6e1' }};
      --cs-text: {{ settings.custom_color_text | default: '#1a1a1a' }};
      --cs-text-secondary: {{ settings.custom_color_text_secondary | default: '#9e9b96' }};
      --cs-heading: {{ settings.custom_color_heading | default: '#0a0a0a' }};
      --cs-accent: {{ settings.custom_color_accent | default: '#e85d30' }};
      --cs-accent-text: {{ settings.custom_color_accent_text | default: '#ffffff' }};
      --cs-btn-primary-bg: {{ settings.custom_color_btn_primary_bg | default: '#1a1a1a' }};
      --cs-btn-primary-text: {{ settings.custom_color_btn_primary_text | default: '#ffffff' }};
      --cs-btn-primary-border: {{ settings.custom_color_btn_primary_border | default: '#1a1a1a' }};
      --cs-btn-secondary-bg: {{ settings.custom_color_btn_secondary_bg | default: '#ffffff' }};
      --cs-btn-secondary-text: {{ settings.custom_color_btn_secondary_text | default: '#1a1a1a' }};
      --cs-btn-secondary-border: {{ settings.custom_color_btn_secondary_border | default: '#1a1a1a' }};
      --color-background: {{ settings.custom_color_background | default: '#ffffff' }};
      --color-foreground: {{ settings.custom_color_text | default: '#1a1a1a' }};
    {%- elsif s -%}
      --cs-background: {{ s.background }};
      --cs-background-secondary: {{ s.background_secondary }};
      --cs-border: {{ s.border }};
      --cs-text: {{ s.text }};
      --cs-text-secondary: {{ s.text_secondary }};
      --cs-heading: {{ s.heading }};
      --cs-accent: {{ s.accent }};
      --cs-accent-text: {{ s.accent_text }};
      --cs-btn-primary-bg: {{ s.btn_primary_bg }};
      --cs-btn-primary-text: {{ s.btn_primary_text }};
      --cs-btn-primary-border: {{ s.btn_primary_border }};
      --cs-btn-secondary-bg: {{ s.btn_secondary_bg }};
      --cs-btn-secondary-text: {{ s.btn_secondary_text }};
      --cs-btn-secondary-border: {{ s.btn_secondary_border }};
      --color-background: {{ s.background }};
      --color-foreground: {{ s.text }};
    {%- else -%}
      --cs-background: #ffffff;
      --cs-background-secondary: #f4f4f5; 
      --cs-border: #e4e4e7;
      --cs-text: #27272a;
      --cs-text-secondary: #71717a;
      --cs-heading: #18181b;
      --cs-accent: #2563eb;
      --cs-accent-text: #ffffff;
      --cs-btn-primary-bg: #18181b;
      --cs-btn-primary-text: #ffffff;
      --cs-btn-primary-border: #18181b;
      --cs-btn-secondary-bg: #ffffff;
      --cs-btn-secondary-text: #18181b;
      --cs-btn-secondary-border: #d4d4d8;
      --color-background: #ffffff;
      --color-foreground: #27272a;
    {%- endif -%}
    {%- if use_custom_fonts -%}
      --cs-font-heading: {{ settings.type_font_heading.family }}, {{ settings.type_font_heading.fallback_families }};
      --cs-font-body: {{ settings.type_font_body.family }}, {{ settings.type_font_body.fallback_families }};
      --cs-font-mono: {{ settings.type_font_mono.family }}, {{ settings.type_font_mono.fallback_families }};
    {%- else -%}
      --cs-font-heading: {{ root_font_heading }};
      --cs-font-body: {{ root_font_body }};
      --cs-font-mono: {{ root_font_mono }};
    {%- endif -%}

    --line-height-tight: 1.12;
    --line-height-snug: 1.25;
    --line-height-normal: 1.55;
    --line-height-relaxed: 1.625;

    --font-size-xs: {{ fs_xs }}px;
    --font-size-sm: {{ fs_sm }}px;
    --font-size-base: clamp(
      {{ fs_base_min }}px,
      calc(
        {{ fs_base_min }}px + ({{ fs_base }}px - {{ fs_base_min }}px) * ((100vw - 375px) / (1440px - 375px))
      ),
      {{ fs_base }}px
    );
    --font-size-lg: clamp(
      {{ fs_lg_min }}px,
      calc(
        {{ fs_lg_min }}px + ({{ fs_lg }}px - {{ fs_lg_min }}px) * ((100vw - 375px) / (1440px - 375px))
      ),
      {{ fs_lg }}px
    );
    --font-size-xl: clamp(
      {{ fs_xl_min }}px,
      calc(
        {{ fs_xl_min }}px + ({{ fs_xl }}px - {{ fs_xl_min }}px) * ((100vw - 375px) / (1440px - 375px))
      ),
      {{ fs_xl }}px
    );
    --font-size-2xl: clamp(
      {{ fs_2xl_min }}px,
      calc(
        {{ fs_2xl_min }}px + ({{ fs_2xl }}px - {{ fs_2xl_min }}px) * ((100vw - 375px) / (1440px - 375px))
      ),
      {{ fs_2xl }}px
    );
    --font-size-3xl: clamp(
      {{ fs_3xl_min }}px,
      calc(
        {{ fs_3xl_min }}px + ({{ fs_3xl }}px - {{ fs_3xl_min }}px) * ((100vw - 375px) / (1440px - 375px))
      ),
      {{ fs_3xl }}px
    );
    --font-size-4xl: clamp(
      {{ fs_4xl_min }}px,
      calc(
        {{ fs_4xl_min }}px + ({{ fs_4xl }}px - {{ fs_4xl_min }}px) * ((100vw - 375px) / (1440px - 375px))
      ),
      {{ fs_4xl }}px
    );
  }
{% endstyle %}
