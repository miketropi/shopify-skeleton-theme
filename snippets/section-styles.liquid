{%- comment -%}
  snippets/section-styles.liquid
  ────────────────────────────────────────────────────────────────────────────
  Section shell: padding (4 sides), margin (top/bottom), background, border,
  and per-corner radius (--section-radius-tl/tr/br/bl).

  Usage:
    {%- render 'section-styles', section: section -%}
  On the same section root, add class `shopify-section-wrapper` + color-scheme vars.

  Copy the JSON block at the bottom into each section schema (ids must match).

  See: src/styles/base/_section-wrapper.scss
{%- endcomment -%}

{%- liquid
  assign pt = section.settings.padding_top | default: 40
  assign pr = section.settings.padding_right | default: 0
  assign pb = section.settings.padding_bottom | default: 40
  assign pl = section.settings.padding_left | default: 0
  assign mt = section.settings.margin_top | default: 0
  assign mb = section.settings.margin_bottom | default: 0
  assign bg = section.settings.background_color

  assign border_w = section.settings.border_width | default: 0
  assign border_style = section.settings.border_style | default: 'solid'
  assign r_tl = section.settings.border_radius_top_left | default: 0
  assign r_tr = section.settings.border_radius_top_right | default: 0
  assign r_br = section.settings.border_radius_bottom_right | default: 0
  assign r_bl = section.settings.border_radius_bottom_left | default: 0
  assign border_c = section.settings.border_color
-%}

<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ pt }}px;
    --section-padding-right: {{ pr }}px;
    --section-padding-bottom: {{ pb }}px;
    --section-padding-left: {{ pl }}px;
    --section-margin-top: {{ mt }}px;
    --section-margin-bottom: {{ mb }}px;
    --section-border-width: {{ border_w }}px;
    --section-border-style: {{ border_style }};
    --section-radius-tl: {{ r_tl }}px;
    --section-radius-tr: {{ r_tr }}px;
    --section-radius-br: {{ r_br }}px;
    --section-radius-bl: {{ r_bl }}px;
{%- if bg != blank
  and bg != 'rgba(0,0,0,0)'
  and bg != 'rgba(0, 0, 0, 0)'
-%}
    --section-bg: {{ bg }};
{%- endif -%}
{%- if border_c != blank
  and border_c != 'rgba(0,0,0,0)'
  and border_c != 'rgba(0, 0, 0, 0)'
-%}
    --section-border-color: {{ border_c }};
{%- endif -%}
  }
</style>

