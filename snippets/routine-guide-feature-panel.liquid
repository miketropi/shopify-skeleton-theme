{%- comment -%}
  Routine Guide — stacked feature media (image or video crossfade on active step).
  Expects: section, default_zero, feature_img_width, feature_img_widths,
           feature_video_image_size, step_count
{%- endcomment -%}
{%- if step_count > 0 -%}
  <div class="routine-guide__feature" data-routine-guide-reveal-feature>
    <div class="routine-guide__feature-motion">
      <div class="routine-guide__feature-stack">
        {%- assign step_i = -1 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign step_i = step_i | plus: 1 -%}
            {%- assign img = block.settings.feature_image -%}
            {%- assign pos = block.settings.feature_image_position | default: 'center center' -%}
            {%- assign is_active = false -%}
            {%- if step_i == default_zero -%}
              {%- assign is_active = true -%}
            {%- endif -%}
            {%- liquid
              assign media_type = block.settings.media_type | default: 'image'
              assign use_video = false
              if media_type == 'video' and block.settings.video != blank
                assign use_video = true
              endif

              assign img_alt = img.alt | default: ''
              if img_alt == blank and block.settings.heading != blank
                assign img_alt = block.settings.heading
              endif
              assign img_alt_e = img_alt | escape
              assign media_style = 'object-position: ' | append: pos | append: ';'
              assign ph_mod = step_i | modulo: 3

              assign video_poster_url = ''
              if use_video and img != blank
                assign video_poster_url = img | image_url: width: feature_img_width
              endif

              assign video_preload = 'none'
              if is_active
                assign video_preload = 'metadata'
              endif
            -%}
            <div
              class="routine-guide__feature-layer{% if is_active %} is-active{% endif %}"
              data-routine-guide-media
              data-routine-guide-index="{{ step_i }}"
              aria-hidden="{% if is_active %}false{% else %}true{% endif %}"
              {% if step_i == 0 %}{{ block.shopify_attributes }}{% endif %}
            >
              <div class="routine-guide__feature-media">
                {%- if use_video -%}
                  {%- if video_poster_url != blank -%}
                    {{
                      block.settings.video
                      | video_tag:
                        autoplay: is_active,
                        loop: true,
                        muted: true,
                        controls: false,
                        playsinline: true,
                        preload: video_preload,
                        class: 'routine-guide__feature-video',
                        style: media_style,
                        image_size: feature_video_image_size,
                        poster: video_poster_url
                    }}
                  {%- else -%}
                    {{
                      block.settings.video
                      | video_tag:
                        autoplay: is_active,
                        loop: true,
                        muted: true,
                        controls: false,
                        playsinline: true,
                        preload: video_preload,
                        class: 'routine-guide__feature-video',
                        style: media_style,
                        image_size: feature_video_image_size
                    }}
                  {%- endif -%}
                {%- elsif img != blank -%}
                  {%- assign img_loading = 'lazy' -%}
                  {%- if is_active -%}
                    {%- assign img_loading = 'eager' -%}
                  {%- endif -%}
                  {%- assign img_h = feature_img_width | times: 1.0 | divided_by: img.aspect_ratio | round -%}
                  <img
                    class="routine-guide__feature-img"
                    src="{{ img | image_url: width: feature_img_width }}"
                    srcset="
                      {%- assign w_parts = feature_img_widths | split: ',' -%}
                      {%- for w in w_parts -%}
                        {{ img | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}
                      {%- endfor -%}
                    "
                    sizes="(min-width: 62em) min(45vw, 560px), (min-width: 48em) 80vw, 100vw"
                    width="{{ feature_img_width }}"
                    height="{{ img_h }}"
                    alt="{{ img_alt_e }}"
                    loading="{{ img_loading }}"
                    style="{{ media_style }}"
                  >
                {%- else -%}
                  <div class="routine-guide__feature-placeholder" aria-hidden="true">
                    {%- case ph_mod -%}
                      {%- when 0 -%}
                        {{ 'lifestyle-1' | placeholder_svg_tag: 'routine-guide__feature-placeholder-svg' }}
                      {%- when 1 -%}
                        {{ 'lifestyle-2' | placeholder_svg_tag: 'routine-guide__feature-placeholder-svg' }}
                      {%- else -%}
                        {{ 'lifestyle-3' | placeholder_svg_tag: 'routine-guide__feature-placeholder-svg' }}
                    {%- endcase -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}
