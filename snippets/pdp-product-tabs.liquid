{%- comment -%}
  PDP lower region: tabbed `tab_description` + `tab_rte` blocks with layout from section settings.
  — Top nav (default), left rail (desktop), or accordion (`details name=` exclusive group).
{%- endcomment -%}
{%- liquid
  assign pdp_tab_count = 0
  for block in section.blocks
    if block.type == 'tab_description' or block.type == 'tab_rte'
      assign pdp_tab_count = pdp_tab_count | plus: 1
    endif
  endfor

  assign pdp_app_block_count = 0
  for block in section.blocks
    if block.type == '@app'
      assign pdp_app_block_count = pdp_app_block_count | plus: 1
    endif
  endfor

  assign pdp_has_accordions = false
  for block in section.blocks
    if block.type == 'detail_accordion' and block.settings.heading != blank
      assign pdp_has_accordions = true
      break
    endif
  endfor

  assign pdp_has_spec = false
  for block in section.blocks
    if block.type == 'spec' and block.settings.label != blank and block.settings.value != blank
      assign pdp_has_spec = true
      break
    endif
  endfor

  assign tabs_layout = section.settings.tabs_layout | default: 'top'
  if tabs_layout == 'right'
    assign tabs_layout = 'left'
  endif
-%}

{%- if pdp_tab_count > 0 or pdp_app_block_count > 0 -%}
  {%- if pdp_tab_count > 0 -%}
    <div
      class="main-product__pdp-lower main-product__pdp-lower--tabbed"
      data-product-tabs
      data-tabs-layout="{{ tabs_layout }}"
    >
      <div class="main-product__pdp-bleed">
        <div class="main-product__pdp-lower__inner">
          {%- if tabs_layout == 'accordion' -%}
            <div class="main-product__tabs-accordion">
              {%- assign accordion_first = true -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'tab_description' or block.type == 'tab_rte' -%}
                  {%- assign tab_label = block.settings.heading | strip -%}
                  {%- if tab_label == blank -%}
                    {%- if block.type == 'tab_description' -%}
                      {%- assign tab_label = 'products.product.tab_label_by_block_type.tab_description' | t -%}
                    {%- else -%}
                      {%- assign tab_label = 'products.product.tab_label_by_block_type.tab_rte' | t -%}
                    {%- endif -%}
                  {%- endif -%}
                  <details
                    class="main-product__tab-accordion"
                    id="Details-{{ block.id }}"
                    name="pdp-tabs-{{ section.id }}"
                    {% if accordion_first %}
                      open
                    {% endif %}
                    {{ block.shopify_attributes }}
                  >
                    <summary class="main-product__tab-accordion-summary">
                      <span class="main-product__tab-accordion-label">{{ tab_label | escape }}</span>
                      <span class="main-product__tab-accordion-icon" aria-hidden="true">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                    </summary>
                    <div class="main-product__tab-accordion-viewport">
                      <div class="main-product__tab-accordion-body">
                        {%- render 'pdp-tab-panel-body',
                          block: block,
                          product: product,
                          section: section,
                          pdp_has_accordions: pdp_has_accordions,
                          pdp_has_spec: pdp_has_spec
                        -%}
                      </div>
                    </div>
                  </details>
                  {%- assign accordion_first = false -%}
                {%- endif -%}
              {%- endfor -%}
            </div>

          {%- else -%}
            <div class="main-product__tabs-shell main-product__tabs-shell--nav-{{ tabs_layout }}">
              <div
                class="main-product__tablist"
                role="tablist"
                aria-label="{{ 'products.product.tabs_aria' | t | escape }}"
              >
                {%- assign first_tab = true -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'tab_description' or block.type == 'tab_rte' -%}
                    {%- assign tab_key = 'tab-' | append: block.id -%}
                    {%- assign tab_label = block.settings.heading | strip -%}
                    {%- if tab_label == blank -%}
                      {%- if block.type == 'tab_description' -%}
                        {%- assign tab_label = 'products.product.tab_label_by_block_type.tab_description' | t -%}
                      {%- else -%}
                        {%- assign tab_label = 'products.product.tab_label_by_block_type.tab_rte' | t -%}
                      {%- endif -%}
                    {%- endif -%}
                    <button
                      type="button"
                      class="main-product__tab"
                      id="pdp-tab-{{ block.id }}"
                      role="tab"
                      aria-selected="{% if first_tab %}true{% else %}false{% endif %}"
                      aria-controls="pdp-panel-{{ block.id }}"
                      tabindex="{% if first_tab %}0{% else %}-1{% endif %}"
                      data-product-tab="{{ tab_key }}"
                    >
                      {{- tab_label | escape -}}
                    </button>
                    {%- assign first_tab = false -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <div class="main-product__tab-panels">
                {%- assign first_panel = true -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'tab_description' or block.type == 'tab_rte' -%}
                    {%- assign tab_key = 'tab-' | append: block.id -%}
                    <div
                      class="main-product__tab-panel"
                      id="pdp-panel-{{ block.id }}"
                      role="tabpanel"
                      aria-labelledby="pdp-tab-{{ block.id }}"
                      data-product-tab-panel="{{ tab_key }}"
                      {% unless first_panel %}hidden{% endunless %}
                      {{ block.shopify_attributes }}
                    >
                      {%- render 'pdp-tab-panel-body',
                        block: block,
                        product: product,
                        section: section,
                        pdp_has_accordions: pdp_has_accordions,
                        pdp_has_spec: pdp_has_spec
                      -%}
                    </div>
                    {%- assign first_panel = false -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- if pdp_app_block_count > 0 -%}
    <div class="main-product__pdp-lower main-product__pdp-lower--apps">
      <div class="main-product__pdp-bleed">
        <div class="main-product__pdp-lower__inner main-product__pdp-app-stack">
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              <div class="main-product__pdp-app-block" {{ block.shopify_attributes }}>
                {%- render block -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}
