<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {%- comment -%}
      Sole permitted call site for snippets/font-pairing-loader.liquid (must stay in <head>).
      Do not render snippets/font-pairing-link.liquid elsewhere — invalid HTML + FOUC.
    {%- endcomment -%}
    {% render 'font-pairing-loader' %}

    {% if settings.typography_mode == 'custom' %}
      {% unless settings.type_font_body.system? %}
        <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
        {{ settings.type_font_body | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
      {% endunless %}
    {% endif %}

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
  </body>
</html>
