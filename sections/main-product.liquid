{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign show_compare = false
  if current_variant.compare_at_price > current_variant.price
    assign show_compare = true
  endif
-%}

<div
  class="section-{{ section.id }} section-main-product"
  data-section-type="main-product"
  data-section-id="{{ section.id }}"
  data-main-product="{{ section.id }}"
  data-product-add-label="{{ 'products.product.add_to_cart' | t | escape }}"
  data-product-sold-label="{{ 'products.product.sold_out' | t | escape }}"
  {% render 'color-scheme-vars' %}
>
  <div class="main-product main-product--media-{{ section.settings.media_size | default: 'medium' }}">
    <div class="main-product__media" data-product-gallery>
      {%- for media in product.media -%}
        {%- assign loading = 'lazy' -%}
        {%- if forloop.first -%}
          {%- assign loading = 'eager' -%}
        {%- endif -%}
        <figure class="main-product__figure">
          {{
            media
            | image_url: width: 1600
            | image_tag:
              loading: loading,
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 900px) 50vw, 100vw',
              class: 'main-product__image'
          }}
        </figure>
      {%- else -%}
        <div class="main-product__media-placeholder" aria-hidden="true"></div>
      {%- endfor -%}
    </div>

    <div class="main-product__info">
      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <p class="main-product__vendor">{{- product.vendor | link_to_vendor -}}</p>
      {%- endif -%}

      <h1 class="main-product__title">{{- product.title | escape -}}</h1>

      <div class="main-product__price-row" data-product-price-row>
        {%- if show_compare -%}
          <s class="main-product__price main-product__price--compare" data-product-compare>
            {{- current_variant.compare_at_price | money -}}
          </s>
        {%- else -%}
          <s class="main-product__price main-product__price--compare is-visually-hidden" data-product-compare></s>
        {%- endif -%}
        <span class="main-product__price main-product__price--current" data-product-price>
          {{- current_variant.price | money -}}
        </span>
      </div>

      {%- assign product_form_id = 'product-form-' | append: section.id -%}
      <div class="main-product__buy-card">
        {%- form 'product',
          product,
          id: product_form_id,
          class: 'main-product__form',
          novalidate: 'novalidate',
          data-ajax-add-to-cart: ''
        -%}

          {%- unless product.has_only_default_variant -%}
            <div class="main-product__field">
              <label class="main-product__label" for="ProductSelect-{{ section.id }}">
                {{- 'products.product.variant' | t -}}
              </label>
              <select
                name="id"
                id="ProductSelect-{{ section.id }}"
                class="main-product__select"
                data-product-variant-select
              >
                {%- for variant in product.variants -%}
                  <option
                    value="{{ variant.id }}"
                    {% if variant == current_variant %}selected{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {{- variant.title | escape -}}
                    —
                    {{- variant.price | money -}}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {%- endunless -%}

          {%- if section.settings.show_quantity -%}
            <div class="main-product__field main-product__field--inline">
              <label class="main-product__label" for="Quantity-{{ section.id }}">
                {{- 'products.product.quantity' | t -}}
              </label>
              <input
                type="number"
                name="quantity"
                id="Quantity-{{ section.id }}"
                class="main-product__quantity"
                value="1"
                min="1"
              >
            </div>
          {%- endif -%}

          <button
            type="submit"
            class="main-product__submit"
            data-product-submit
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <span data-product-submit-label>
              {%- if current_variant.available -%}
                {{- 'products.product.add_to_cart' | t -}}
              {%- else -%}
                {{- 'products.product.sold_out' | t -}}
              {%- endif -%}
            </span>
          </button>
        {%- endform -%}
      </div>

      {%- if product.description != blank -%}
        <div class="main-product__details">
          <h2 class="main-product__details-heading">{{ 'products.product.details' | t }}</h2>
          <div class="main-product__description rte">
            {{- product.description -}}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  <script type="application/json" data-product-variant-json>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | money | json }},
          "compare_at_price": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>
</div>

<script>
  window.__productData = {{ product | json }};
</script>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_size",
      "label": "Media width (layout)",
      "options": [
        { "value": "small", "label": "Narrow column" },
        { "value": "medium", "label": "Balanced" },
        { "value": "large", "label": "Wide gallery" }
      ],
      "default": "medium"
    }
  ],
  "blocks": [],
  "presets": [{ "name": "Product" }]
}
{% endschema %}
