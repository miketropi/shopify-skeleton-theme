{%- comment -%}
  Product (PDP) — block-based layout: breadcrumbs, gallery, title/price, variant picker, buy buttons, meta, optional rich text & dividers, optional accordion blocks, app blocks.
  Product description / specs / tab accordions live in the separate **Product tabs** section.
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign show_compare = false
  if current_variant.compare_at_price > current_variant.price
    assign show_compare = true
  endif
  assign off_pct = 0
  if show_compare and current_variant.compare_at_price > 0
    assign off_cents = current_variant.compare_at_price | minus: current_variant.price
    assign off_pct = off_cents | times: 100 | divided_by: current_variant.compare_at_price
  endif
  assign product_form_id = 'product-form-' | append: section.id
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  if rating_count == blank
    assign rating_count = 0
  endif
  assign pdp_size_mf = product.metafields.custom.size_guide
  assign pdp_has_size_mf = false
  if pdp_size_mf != blank and pdp_size_mf.value != blank
    assign pdp_has_size_mf = true
  endif
  assign pdp_size_section_override = false
  if section.settings.size_guide_image != blank
    assign pdp_size_section_override = true
  endif
  assign show_size_guide_modal = false
  if settings.size_guide_enabled
    if pdp_has_size_mf or pdp_size_section_override or settings.size_guide_image != blank
      assign show_size_guide_modal = true
    endif
  endif

  assign pdp_has_any_sku = false
  for v in product.variants
    if v.sku != blank
      assign pdp_has_any_sku = true
      break
    endif
  endfor
  assign pdp_show_meta = false
  if section.settings.show_share
    assign pdp_show_meta = true
  endif
  if section.settings.show_tags and product.tags.size > 0
    assign pdp_show_meta = true
  endif
  if section.settings.show_sku and pdp_has_any_sku
    assign pdp_show_meta = true
  endif
-%}

<div
  class="section-{{ section.id }} section-main-product"
  data-section-type="main-product"
  data-section-id="{{ section.id }}"
  data-main-product="{{ section.id }}"
  role="region"
  aria-label="{{ 'products.product.region_aria' | t | escape }}"
  data-product-add-label="{{ 'products.product.add_to_cart' | t | escape }}"
  data-product-sold-label="{{ 'products.product.sold_out' | t | escape }}"
  data-sale-off-label="{{ 'products.product.sale_off' | t | escape }}"
  data-lightbox-close="{{ 'products.product.lightbox_close' | t | escape }}"
  data-lightbox-prev="{{ 'products.product.lightbox_prev' | t | escape }}"
  data-lightbox-next="{{ 'products.product.lightbox_next' | t | escape }}"
  data-lightbox-dialog="{{ 'products.product.lightbox_dialog' | t | escape }}"
  data-lightbox-counter="{{ 'products.product.lightbox_counter' | t | escape }}"
  data-product-media-order="{% for m in product.media %}{{ m.id }}{% unless forloop.last %},{% endunless %}{% endfor %}"
  data-pdp-size-metafield="{% if pdp_has_size_mf %}true{% else %}false{% endif %}"
  {% render 'color-scheme-vars' %}
>
  <div class="main-product">
    {%- for block in section.blocks -%}
      {%- if block.type == 'pdp_breadcrumbs' -%}
        <div class="main-product__breadcrumbs" {{ block.shopify_attributes }}>
          {%- render 'pdp-breadcrumbs', product: product, section: section -%}
        </div>
      {%- endif -%}
    {%- endfor -%}

    <div class="main-product__split">
      {%- for block in section.blocks -%}
        {%- if block.type == 'gallery' -%}
          <div class="main-product__block main-product__block--gallery" {{ block.shopify_attributes }}>
            {%- render 'pdp-gallery',
              product: product,
              section: section,
              block: block,
              show_compare: show_compare,
              off_pct: off_pct
            -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="main-product__info" data-product-info>
        {%- assign product_form_open = false -%}
        {%- for block in section.blocks -%}
          {%- unless block.type == 'pdp_breadcrumbs' or block.type == 'gallery' -%}
            {%- if block.type == '@app' -%}
              {%- if product_form_open -%}
                </form>
                {%- assign product_form_open = false -%}
              {%- endif -%}
              <div class="main-product__block main-product__block--app" {{ block.shopify_attributes }}>
                {%- render block -%}
              </div>
            {%- else -%}
              {%- if product_form_open == false -%}
                <form
                  method="post"
                  action="{{ routes.cart_add_url }}"
                  id="{{ product_form_id }}"
                  accept-charset="UTF-8"
                  class="main-product__form shopify-product-form"
                  enctype="multipart/form-data"
                  novalidate
                  data-ajax-add-to-cart=""
                >
                  <input type="hidden" name="form_type" value="product">
                  <input type="hidden" name="utf8" value="✓">
                  <input type="hidden" name="product-id" value="{{ product.id }}">
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-variant-id>
                {%- assign product_form_open = true -%}
              {%- endif -%}
              {%- case block.type -%}
                {%- when 'product_title' -%}
                  <div class="main-product__block main-product__block--product-title" {{ block.shopify_attributes }}>
                    {%- render 'pdp-info-head',
                      product: product,
                      section: section,
                      current_variant: current_variant,
                      show_compare: show_compare,
                      rating: rating,
                      rating_count: rating_count
                    -%}
                  </div>
                {%- when 'variant_picker' -%}
                  <div class="main-product__block main-product__block--variant-picker" {{ block.shopify_attributes }}>
                    {%- render 'pdp-variant-picker',
                      product: product,
                      section: section,
                      current_variant: current_variant,
                      show_size_guide_modal: show_size_guide_modal
                    -%}
                  </div>
                {%- when 'buy_buttons' -%}
                  <div class="main-product__block main-product__block--buy-buttons" {{ block.shopify_attributes }}>
                    {%- render 'pdp-buy-row',
                      product: product,
                      section: section,
                      current_variant: current_variant
                    -%}
                  </div>
                {%- when 'meta' -%}
                  {%- if pdp_show_meta -%}
                    {%- assign pdp_share_url = request.origin | append: product.url -%}
                    <div class="main-product__block main-product__block--meta" {{ block.shopify_attributes }}>
                      {%- render 'pdp-meta',
                        product: product,
                        section: section,
                        current_variant: current_variant,
                        pdp_share_url: pdp_share_url,
                        pdp_has_any_sku: pdp_has_any_sku
                      -%}
                    </div>
                  {%- endif -%}
                {%- when 'pdp_divider' -%}
                  <div
                    class="main-product__block main-product__block--divider main-product__block--divider-spacing-{{ block.settings.spacing }} main-product__block--divider-weight-{{ block.settings.line_weight }}"
                    {{ block.shopify_attributes }}
                  >
                    <hr class="main-product__divider-hr" aria-hidden="true">
                  </div>
                {%- when 'pdp_richtext' -%}
                  {%- if block.settings.text != blank -%}
                    <div class="main-product__block main-product__block--richtext rte" {{ block.shopify_attributes }}>
                      {{- block.settings.text -}}
                    </div>
                  {%- endif -%}
                {%- when 'pdp_accordion' -%}
                  {%- render 'pdp-product-accordion', block: block -%}
              {%- endcase -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
        {%- if product_form_open -%}
          </form>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- render 'pdp-json-data', product: product -%}
  {%- render 'pdp-size-guide-override',
    section: section,
    pdp_size_section_override: pdp_size_section_override,
    pdp_has_size_mf: pdp_has_size_mf
  -%}
</div>

<script>
  window.__productData = {{ product | json }};
</script>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main_product.layout_info_v2"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:sections.main_product.show_breadcrumbs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.main_product.show_vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "t:sections.main_product.show_quantity",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "t:sections.main_product.show_sale_badge",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_product.heading_product_meta"
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "t:sections.main_product.show_sku",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:sections.main_product.show_tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "t:sections.main_product.show_share",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_product.heading_size_guide"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main_product.size_guide_pdp_info"
    },
    {
      "type": "image_picker",
      "id": "size_guide_image",
      "label": "t:sections.main_product.size_guide_image",
      "info": "t:sections.main_product.size_guide_image_info"
    }
  ],
  "blocks": [
    {
      "type": "pdp_breadcrumbs",
      "name": "t:sections.main_product.block_breadcrumbs",
      "limit": 1,
      "settings": []
    },
    {
      "type": "gallery",
      "name": "t:sections.main_product.block_gallery",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "gallery_layout",
          "label": "t:sections.main_product.gallery_layout_label",
          "info": "t:sections.main_product.gallery_layout_info",
          "default": "carousel_thumbs_left",
          "options": [
            {
              "value": "carousel_thumbs_left",
              "label": "t:sections.main_product.gallery_layout_carousel_left"
            },
            {
              "value": "carousel_thumbs_bottom",
              "label": "t:sections.main_product.gallery_layout_carousel_bottom"
            },
            {
              "value": "carousel_no_thumbs",
              "label": "t:sections.main_product.gallery_layout_carousel_no_thumbs"
            },
            {
              "value": "stacked",
              "label": "t:sections.main_product.gallery_layout_stacked"
            }
          ]
        }
      ]
    },
    {
      "type": "product_title",
      "name": "t:sections.main_product.block_product_title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variant_picker",
      "name": "t:sections.main_product.block_variant_picker",
      "limit": 1,
      "settings": []
    },
    {
      "type": "buy_buttons",
      "name": "t:sections.main_product.block_buy_buttons",
      "limit": 1,
      "settings": []
    },
    {
      "type": "meta",
      "name": "t:sections.main_product.block_meta",
      "limit": 1,
      "settings": []
    },
    {
      "type": "pdp_divider",
      "name": "t:sections.main_product.block_pdp_divider",
      "settings": [
        {
          "type": "select",
          "id": "spacing",
          "label": "t:sections.main_product.pdp_divider_spacing",
          "info": "t:sections.main_product.pdp_divider_spacing_info",
          "default": "comfortable",
          "options": [
            { "value": "compact", "label": "t:sections.main_product.pdp_divider_spacing_compact" },
            { "value": "comfortable", "label": "t:sections.main_product.pdp_divider_spacing_comfortable" },
            { "value": "spacious", "label": "t:sections.main_product.pdp_divider_spacing_spacious" }
          ]
        },
        {
          "type": "select",
          "id": "line_weight",
          "label": "t:sections.main_product.pdp_divider_weight",
          "default": "hairline",
          "options": [
            { "value": "hairline", "label": "t:sections.main_product.pdp_divider_hairline" },
            { "value": "medium", "label": "t:sections.main_product.pdp_divider_medium" }
          ]
        }
      ]
    },
    {
      "type": "pdp_richtext",
      "name": "t:sections.main_product.block_pdp_richtext",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.main_product.pdp_richtext_label"
        }
      ]
    },
    {
      "type": "pdp_accordion",
      "name": "t:sections.main_product.block_pdp_accordion",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:sections.main_product.pdp_accordion_icon",
          "info": "t:sections.main_product.pdp_accordion_icon_info"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.main_product.pdp_accordion_label",
          "default": "Details"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "t:sections.main_product.pdp_accordion_content"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main_product.name",
      "blocks": {
        "pdp_breadcrumbs": { "type": "pdp_breadcrumbs", "settings": {} },
        "pdp_gallery": { "type": "gallery", "settings": {} },
        "pdp_title": { "type": "product_title", "settings": {} },
        "pdp_variant": { "type": "variant_picker", "settings": {} },
        "pdp_buy": { "type": "buy_buttons", "settings": {} },
        "pdp_meta": { "type": "meta", "settings": {} }
      },
      "block_order": [
        "pdp_breadcrumbs",
        "pdp_gallery",
        "pdp_title",
        "pdp_variant",
        "pdp_buy",
        "pdp_meta"
      ]
    }
  ]
}
{% endschema %}
