{%- comment -%}
  Product (PDP) — composes `pdp-*` snippets for gallery, buy box, tabs, and JSON.
  Blocks: spec rows, accordions (see `pdp-spec-blocks`, `pdp-accordion-blocks`).
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign show_compare = false
  if current_variant.compare_at_price > current_variant.price
    assign show_compare = true
  endif
  assign off_pct = 0
  if show_compare and current_variant.compare_at_price > 0
    assign off_cents = current_variant.compare_at_price | minus: current_variant.price
    assign off_pct = off_cents | times: 100 | divided_by: current_variant.compare_at_price
  endif
  assign product_form_id = 'product-form-' | append: section.id
  assign lede = product.metafields.custom.lede
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  if rating_count == blank
    assign rating_count = 0
  endif
  assign pdp_size_mf = product.metafields.custom.size_guide
  assign pdp_has_size_mf = false
  if pdp_size_mf != blank and pdp_size_mf.value != blank
    assign pdp_has_size_mf = true
  endif
  assign pdp_size_section_override = false
  if section.settings.size_guide_image != blank
    assign pdp_size_section_override = true
  endif
  assign show_size_guide_modal = false
  if settings.size_guide_enabled
    if pdp_has_size_mf or pdp_size_section_override or settings.size_guide_image != blank
      assign show_size_guide_modal = true
    endif
  endif
-%}

<div
  class="section-{{ section.id }} section-main-product"
  data-section-type="main-product"
  data-section-id="{{ section.id }}"
  data-main-product="{{ section.id }}"
  role="region"
  aria-label="{{ 'products.product.region_aria' | t | escape }}"
  data-product-add-label="{{ 'products.product.add_to_cart' | t | escape }}"
  data-product-sold-label="{{ 'products.product.sold_out' | t | escape }}"
  data-sale-off-label="{{ 'products.product.sale_off' | t | escape }}"
  data-product-media-order="{% for m in product.media %}{{ m.id }}{% unless forloop.last %},{% endunless %}{% endfor %}"
  data-pdp-size-metafield="{% if pdp_has_size_mf %}true{% else %}false{% endif %}"
  {% render 'color-scheme-vars' %}
>
  <div class="main-product">
    {%- render 'pdp-breadcrumbs', product: product, section: section -%}

    <div class="main-product__split">
      {%- render 'pdp-gallery',
        product: product,
        section: section,
        show_compare: show_compare,
        off_pct: off_pct
      -%}

      <div class="main-product__info" data-product-info>
        {%- render 'pdp-info-head',
          product: product,
          section: section,
          current_variant: current_variant,
          show_compare: show_compare,
          rating: rating,
          rating_count: rating_count
        -%}

        {%- form 'product',
          product,
          id: product_form_id,
          class: 'main-product__form',
          novalidate: 'novalidate',
          data-ajax-add-to-cart: ''
        -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-variant-id>
          {%- render 'pdp-variant-picker',
            product: product,
            section: section,
            current_variant: current_variant,
            show_size_guide_modal: show_size_guide_modal
          -%}
          {%- render 'pdp-buy-row',
            product: product,
            section: section,
            current_variant: current_variant
          -%}
        {%- endform -%}

        {%- liquid
          assign pdp_has_any_sku = false
          for v in product.variants
            if v.sku != blank
              assign pdp_has_any_sku = true
              break
            endif
          endfor
          assign pdp_show_meta = false
          if section.settings.show_share
            assign pdp_show_meta = true
          endif
          if section.settings.show_tags and product.tags.size > 0
            assign pdp_show_meta = true
          endif
          if section.settings.show_sku and pdp_has_any_sku
            assign pdp_show_meta = true
          endif
        -%}
        {%- if pdp_show_meta -%}
          {%- assign pdp_share_url = request.origin | append: product.url -%}
          {%- render 'pdp-meta',
            product: product,
            section: section,
            current_variant: current_variant,
            pdp_share_url: pdp_share_url,
            pdp_has_any_sku: pdp_has_any_sku
          -%}
        {%- endif -%}

        {%- if lede != blank -%}
          <p class="main-product__lede">{{ lede | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- liquid
      assign pdp_has_accordions = false
      for block in section.blocks
        if block.type == 'detail_accordion' and block.settings.heading != blank
          assign pdp_has_accordions = true
          break
        endif
      endfor

      assign pdp_has_spec = false
      for block in section.blocks
        if block.type == 'spec' and block.settings.label != blank and block.settings.value != blank
          assign pdp_has_spec = true
          break
        endif
      endfor

      assign pdp_rte_size = section.settings.tab_size_fit
      assign pdp_rte_care = section.settings.tab_care
      assign pdp_rte_ship = section.settings.tab_shipping

      assign pdp_desc_filled = false
      if product.description != blank or pdp_has_accordions
        assign pdp_desc_filled = true
      endif
      assign pdp_size_filled = false
      if pdp_rte_size != blank or pdp_has_spec
        assign pdp_size_filled = true
      endif
    -%}

    {%- render 'pdp-product-tabs',
      section: section,
      product: product,
      pdp_has_spec: pdp_has_spec,
      pdp_rte_size: pdp_rte_size,
      pdp_rte_care: pdp_rte_care,
      pdp_rte_ship: pdp_rte_ship,
      pdp_desc_filled: pdp_desc_filled,
      pdp_size_filled: pdp_size_filled
    -%}

  </div>

  {%- render 'pdp-json-data', product: product -%}
  {%- render 'pdp-size-guide-override',
    section: section,
    pdp_size_section_override: pdp_size_section_override,
    pdp_has_size_mf: pdp_has_size_mf
  -%}
</div>

<script>
  window.__productData = {{ product | json }};
</script>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:sections.main_product.show_breadcrumbs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.main_product.show_vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "t:sections.main_product.show_quantity",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "t:sections.main_product.show_sale_badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_review_summary",
      "label": "t:sections.main_product.show_review_summary",
      "default": true,
      "info": "t:sections.main_product.review_info"
    },
    {
      "type": "header",
      "content": "t:sections.main_product.heading_product_meta"
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "t:sections.main_product.show_sku",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:sections.main_product.show_tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "t:sections.main_product.show_share",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_product.heading_size_guide"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main_product.size_guide_pdp_info"
    },
    {
      "type": "image_picker",
      "id": "size_guide_image",
      "label": "t:sections.main_product.size_guide_image",
      "info": "t:sections.main_product.size_guide_image_info"
    },
    {
      "type": "header",
      "content": "t:sections.main_product.heading_product_tabs"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main_product.product_tabs_info"
    },
    {
      "type": "richtext",
      "id": "tab_size_fit",
      "label": "t:sections.main_product.tab_size_fit"
    },
    {
      "type": "richtext",
      "id": "tab_care",
      "label": "t:sections.main_product.tab_care"
    },
    {
      "type": "richtext",
      "id": "tab_shipping",
      "label": "t:sections.main_product.tab_shipping"
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "t:sections.main_product.block_spec",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.main_product.spec_label"
        },
        {
          "type": "text",
          "id": "value",
          "label": "t:sections.main_product.spec_value"
        }
      ]
    },
    {
      "type": "detail_accordion",
      "name": "t:sections.main_product.block_accordion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.main_product.accordion_heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "t:sections.main_product.accordion_body"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.main_product.name"
    }
  ]
}
{% endschema %}
