{%- liquid
  assign slide_count = 0
  for block in section.blocks
    if block.type == 'slide'
      assign slide_count = slide_count | plus: 1
    endif
  endfor

  assign hero_scheme = settings.global_color_scheme
  if hero_scheme == blank or hero_scheme.settings == blank
    assign hero_scheme = settings.color_schemes['scheme-6']
  endif

  assign overlay_alpha = section.settings.overlay_softness | divided_by: 100.0
-%}
{%- capture scheme_vars -%}
  {%- render 'color-scheme-vars', scheme: hero_scheme, inline_only: true -%}
{%- endcapture -%}

<div
  class="section-{{ section.id }} section-hero-slider full-width{% if slide_count < 2 %} section-hero-slider--single{% endif %}"
  data-section-type="section-hero-slider"
  data-section-id="{{ section.id }}"
  data-hero-autoplay="{% if section.settings.autoplay %}true{% else %}false{% endif %}"
  data-hero-autoplay-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
  data-hero-parallax="{% if section.settings.parallax_scroll %}true{% else %}false{% endif %}"
  data-hero-parallax-intensity="{{ section.settings.parallax_amount }}"
  style="
    {{ scheme_vars }}
    --hero-min-height: {{ section.settings.min_height }}px;
    --hero-overlay-soft: {{ overlay_alpha }};
  "
  {{ section.shopify_attributes }}
>
  <div
    class="section-hero-slider__viewport"
    role="region"
    aria-roledescription="{{ 'hero_slider.carousel' | t }}"
    aria-label="{{ 'hero_slider.region_label' | t }}"
    {% if slide_count > 0 %}
      tabindex="-1"
    {% endif %}
  >
    <div
      class="hero-swiper swiper"
      data-hero-swiper
      {% if slide_count > 1 %}
        tabindex="0"
      {% endif %}
      {% if slide_count > 0 %}
        aria-live="polite"
      {% endif %}
    >
      <div class="swiper-wrapper">
        {%- if slide_count == 0 -%}
          <div
            class="swiper-slide hero-slide"
            data-hero-slide
            role="group"
            aria-roledescription="{{ 'hero_slider.slide' | t }}"
            aria-label="{{ 'hero_slider.slide_n_of_m' | t: n: 1, m: 1 }}"
          >
            <div class="hero-slide__media">
              <div class="hero-slide__media-inner" data-hero-media-inner>
                <div class="hero-slide__parallax" data-hero-parallax>
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'hero-slide__placeholder-svg' }}
                </div>
              </div>
            </div>
            <div class="hero-slide__copy" data-hero-copy>
              <div class="hero-slide__copy-inner">
                <p class="hero-slide__kicker">{{ 'hero_slider.add_slides' | t }}</p>
                <div class="hero-slide__heading hero-slide__heading--h1">
                  <p>{{ 'hero_slider.placeholder_heading' | t }}</p>
                </div>
              </div>
            </div>
          </div>
        {%- else -%}
          {%- assign i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'slide' -%}
              {%- liquid
                assign slide_scheme = hero_scheme
                assign scm = block.settings.slide_color_scheme_mode
                if scm == 'custom'
                  assign picked_scheme = block.settings.color_scheme
                  if picked_scheme != blank and picked_scheme.settings != blank
                    assign slide_scheme = picked_scheme
                  endif
                elsif scm == 'default'
                  assign slide_scheme = hero_scheme
                else
                  assign picked_scheme = block.settings.color_scheme
                  if picked_scheme != blank and picked_scheme.settings != blank
                    assign slide_scheme = picked_scheme
                  endif
                endif
              -%}
              {%- capture slide_scheme_css -%}
                {%- render 'color-scheme-vars', scheme: slide_scheme, inline_only: true -%}
              {%- endcapture -%}
              {%- assign slide_hero_ov = '' -%}
              {%- if block.settings.content_color_override -%}
                {%- liquid
                  assign kc = block.settings.content_color_kicker
                  assign hc = block.settings.content_color_heading
                  assign bc = block.settings.content_color_body
                  assign lc = block.settings.content_color_link
                  assign pt = block.settings.content_color_btn_text
                  assign pb = block.settings.content_color_btn_border
                  assign pbg = block.settings.content_color_btn_bg
                -%}
                {%- if kc != blank -%}
                  {%- assign slide_hero_ov = slide_hero_ov | append: ' --hero-ov-kicker: ' | append: kc | append: ';' -%}
                {%- endif -%}
                {%- if hc != blank -%}
                  {%- assign slide_hero_ov = slide_hero_ov | append: ' --hero-ov-heading: ' | append: hc | append: ';' -%}
                {%- endif -%}
                {%- if bc != blank -%}
                  {%- assign slide_hero_ov = slide_hero_ov | append: ' --hero-ov-body: ' | append: bc | append: ';' -%}
                {%- endif -%}
                {%- if lc != blank -%}
                  {%- assign slide_hero_ov = slide_hero_ov | append: ' --hero-ov-link: ' | append: lc | append: ';' -%}
                {%- endif -%}
                {%- if pt != blank -%}
                  {%- assign slide_hero_ov = slide_hero_ov | append: ' --hero-ov-btn-text: ' | append: pt | append: ';' -%}
                {%- endif -%}
                {%- if pb != blank -%}
                  {%- assign slide_hero_ov = slide_hero_ov | append: ' --hero-ov-btn-border: ' | append: pb | append: ';' -%}
                {%- endif -%}
                {%- if pbg != blank -%}
                  {%- assign slide_hero_ov = slide_hero_ov | append: ' --hero-ov-btn-bg: ' | append: pbg | append: ';' -%}
                {%- endif -%}
              {%- endif -%}
              {%- assign i_display = i | plus: 1 -%}
              {%- liquid
                assign img_loading = 'lazy'
                if i == 0
                  assign img_loading = 'eager'
                endif
                assign img_alt = block.settings.image.alt | default: block.settings.heading | strip_html | escape
                assign img_style = 'object-position: ' | append: block.settings.image_position | append: ';'
                assign bg_media = block.settings.background_media | default: 'image'
                assign use_video = false
                if bg_media == 'video' and block.settings.video != blank
                  assign use_video = true
                endif
                assign video_poster_url = ''
                if use_video and block.settings.image != blank
                  assign video_poster_url = block.settings.image | image_url: width: 1920
                endif
              -%}
              <div
                class="swiper-slide hero-slide"
                data-hero-slide
                role="group"
                aria-roledescription="{{ 'hero_slider.slide' | t }}"
                aria-label="{{ 'hero_slider.slide_n_of_m' | t: n: i_display, m: slide_count }}"
                style="{{ slide_scheme_css }}{{ slide_hero_ov }}"
                {{ block.shopify_attributes }}
              >
                <div class="hero-slide__media">
                  <div class="hero-slide__media-inner" data-hero-media-inner>
                    <div class="hero-slide__parallax" data-hero-parallax>
                      {%- if use_video -%}
                        {%- if block.settings.image != blank -%}
                          {{
                            block.settings.video
                            | video_tag:
                              autoplay: false,
                              loop: true,
                              muted: true,
                              controls: false,
                              playsinline: true,
                              class: 'hero-slide__video',
                              style: img_style,
                              poster: video_poster_url
                          }}
                        {%- else -%}
                          {{
                            block.settings.video
                            | video_tag:
                              autoplay: false,
                              loop: true,
                              muted: true,
                              controls: false,
                              playsinline: true,
                              class: 'hero-slide__video',
                              style: img_style
                          }}
                        {%- endif -%}
                      {%- elsif block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: width: 2400
                          | image_tag:
                            loading: img_loading,
                            widths: '400, 600, 800, 1200, 1600, 2000, 2400',
                            sizes: '(min-width: 1024px) 55vw, (min-width: 768px) 100vw, 100vw',
                            class: 'hero-slide__img',
                            style: img_style,
                            alt: img_alt
                        }}
                      {%- else -%}
                        {{ 'product-apparel-1' | placeholder_svg_tag: 'hero-slide__placeholder-svg' }}
                      {%- endif -%}
                    </div>
                  </div>
                </div>
                {%- if block.settings.content_overlay_enable -%}
                  {%- liquid
                    assign ol_color = block.settings.content_overlay_color | default: '#000000'
                    assign ol_alpha = block.settings.content_overlay_opacity | divided_by: 100.0
                    assign ol_bg = ol_color | color_modify: 'alpha', ol_alpha
                    assign ol_cov = block.settings.content_overlay_coverage | default: 'copy'
                    if ol_cov == 'bottom'
                      assign ol_cov = 'copy'
                    endif
                  -%}
                  <div
                    class="hero-slide__content-overlay{% if ol_cov == 'full' %} hero-slide__content-overlay--full{% else %} hero-slide__content-overlay--copy{% endif %}"
                    style="background-color: {{ ol_bg }};"
                    aria-hidden="true"
                  ></div>
                {%- endif -%}
                <div class="hero-slide__copy" data-hero-copy>
                  <div class="hero-slide__copy-inner">
                    {%- if block.settings.kicker != blank -%}
                      <p class="hero-slide__kicker">{{ block.settings.kicker | escape }}</p>
                    {%- endif -%}
                    {%- if block.settings.heading != blank -%}
                      <div class="hero-slide__heading hero-slide__heading--{{ block.settings.heading_size }}">
                        {{ block.settings.heading }}
                      </div>
                    {%- endif -%}
                    {%- if block.settings.body != blank -%}
                      <div class="hero-slide__body rte">{{ block.settings.body }}</div>
                    {%- endif -%}
                    {%- if block.settings.cta_primary_label != blank or block.settings.cta_secondary_label != blank -%}
                      <div class="hero-slide__actions">
                        {%- if block.settings.cta_primary_label != blank -%}
                          <a
                            class="hero-slider__btn hero-slider__btn--primary"
                            href="{{ block.settings.cta_primary_link | default: '#' }}"
                          >
                            {{ block.settings.cta_primary_label | escape }}
                          </a>
                        {%- endif -%}
                        {%- if block.settings.cta_secondary_label != blank -%}
                          <a
                            class="hero-slider__link"
                            href="{{ block.settings.cta_secondary_link | default: '#' }}"
                          >
                            {{ block.settings.cta_secondary_label | escape }}
                          </a>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
              {%- assign i = i | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if slide_count > 1 -%}
        <div class="hero-slider__chrome" data-hero-chrome>
          <div class="hero-slider__chrome-gradient" aria-hidden="true"></div>
          <button
            type="button"
            class="swiper-button-prev hero-slider__nav-btn hero-slider__nav-btn--side hero-slider__nav-btn--prev"
            data-hero-prev
            aria-label="{{ 'hero_slider.prev' | t }}"
          >
            <span class="hero-slider__nav-label-text">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left-icon lucide-chevron-left"><path d="m15 18-6-6 6-6"/></svg>
            </span>
          </button>
          <div class="hero-slider__chrome-mid" data-hero-chrome-mid>
            <div
              class="hero-slider__fraction"
              data-hero-fraction
              aria-live="polite"
              aria-atomic="true"
            >
              <span class="hero-slider__fraction-current" data-hero-current>01</span>
              <span class="hero-slider__fraction-sep" aria-hidden="true">/</span>
              <span class="hero-slider__fraction-total" data-hero-total>
                {%- if slide_count < 10 -%}0{%- endif -%}{{ slide_count }}
              </span>
            </div>
            <div class="swiper-pagination hero-slider__pagination" data-hero-pagination></div>
          </div>
          <button
            type="button"
            class="swiper-button-next hero-slider__nav-btn hero-slider__nav-btn--side hero-slider__nav-btn--next"
            data-hero-next
            aria-label="{{ 'hero_slider.next' | t }}"
          >
            <span class="hero-slider__nav-label-text">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right-icon lucide-chevron-right"><path d="m9 18 6-6-6-6"/></svg>
            </span>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.hero_slider.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "min_height",
      "label": "t:sections.hero_slider.labels.min_height",
      "min": 420,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "overlay_softness",
      "label": "t:sections.hero_slider.labels.overlay_softness",
      "info": "t:sections.hero_slider.info.overlay_softness",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "parallax_scroll",
      "label": "t:sections.hero_slider.labels.parallax_scroll",
      "info": "t:sections.hero_slider.info.parallax_scroll",
      "default": true
    },
    {
      "type": "range",
      "id": "parallax_amount",
      "label": "t:sections.hero_slider.labels.parallax_amount",
      "min": 6,
      "max": 22,
      "step": 1,
      "unit": "%",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.hero_slider.labels.autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "t:sections.hero_slider.labels.autoplay_delay",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.hero_slider.blocks.slide.name",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "slide_color_scheme_mode",
          "label": "t:sections.hero_slider.blocks.slide.slide_color_scheme_mode",
          "options": [
            { "value": "default", "label": "t:sections.hero_slider.blocks.slide.slide_color_scheme_mode_default" },
            { "value": "custom", "label": "t:sections.hero_slider.blocks.slide.slide_color_scheme_mode_custom" }
          ],
          "default": "default"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.hero_slider.blocks.slide.color_scheme",
          "info": "t:sections.hero_slider.blocks.slide.color_scheme_info",
          "default": "scheme-6",
          "visible_if": "{{ block.settings.slide_color_scheme_mode == 'custom' }}"
        },
        {
          "type": "select",
          "id": "background_media",
          "label": "t:sections.hero_slider.blocks.slide.background_media",
          "info": "t:sections.hero_slider.blocks.slide.background_media_info",
          "options": [
            { "value": "image", "label": "t:sections.hero_slider.options.background_media.image" },
            { "value": "video", "label": "t:sections.hero_slider.options.background_media.video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.hero_slider.blocks.slide.image",
          "info": "t:sections.hero_slider.blocks.slide.image_info"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.hero_slider.blocks.slide.video",
          "info": "t:sections.hero_slider.blocks.slide.video_info"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "t:sections.hero_slider.blocks.slide.image_position",
          "options": [
            { "value": "center", "label": "t:sections.hero_slider.options.image_position.center" },
            { "value": "top", "label": "t:sections.hero_slider.options.image_position.top" },
            { "value": "bottom", "label": "t:sections.hero_slider.options.image_position.bottom" },
            { "value": "left", "label": "t:sections.hero_slider.options.image_position.left" },
            { "value": "right", "label": "t:sections.hero_slider.options.image_position.right" }
          ],
          "default": "center"
        },
        {
          "type": "checkbox",
          "id": "content_overlay_enable",
          "label": "t:sections.hero_slider.blocks.slide.content_overlay_enable",
          "info": "t:sections.hero_slider.blocks.slide.content_overlay_enable_info",
          "default": false
        },
        {
          "type": "color",
          "id": "content_overlay_color",
          "label": "t:sections.hero_slider.blocks.slide.content_overlay_color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "content_overlay_opacity",
          "label": "t:sections.hero_slider.blocks.slide.content_overlay_opacity",
          "min": 5,
          "max": 90,
          "step": 5,
          "unit": "%",
          "default": 35
        },
        {
          "type": "select",
          "id": "content_overlay_coverage",
          "label": "t:sections.hero_slider.blocks.slide.content_overlay_coverage",
          "info": "t:sections.hero_slider.blocks.slide.content_overlay_coverage_info",
          "options": [
            { "value": "copy", "label": "t:sections.hero_slider.options.content_overlay_coverage.copy" },
            { "value": "full", "label": "t:sections.hero_slider.options.content_overlay_coverage.full" }
          ],
          "default": "copy"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "t:sections.hero_slider.blocks.slide.kicker"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:sections.hero_slider.blocks.slide.heading",
          "default": "Hero headline"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "t:sections.hero_slider.blocks.slide.heading_size",
          "options": [
            { "value": "display", "label": "t:sections.hero_slider.options.heading_size.display" },
            { "value": "h1", "label": "t:sections.hero_slider.options.heading_size.h1" },
            { "value": "h2", "label": "t:sections.hero_slider.options.heading_size.h2" }
          ],
          "default": "display"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "t:sections.hero_slider.blocks.slide.body"
        },
        {
          "type": "text",
          "id": "cta_primary_label",
          "label": "t:sections.hero_slider.blocks.slide.cta_primary_label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "cta_primary_link",
          "label": "t:sections.hero_slider.blocks.slide.cta_primary_link"
        },
        {
          "type": "text",
          "id": "cta_secondary_label",
          "label": "t:sections.hero_slider.blocks.slide.cta_secondary_label"
        },
        {
          "type": "url",
          "id": "cta_secondary_link",
          "label": "t:sections.hero_slider.blocks.slide.cta_secondary_link"
        },
        {
          "type": "header",
          "content": "t:sections.hero_slider.blocks.slide.heading_content_colors"
        },
        {
          "type": "checkbox",
          "id": "content_color_override",
          "label": "t:sections.hero_slider.blocks.slide.content_color_override",
          "info": "t:sections.hero_slider.blocks.slide.content_color_override_info",
          "default": false
        },
        {
          "type": "color",
          "id": "content_color_kicker",
          "label": "t:sections.hero_slider.blocks.slide.content_color_kicker",
          "default": "#e7e5e4",
          "visible_if": "{{ block.settings.content_color_override }}"
        },
        {
          "type": "color",
          "id": "content_color_heading",
          "label": "t:sections.hero_slider.blocks.slide.content_color_heading",
          "default": "#fafaf9",
          "visible_if": "{{ block.settings.content_color_override }}"
        },
        {
          "type": "color",
          "id": "content_color_body",
          "label": "t:sections.hero_slider.blocks.slide.content_color_body",
          "default": "#d6d3d1",
          "visible_if": "{{ block.settings.content_color_override }}"
        },
        {
          "type": "color",
          "id": "content_color_link",
          "label": "t:sections.hero_slider.blocks.slide.content_color_link",
          "default": "#fafaf9",
          "visible_if": "{{ block.settings.content_color_override }}"
        },
        {
          "type": "color",
          "id": "content_color_btn_text",
          "label": "t:sections.hero_slider.blocks.slide.content_color_btn_text",
          "default": "#fafaf9",
          "visible_if": "{{ block.settings.content_color_override }}"
        },
        {
          "type": "color",
          "id": "content_color_btn_border",
          "label": "t:sections.hero_slider.blocks.slide.content_color_btn_border",
          "default": "#fafaf9",
          "visible_if": "{{ block.settings.content_color_override }}"
        },
        {
          "type": "color",
          "id": "content_color_btn_bg",
          "label": "t:sections.hero_slider.blocks.slide.content_color_btn_bg",
          "info": "t:sections.hero_slider.blocks.slide.content_color_btn_bg_info",
          "default": "rgba(0,0,0,0)",
          "visible_if": "{{ block.settings.content_color_override }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero_slider.name",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "kicker": "Winter offers",
            "heading": "Best beauty items",
            "heading_size": "display",
            "body": "<p>Curated picks for everyday glow — limited time only.</p>",
            "cta_primary_label": "Shop collection",
            "cta_primary_link": "shopify://collections/all",
            "cta_secondary_label": "Learn more",
            "cta_secondary_link": "shopify://pages/about"
          }
        },
        {
          "type": "slide",
          "settings": {
            "kicker": "New in",
            "heading": "Fresh arrivals",
            "heading_size": "h1",
            "body": "<p>Restocks and new styles each week.</p>",
            "cta_primary_label": "Browse",
            "cta_primary_link": "shopify://collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
