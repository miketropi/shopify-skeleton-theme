{%- liquid
  assign ps_scheme = settings.global_color_scheme
  if ps_scheme == blank or ps_scheme.settings == blank
    assign ps_scheme = settings.color_schemes['scheme-6']
  endif

  assign pssm = section.settings.section_color_scheme_mode
  if pssm == 'custom'
    assign picked_ps = section.settings.color_scheme
    if picked_ps != blank and picked_ps.settings != blank
      assign ps_scheme = picked_ps
    endif
  elsif pssm == 'default'
  else
    assign picked_ps = section.settings.color_scheme
    if picked_ps != blank and picked_ps.settings != blank
      assign ps_scheme = picked_ps
    endif
  endif

  assign product_block_count = 0
  for block in section.blocks
    if block.type == 'product'
      assign product_block_count = product_block_count | plus: 1
    endif
  endfor

  assign gap_px = 24
  case section.settings.gap
    when 'small'
      assign gap_px = 16
    when 'large'
      assign gap_px = 32
  endcase

  assign per_row = section.settings.products_per_row | default: '4'

  assign nav_position = section.settings.navigation_position | default: 'sides'
  assign show_carousel_nav = false
  if section.settings.enable_carousel and section.settings.show_navigation_arrows and product_block_count > 1
    assign show_carousel_nav = true
  endif
  assign nav_in_heading = false
  if show_carousel_nav and nav_position == 'heading'
    assign nav_in_heading = true
  endif
  assign has_intro_text = false
  if section.settings.eyebrow_text != blank or section.settings.heading != blank
    assign has_intro_text = true
  endif
  assign show_intro_row = false
  if has_intro_text or nav_in_heading
    assign show_intro_row = true
  endif
-%}
{%- capture ps_scheme_vars -%}
  {%- render 'color-scheme-vars', scheme: ps_scheme, inline_only: true -%}
{%- endcapture -%}

{%- render 'section-styles', section: section -%}

<div
  class="section-{{ section.id }} product-slider shopify-section-wrapper product-slider--nav-{{ nav_position }}{% if section.settings.enable_carousel %} product-slider--carousel{% else %} product-slider--grid{% endif %} product-slider--heading-{{ section.settings.heading_size }}{% if section.settings.full_width %} full-width product-slider--full-width{% endif %}"
  data-section-type="section-product-slider"
  data-section-id="{{ section.id }}"
  data-product-slider-carousel="{% if section.settings.enable_carousel %}true{% else %}false{% endif %}"
  data-product-slider-nav-heading="{% if nav_in_heading %}true{% else %}false{% endif %}"
  data-products-per-row="{{ per_row | escape }}"
  data-product-slider-gap="{{ gap_px }}"
  data-product-slider-show-arrows="{% if section.settings.show_navigation_arrows %}true{% else %}false{% endif %}"
  style="{{ ps_scheme_vars }} --ps-gap: {{ gap_px }}px;"
  {{ section.shopify_attributes }}
>
  <div class="product-slider__inner{% if section.settings.full_width %} section-content-width{% endif %}">
  {%- if show_intro_row -%}
    <div class="product-slider__intro{% if nav_in_heading %} product-slider__intro--with-heading-nav{% endif %}{% if section.settings.heading_alignment == 'center' %} product-slider__intro--center{% endif %}">
      <div class="product-slider__intro-row{% if has_intro_text == false %} product-slider__intro-row--nav-only{% endif %}">
        <div class="product-slider__intro-copy">
          {%- if section.settings.eyebrow_text != blank -%}
            <p class="product-slider__eyebrow">{{ section.settings.eyebrow_text | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="product-slider__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>
        {%- if nav_in_heading -%}
          <div class="product-slider__intro-nav">
            <button
              type="button"
              class="swiper-button-prev product-slider__nav-btn product-slider__nav-btn--prev product-slider__nav-btn--heading"
              data-product-slider-prev
              aria-label="{{ 'product_slider.prev' | t }}"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button
              type="button"
              class="swiper-button-next product-slider__nav-btn product-slider__nav-btn--next product-slider__nav-btn--heading"
              data-product-slider-next
              aria-label="{{ 'product_slider.next' | t }}"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if product_block_count > 0 -%}
    {%- if section.settings.enable_carousel -%}
      <div
        class="product-slider__viewport"
        role="region"
        aria-roledescription="{{ 'product_slider.carousel' | t }}"
        aria-label="{{ 'product_slider.region_label' | t }}"
        tabindex="-1"
      >
        <div
          class="product-slider__swiper swiper"
          data-product-slider-swiper
          tabindex="0"
          aria-live="polite"
        >
          <ul class="swiper-wrapper product-slider__track" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'product' and block.settings.product != blank -%}
                <li
                  class="swiper-slide product-slider__slide"
                  {{ block.shopify_attributes }}
                >
                  {%- render 'tcard-product',
                    product: block.settings.product,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_quick_add: section.settings.show_quick_add
                  -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>

          {%- if show_carousel_nav and nav_in_heading == false -%}
            <button
              type="button"
              class="swiper-button-prev product-slider__nav-btn product-slider__nav-btn--prev product-slider__nav-btn--sides"
              data-product-slider-prev
              aria-label="{{ 'product_slider.prev' | t }}"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button
              type="button"
              class="swiper-button-next product-slider__nav-btn product-slider__nav-btn--next product-slider__nav-btn--sides"
              data-product-slider-next
              aria-label="{{ 'product_slider.next' | t }}"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          {%- endif -%}
        </div>
      </div>
    {%- else -%}
      <ul
        class="product-slider__grid product-slider__grid--per-row-{{ per_row }}"
        style="--ps-gap: {{ gap_px }}px;"
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- if block.type == 'product' and block.settings.product != blank -%}
            <li
              class="product-slider__grid-item"
              {{ block.shopify_attributes }}
            >
              {%- render 'tcard-product',
                product: block.settings.product,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor,
                show_quick_add: section.settings.show_quick_add
              -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  {%- else -%}
    <div class="product-slider__empty">
      <p class="product-slider__empty-text">{{ 'product_slider.empty' | t }}</p>
    </div>
  {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.product_slider.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.product_slider.headers.content"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "t:sections.product_slider.labels.eyebrow_text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product_slider.labels.heading",
      "default": "Featured products"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.product_slider.labels.heading_size",
      "options": [
        { "value": "small", "label": "t:sections.product_slider.options.heading_size.small" },
        { "value": "medium", "label": "t:sections.product_slider.options.heading_size.medium" },
        { "value": "large", "label": "t:sections.product_slider.options.heading_size.large" },
        { "value": "xlarge", "label": "t:sections.product_slider.options.heading_size.xlarge" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.product_slider.labels.heading_alignment",
      "options": [
        { "value": "left", "label": "t:sections.product_slider.options.heading_align.left" },
        { "value": "center", "label": "t:sections.product_slider.options.heading_align.center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:sections.product_slider.headers.cards"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "t:sections.product_slider.labels.show_secondary_image",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.product_slider.labels.show_vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:sections.product_slider.labels.show_quick_add",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.product_slider.headers.carousel"
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "t:sections.product_slider.labels.enable_carousel",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_navigation_arrows",
      "label": "t:sections.product_slider.labels.show_navigation_arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "navigation_position",
      "label": "t:sections.product_slider.labels.navigation_position",
      "options": [
        { "value": "sides", "label": "t:sections.product_slider.options.navigation_position.sides" },
        { "value": "heading", "label": "t:sections.product_slider.options.navigation_position.heading" }
      ],
      "default": "sides",
      "visible_if": "{{ section.settings.enable_carousel == true and section.settings.show_navigation_arrows == true }}"
    },
    {
      "type": "select",
      "id": "products_per_row",
      "label": "t:sections.product_slider.labels.products_per_row",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "t:sections.product_slider.labels.gap",
      "options": [
        { "value": "small", "label": "t:sections.product_slider.options.gap.small" },
        { "value": "medium", "label": "t:sections.product_slider.options.gap.medium" },
        { "value": "large", "label": "t:sections.product_slider.options.gap.large" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "t:sections.product_slider.headers.colour"
    },
    {
      "type": "select",
      "id": "section_color_scheme_mode",
      "label": "t:sections.product_slider.section_color_scheme_mode",
      "options": [
        { "value": "default", "label": "t:sections.product_slider.section_color_scheme_mode_default" },
        { "value": "custom", "label": "t:sections.product_slider.section_color_scheme_mode_custom" }
      ],
      "default": "default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.product_slider.color_scheme",
      "info": "t:sections.product_slider.color_scheme_info",
      "default": "scheme-6",
      "visible_if": "{{ section.settings.section_color_scheme_mode == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:sections.product_slider.headers.layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.product_slider.labels.full_width",
      "info": "t:sections.product_slider.labels.full_width_info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.product_slider.headers.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.product_slider.labels.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.product_slider.labels.padding_right",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.product_slider.labels.padding_bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.product_slider.labels.padding_left",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.product_slider.headers.margin"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.product_slider.labels.margin_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.product_slider.labels.margin_bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.product_slider.headers.background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.product_slider.labels.background_color",
      "default": "rgba(0,0,0,0)",
      "info": "t:sections.product_slider.labels.background_color_info"
    },
    {
      "type": "header",
      "content": "t:sections.product_slider.headers.border"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "t:sections.product_slider.labels.border_width",
      "default": 0
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:sections.product_slider.labels.border_style",
      "options": [
        { "value": "none", "label": "t:sections.product_slider.options.border_style.none" },
        { "value": "solid", "label": "t:sections.product_slider.options.border_style.solid" },
        { "value": "dashed", "label": "t:sections.product_slider.options.border_style.dashed" },
        { "value": "dotted", "label": "t:sections.product_slider.options.border_style.dotted" }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:sections.product_slider.labels.border_color",
      "default": "rgba(0,0,0,0)",
      "info": "t:sections.product_slider.labels.border_color_info"
    },
    {
      "type": "header",
      "content": "t:sections.product_slider.headers.radius"
    },
    {
      "type": "range",
      "id": "border_radius_top_left",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "t:sections.product_slider.labels.radius_tl",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius_top_right",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "t:sections.product_slider.labels.radius_tr",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius_bottom_right",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "t:sections.product_slider.labels.radius_br",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius_bottom_left",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "t:sections.product_slider.labels.radius_bl",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:sections.product_slider.blocks.product.name",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.product_slider.blocks.product.settings.product"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "t:sections.product_slider.presets.name",
      "settings": {
        "padding_top": 40,
        "padding_right": 0,
        "padding_bottom": 40,
        "padding_left": 0,
        "margin_top": 0,
        "margin_bottom": 0,
        "background_color": "rgba(0,0,0,0)",
        "border_width": 0,
        "border_style": "solid",
        "border_radius_top_left": 0,
        "border_radius_top_right": 0,
        "border_radius_bottom_right": 0,
        "border_radius_bottom_left": 0,
        "border_color": "rgba(0,0,0,0)",
        "heading": "Featured products",
        "heading_size": "large",
        "heading_alignment": "left",
        "enable_carousel": true,
        "show_navigation_arrows": true,
        "navigation_position": "sides",
        "products_per_row": "4",
        "gap": "medium",
        "section_color_scheme_mode": "default",
        "full_width": false,
        "show_secondary_image": false,
        "show_vendor": false,
        "show_quick_add": false
      }
    }
  ]
}
{% endschema %}
