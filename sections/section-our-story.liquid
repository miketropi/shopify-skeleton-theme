          "type": "text",
          "id": "heading",
          "label": "t:sections.our_story.blocks.story_card.labels.heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:sections.our_story.blocks.story_card.labels.description"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "t:sections.our_story.blocks.story_card.labels.text_alignment",
          "default": "center",
          "options": [
            { "value": "left", "label": "t:sections.our_story.options.text_align.left" },
            { "value": "center", "label": "t:sections.our_story.options.text_align.center" },
            { "value": "right", "label": "t:sections.our_story.options.text_align.right" }
