  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:sections.our_story.presets.name",
      "settings": {
        "padding_top": 80,
        "padding_right": 0,
        "padding_bottom": 80,
        "padding_left": 0,
        "margin_top": 0,
        "margin_bottom": 0,
        "background_color": "rgba(0,0,0,0)",
        "border_width": 0,
        "border_style": "solid",
        "border_radius_top_left": 0,
        "border_radius_top_right": 0,
        "border_radius_bottom_right": 0,
        "border_radius_bottom_left": 0,
        "border_color": "rgba(0,0,0,0)",
        "heading_size": "large",
        "description_max_width": 560,
        "text_alignment": "center",
        "columns": "3",
        "column_gap": "medium",
        "image_ratio": "portrait",
        "image_border_radius": "medium",
        "entrance_animation": true,
        "full_width": false,
        "section_color_scheme_mode": "default"
      },
      "blocks": [
        { "type": "story_card" },
        { "type": "story_card" },
        { "type": "story_card" }
      ]
    }
  ]
}
{% endschema %}
