{%- liquid
  assign cs_mode = section.settings.section_color_scheme_mode | default: 'default'
  assign cs_scheme = settings.global_color_scheme
  if cs_scheme == blank or cs_scheme.settings == blank
    assign cs_scheme = settings.color_schemes['scheme-1']
  endif
  if cs_mode == 'custom'
    assign picked_cs = section.settings.color_scheme
    if picked_cs != blank and picked_cs.settings != blank
      assign cs_scheme = picked_cs
    endif
  endif

  assign embed_method = section.settings.embed_method | default: 'javascript_api'
  assign iframe_embed_url = section.settings.iframe_embed_url
  assign has_iframe = false
  if embed_method == 'iframe_embed' and iframe_embed_url != blank
    assign has_iframe = true
  endif
  assign map_zoom = section.settings.map_zoom | default: 14
  assign map_style = section.settings.map_style | default: 'default'
  assign section_height = section.settings.section_height | default: 'medium'
  assign card_position = section.settings.card_position | default: 'right'
  assign card_heading = section.settings.card_heading
  assign card_radius = section.settings.card_border_radius | default: 'medium'
  assign show_card_shadow = section.settings.card_shadow | default: true
  assign has_api_key = false
  if section.settings.map_api_key != blank
    assign has_api_key = true
  endif
  assign has_address = false
  if section.settings.map_address != blank
    assign has_address = true
  endif
  assign hours_rows = 0
  if section.settings.show_hours
    assign has_hours = true
    if section.settings.hours_row_1_days != blank and section.settings.hours_row_1_time != blank
      assign hours_rows = hours_rows | plus: 1
    endif
    if section.settings.hours_row_2_days != blank and section.settings.hours_row_2_time != blank
      assign hours_rows = hours_rows | plus: 1
    endif
    if section.settings.hours_row_3_days != blank and section.settings.hours_row_3_time != blank
      assign hours_rows = hours_rows | plus: 1
    endif
  endif
-%}

{%- render 'section-styles', section: section -%}

<div
  class="section-{{ section.id }} maploc shopify-section-wrapper maploc--height-{{ section_height }} maploc--card-{{ card_position }} maploc--card-radius-{{ card_radius }}{% if show_card_shadow %} maploc--card-shadow{% endif %}"
  data-section-type="section-map-location"
  data-section-id="{{ section.id }}"
  data-embed-method="{{ embed_method }}"
  data-map-api-key="{{ section.settings.map_api_key | escape }}"
  data-map-address="{{ section.settings.map_address | escape }}"
  data-map-zoom="{{ map_zoom }}"
  data-map-style="{{ map_style }}"
  style="
    {% render 'color-scheme-vars', scheme: cs_scheme %}
    --maploc-height-desktop: {% case section_height %}{% when 'small' %}320{% when 'large' %}600{% else %}480{% endcase %}px;
    --maploc-card-bg: var(--cs-background, #fff);
  "
  {{ section.shopify_attributes }}
>
  {%- if has_iframe -%}
    <div class="maploc__map-container">
      <iframe
        class="maploc__iframe"
        src="{{ iframe_embed_url }}"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="{{ 'sections.map_location.map_label' | t }}"
      ></iframe>
    </div>
  {%- elsif has_api_key and has_address -%}
    <div class="maploc__map-container">
      <div class="maploc__map" data-maploc-map aria-label="{{ 'sections.map_location.map_label' | t }}"></div>
    </div>
  {%- else -%}
    <div class="maploc__map-container">
      {%- if section.settings.static_map_image != blank -%}
        <div class="maploc__static">
          {{
            section.settings.static_map_image
            | image_url: width: 1440
            | image_tag:
              loading: 'lazy',
              alt: section.settings.map_address,
              class: 'maploc__static-img',
              widths: '400,800,1200,1440',
              sizes: '100vw'
          }}
        </div>
      {%- else -%}
        <div class="maploc__static maploc__static--placeholder">
          <p>{{ 'sections.map_location.no_map' | t }}</p>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="maploc__card">
    {%- if card_heading != blank -%}
      <h3 class="maploc__card-heading">{{ card_heading | escape }}</h3>
    {%- endif -%}

    {%- if section.settings.show_phone and section.settings.phone_number != blank -%}
      <div class="maploc__detail">
        <span class="maploc__detail-label">{{ section.settings.phone_label | default: 'Phone:' | escape }}</span>
        <a href="tel:{{ section.settings.phone_number | escape }}" class="maploc__detail-value maploc__link">
          {{- section.settings.phone_number | escape -}}
        </a>
      </div>
    {%- endif -%}

    {%- if section.settings.show_email and section.settings.email_address != blank -%}
      <div class="maploc__detail">
        <span class="maploc__detail-label">{{ section.settings.email_label | default: 'Email:' | escape }}</span>
        <a href="mailto:{{ section.settings.email_address | escape }}" class="maploc__detail-value maploc__link">
          {{- section.settings.email_address | escape -}}
        </a>
      </div>
    {%- endif -%}

    {%- if section.settings.show_address and section.settings.address != blank -%}
      <div class="maploc__detail">
        <span class="maploc__detail-label">{{ section.settings.address_label | default: 'Address:' | escape }}</span>
        <span class="maploc__detail-value">{{ section.settings.address | escape | newline_to_br }}</span>
      </div>
    {%- endif -%}

    {%- if has_hours and hours_rows > 0 -%}
      <div class="maploc__hours">
        <span class="maploc__hours-label">{{ section.settings.hours_label | default: 'Open Time:' | escape }}</span>
        {%- for i in (1..3) -%}
          {%- liquid
            if i == 1
              assign days = section.settings.hours_row_1_days
              assign time = section.settings.hours_row_1_time
            elsif i == 2
              assign days = section.settings.hours_row_2_days
              assign time = section.settings.hours_row_2_time
            else
              assign days = section.settings.hours_row_3_days
              assign time = section.settings.hours_row_3_time
            endif
          -%}
          {%- if days != blank and time != blank -%}
            <div class="maploc__hours-row">
              <span class="maploc__hours-days">{{ days | escape }}</span>
              <span class="maploc__hours-time">{{ time | escape }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

