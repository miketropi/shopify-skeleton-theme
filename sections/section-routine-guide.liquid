{%- liquid
  assign rg_scheme = settings.global_color_scheme
  if rg_scheme == blank or rg_scheme.settings == blank
    assign rg_scheme = settings.color_schemes['scheme-6']
  endif

  assign rgsm = section.settings.section_color_scheme_mode
  if rgsm == 'custom'
    assign picked_rg = section.settings.color_scheme
    if picked_rg != blank and picked_rg.settings != blank
      assign rg_scheme = picked_rg
    endif
  elsif rgsm == 'default'
  else
    assign picked_rg = section.settings.color_scheme
    if picked_rg != blank and picked_rg.settings != blank
      assign rg_scheme = picked_rg
    endif
  endif

  assign step_count = 0
  for block in section.blocks
    if block.type == 'step'
      assign step_count = step_count | plus: 1
    endif
  endfor

  assign dft = section.settings.default_active_index | default: 1
  if dft < 1
    assign dft = 1
  endif
  if step_count > 0 and dft > step_count
    assign dft = step_count
  endif
  assign default_zero = dft | minus: 1

  assign col_key = section.settings.column_ratio | default: '33'
  assign product_fr = '3fr'
  assign guide_fr = '7fr'
  case col_key
    when '25'
      assign product_fr = '1fr'
      assign guide_fr = '3fr'
    when '40'
      assign product_fr = '2fr'
      assign guide_fr = '3fr'
  endcase

  assign feat_key = section.settings.feature_image_ratio | default: '50'
  assign feature_fr = '1fr'
  assign list_fr = '1fr'
  case feat_key
    when '40'
      assign feature_fr = '2fr'
      assign list_fr = '3fr'
    when '60'
      assign feature_fr = '3fr'
      assign list_fr = '2fr'
  endcase

  assign rad_key = section.settings.card_border_radius | default: 'medium'
  case rad_key
    when 'none'
      assign rad_px = 0
    when 'small'
      assign rad_px = 8
    when 'large'
      assign rad_px = 24
    else
      assign rad_px = 16
  endcase

  assign fade_ms = section.settings.hover_transition_speed | default: '300'
  case fade_ms
    when '150'
      assign fade_s = 0.15
    when '500'
      assign fade_s = 0.5
    else
      assign fade_s = 0.3
  endcase

  assign media_size_key = section.settings.feature_media_size | default: 'medium'
  assign feature_img_width = 1200
  assign feature_img_widths = '400,600,800,1200,1600'
  assign feature_video_image_size = '1200x'
  case media_size_key
    when 'small'
      assign feature_img_width = 600
      assign feature_img_widths = '300,450,600'
      assign feature_video_image_size = '600x'
    when 'large'
      assign feature_img_width = 1600
      assign feature_img_widths = '400,600,800,1200,1600'
      assign feature_video_image_size = '1600x'
    when 'xlarge'
      assign feature_img_width = 2400
      assign feature_img_widths = '600,800,1200,1600,2400'
      assign feature_video_image_size = '2400x'
  endcase

  assign rg_product = section.settings.product
  if rg_product == blank
    assign rg_all = collections.all
    if rg_all != blank and rg_all.products.size > 0
      assign rg_product = rg_all.products.first
    endif
  endif
  assign product_bg = section.settings.card_background_color | default: '#F9F3EE'
  assign steps_bg = section.settings.steps_background_color | default: '#F7F5F2'
  assign step_active_bg = section.settings.step_active_background_color | default: '#FFFFFF'

  assign has_header = false
  if section.settings.eyebrow_text != blank or section.settings.heading != blank
    assign has_header = true
  endif
-%}
{%- capture rg_scheme_vars -%}
  {%- render 'color-scheme-vars', scheme: rg_scheme, inline_only: true -%}
{%- endcapture -%}

{%- render 'section-styles', section: section -%}

{% style %}
  html.js #shopify-section-{{ section.id }} .routine-guide:not(.routine-guide--revealed) [data-routine-guide-reveal-product],
  html.js #shopify-section-{{ section.id }} .routine-guide:not(.routine-guide--revealed) [data-routine-guide-reveal-feature],
  html.js #shopify-section-{{ section.id }} .routine-guide:not(.routine-guide--revealed) [data-routine-guide-reveal-steps],
  html.js #shopify-section-{{ section.id }} .routine-guide:not(.routine-guide--revealed) .routine-guide__step-item {
    opacity: 0;
  }
{% endstyle %}

<div
  class="section-{{ section.id }} routine-guide shopify-section-wrapper section-intro--heading-{{ section.settings.heading_size | default: 'large' }}{% if section.settings.step_divider %} routine-guide--dividers{% endif %}{% if section.settings.full_width %} full-width routine-guide--full-width{% endif %}"
  data-section-type="section-routine-guide"
  data-section-id="{{ section.id }}"
  data-routine-guide-default="{{ default_zero }}"
  data-routine-guide-entrance-scroll="{% if section.settings.entrance_animate_on_scroll == false %}false{% else %}true{% endif %}"
  style="
    {{ rg_scheme_vars }}
    --routine-guide-product-fr: {{ product_fr }};
    --routine-guide-guide-fr: {{ guide_fr }};
    --routine-guide-feature-fr: {{ feature_fr }};
    --routine-guide-list-fr: {{ list_fr }};
    --routine-guide-radius: {{ rad_px }}px;
    --routine-guide-fade-duration: {{ fade_s }}s;
    --routine-guide-product-bg: {{ product_bg }};
    --routine-guide-steps-bg: {{ steps_bg }};
    --routine-guide-step-active-bg: {{ step_active_bg }};
  "
  {{ section.shopify_attributes }}
>
  <div class="routine-guide__inner{% if section.settings.full_width %} section-content-width{% endif %}">
    {%- if has_header -%}
      <header class="routine-guide__header section-intro__copy" data-routine-guide-reveal-header>
        {%- if section.settings.eyebrow_text != blank -%}
          <p class="section-intro__eyebrow">{{ section.settings.eyebrow_text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-intro__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="routine-guide__grid">
      <div class="routine-guide__product-col">
        <div class="routine-guide__product-panel" data-routine-guide-reveal-product>
          {%- if rg_product != blank -%}
            <div class="routine-guide__product-card">
              {%- render 'tcard-product',
                product: rg_product,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor,
                show_quick_add: section.settings.show_quick_add
              -%}
            </div>
          {%- else -%}
            <div class="routine-guide__product-placeholder">
              <p class="routine-guide__product-placeholder-text">
                {{ 'sections.routine_guide.select_product' | t }}
              </p>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="routine-guide__guide-col">
        <div class="routine-guide__guide-inner">
            {%- render 'routine-guide-feature-panel',
              section: section,
              default_zero: default_zero,
              feature_img_width: feature_img_width,
              feature_img_widths: feature_img_widths,
              feature_video_image_size: feature_video_image_size,
              step_count: step_count
            -%}
          {%- render 'routine-guide-steps',
            section: section,
            default_zero: default_zero,
            step_count: step_count
          -%}
        </div>
      </div>
    </div>
  </div>
</div>

