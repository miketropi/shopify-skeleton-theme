{% comment %}
  Collection page — three-part layout:
  1. Hero header (image backdrop, title, description, count)
  2. Product grid (cards with hover image swap + floating quick-add)
  3. Pagination (pill-style numbered navigation)
{% endcomment %}

{%- liquid
  assign cols = section.settings.columns | default: 4
  assign per_page = section.settings.per_page | default: 24
  assign show_vendor = section.settings.show_vendor
  assign show_secondary_image = section.settings.show_secondary_image
  assign show_quick_add = section.settings.show_quick_add
-%}

<section
  class="section-collection"
  data-section-type="collection-grid"
  data-section-id="{{ section.id }}"
  style="--collection-cols: {{ cols }};"
>
  {%- comment -%} ━━━ PART 1 — Hero Header ━━━ {%- endcomment -%}
  <div class="col-hero">
    {%- if collection.image -%}
      <div class="col-hero__bg">
        {{ collection.image
          | image_url: width: 1600
          | image_tag:
              loading: 'eager',
              alt: '',
              class: 'col-hero__bg-img',
              widths: '600,900,1200,1600',
              sizes: '100vw'
        }}
      </div>
    {%- endif -%}
    <div class="col-hero__overlay"></div>
    <div class="col-hero__inner">
      <div class="col-hero__content">
        <h1 class="col-hero__title">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}
          <div class="col-hero__desc">{{ collection.description }}</div>
        {%- endif -%}
      </div>
      <div class="col-hero__meta">
        <span class="col-hero__count">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          {{ collection.products_count }}
          {{ collection.products_count | pluralize: 'product', 'products' }}
        </span>
      </div>
    </div>
  </div>

  {%- comment -%} ━━━ PART 2 — Product Grid ━━━ {%- endcomment -%}
  {% paginate collection.products by per_page %}
    <div class="col-products">
      {%- if collection.products.size > 0 -%}
        <ul class="col-grid" role="list">
          {%- for product in collection.products -%}
            {%- liquid
              assign on_sale = false
              if product.compare_at_price > product.price
                assign on_sale = true
              endif
              assign first_variant = product.first_available_variant | default: product.variants.first
              assign has_second = false
              if show_secondary_image and product.images.size > 1
                assign has_second = true
              endif
            -%}

            <li class="col-grid__item">
              <article class="cg-card{% if has_second %} cg-card--has-alt{% endif %}">
                <a class="cg-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                  {%- if on_sale -%}
                    <span class="cg-card__badge cg-card__badge--sale">{{ 'products.product.sale' | t | default: 'Sale' }}</span>
                  {%- elsif product.available == false -%}
                    <span class="cg-card__badge cg-card__badge--soldout">{{ 'products.product.sold_out' | t | default: 'Sold out' }}</span>
                  {%- endif -%}

                  {%- if product.featured_image != blank -%}
                    {{ product.featured_image
                      | image_url: width: 800
                      | image_tag:
                          loading: 'lazy',
                          alt: product.featured_image.alt | default: product.title,
                          class: 'cg-card__img cg-card__img--primary',
                          widths: '360,480,600,800',
                          sizes: '(min-width:62em) 25vw, (min-width:36em) 50vw, 100vw'
                    }}
                    {%- if has_second -%}
                      {{ product.images[1]
                        | image_url: width: 800
                        | image_tag:
                            loading: 'lazy',
                            alt: product.images[1].alt | default: product.title,
                            class: 'cg-card__img cg-card__img--secondary',
                            widths: '360,480,600,800',
                            sizes: '(min-width:62em) 25vw, (min-width:36em) 50vw, 100vw'
                      }}
                    {%- endif -%}
                  {%- else -%}
                    <div class="cg-card__placeholder" aria-hidden="true">
                      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity=".25" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                    </div>
                  {%- endif -%}

                  {%- if show_quick_add and first_variant and first_variant.available -%}
                    <span class="cg-card__quick-label">{{ 'products.product.add_to_cart' | t | default: 'Quick add' }}</span>
                  {%- endif -%}
                </a>

                {%- if show_quick_add and first_variant and first_variant.available -%}
                  <form
                    action="{{ routes.cart_add_url }}"
                    method="post"
                    data-ajax-add-to-cart
                    class="cg-card__atc-form"
                  >
                    <input type="hidden" name="id" value="{{ first_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button
                      type="submit"
                      class="cg-card__atc-btn"
                      aria-label="{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }} — {{ product.title | escape }}"
                      data-product-submit
                      data-product-available="{{ first_variant.available }}"
                    >
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    </button>
                  </form>
                {%- endif -%}

                <div class="cg-card__info">
                  {%- if show_vendor and product.vendor != blank -%}
                    <span class="cg-card__vendor">{{ product.vendor }}</span>
                  {%- endif -%}

                  <a class="cg-card__title" href="{{ product.url }}">
                    {{ product.title | escape }}
                  </a>

                  <div class="cg-card__price-row">
                    {%- if on_sale -%}
                      <s class="cg-card__price cg-card__price--was">{{ product.compare_at_price | money }}</s>
                    {%- endif -%}
                    <span class="cg-card__price cg-card__price--now{% if on_sale %} cg-card__price--sale{% endif %}">
                      {{ product.price | money }}
                    </span>
                  </div>
                </div>
              </article>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="col-grid__empty">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".4" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <p>{{ 'collections.general.no_matches' | t | default: 'No products found in this collection.' }}</p>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ━━━ PART 3 — Pagination ━━━ {%- endcomment -%}
    {%- if paginate.pages > 1 -%}
      <nav class="col-pagination" aria-label="Pagination">
        {%- if paginate.previous -%}
          <a class="col-pagination__arrow" href="{{ paginate.previous.url }}" aria-label="Previous page">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          </a>
        {%- else -%}
          <span class="col-pagination__arrow col-pagination__arrow--disabled" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          </span>
        {%- endif -%}

        <ol class="col-pagination__pages">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <li><a class="col-pagination__page" href="{{ part.url }}">{{ part.title }}</a></li>
            {%- else -%}
              {%- if part.title == paginate.current_page -%}
                <li><span class="col-pagination__page col-pagination__page--current" aria-current="page">{{ part.title }}</span></li>
              {%- else -%}
                <li><span class="col-pagination__page col-pagination__page--gap">{{ part.title }}</span></li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </ol> 

        {%- if paginate.next -%}
          <a class="col-pagination__arrow" href="{{ paginate.next.url }}" aria-label="Next page">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        {%- else -%}
          <span class="col-pagination__arrow col-pagination__arrow--disabled" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </span>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add-to-cart",
      "default": true
    }
  ]
}
{% endschema %}
