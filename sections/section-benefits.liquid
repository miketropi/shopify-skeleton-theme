{%- liquid
  assign ben_scheme = settings.global_color_scheme
  if ben_scheme == blank or ben_scheme.settings == blank
    assign ben_scheme = settings.color_schemes['scheme-6']
  endif

  assign ben_sm = section.settings.section_color_scheme_mode
  if ben_sm == 'custom'
    assign picked_ben = section.settings.color_scheme
    if picked_ben != blank and picked_ben.settings != blank
      assign ben_scheme = picked_ben
    endif
  elsif ben_sm == 'default'
  else
    assign picked_ben = section.settings.color_scheme
    if picked_ben != blank and picked_ben.settings != blank
      assign ben_scheme = picked_ben
    endif
  endif

  assign heading_size = section.settings.heading_size | default: 'large'
  assign text_alignment = section.settings.text_alignment | default: 'left'
  assign columns = section.settings.columns | default: '3'
  assign column_gap_key = section.settings.column_gap | default: 'medium'
  assign icon_size_key = section.settings.icon_size | default: 'medium'
  assign icon_color = section.settings.icon_color

  case column_gap_key
    when 'small'
      assign gap_px = 24
    when 'medium'
      assign gap_px = 40
    when 'large'
      assign gap_px = 64
  endcase

  case icon_size_key
    when 'small'
      assign icon_px = 32
    when 'medium'
      assign icon_px = 40
    when 'large'
      assign icon_px = 48
  endcase

  assign has_intro = false
  if section.settings.eyebrow_text != blank or section.settings.heading != blank or section.settings.description != blank
    assign has_intro = true
  endif

  assign block_count = 0
  for block in section.blocks
    if block.type == 'benefit'
      assign block_count = block_count | plus: 1
    endif
  endfor

  assign icon_sizes_str = icon_px | append: 'px'
-%}
{%- capture ben_scheme_vars -%}
  {%- render 'color-scheme-vars', scheme: ben_scheme, inline_only: true -%}
{%- endcapture -%}

{%- render 'section-styles', section: section -%}

{%- if block_count > 0 -%}
{% style %}
  html.js #shopify-section-{{ section.id }} .ben:not(.ben--revealed) .ben__item {
    opacity: 0;
  }
{% endstyle %}
{%- endif -%}

<div
  class="section-{{ section.id }} ben shopify-section-wrapper section-intro--heading-{{ heading_size }} ben--cols-{{ columns }} ben--align-{{ text_alignment }}{% if section.settings.full_width %} full-width ben--full-width{% endif %}"
  data-section-type="section-benefits"
  data-section-id="{{ section.id }}"
  data-benefits-entrance-scroll="{% if section.settings.entrance_animate_on_scroll == false %}false{% else %}true{% endif %}"
  style="
    {{ ben_scheme_vars }}
    --ben-columns: {{ columns }};
    --ben-column-gap: {{ gap_px }}px;
    --ben-icon-size: {{ icon_px }}px;
    {%- if icon_color != blank and icon_color != 'rgba(0,0,0,0)' -%}
      --ben-icon-color: {{ icon_color }};
    {%- endif -%}
  "
  {{ section.shopify_attributes }}
>
  <div class="ben__shell{% if section.settings.full_width %} section-content-width{% endif %}">
    {%- if has_intro -%}
      <header class="ben__intro section-intro__copy{% if text_alignment == 'center' %} ben__intro--center{% endif %}">
        {%- if section.settings.eyebrow_text != blank -%}
          <p class="section-intro__eyebrow">{{ section.settings.eyebrow_text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-intro__heading ben__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="ben__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if block_count > 0 -%}
      <div class="ben__loading" data-benefits-loading aria-hidden="true">
        <span class="ben__loading-inner">
          <span class="ben__loading-dot"></span>
          <span class="ben__loading-dot"></span>
          <span class="ben__loading-dot"></span>
        </span>
      </div>

      <ul class="ben__grid" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            {%- assign has_icon = false -%}
            {%- if block.settings.custom_icon != blank or block.settings.icon != 'none' -%}
              {%- assign has_icon = true -%}
            {%- endif -%}

            {%- assign block_is_empty = false -%}
            {%- if block.settings.heading == blank and block.settings.description == blank and has_icon == false -%}
              {%- assign block_is_empty = true -%}
            {%- endif -%}

            {%- unless block_is_empty -%}
              <li class="ben__item" {{ block.shopify_attributes }}>
                {%- if has_icon -%}
                  <div class="ben__icon">
                    {%- if block.settings.custom_icon != blank -%}
                      {{
                        block.settings.custom_icon
                        | image_url: width: 160
                        | image_tag:
                          class: 'ben__icon-img',
                          widths: '32,40,48,80',
                          sizes: icon_sizes_str,
                          width: icon_px,
                          height: icon_px,
                          loading: 'lazy',
                          alt: ''
                      }}
                    {%- else -%}
                      {%- render 'benefit-icon', icon: block.settings.icon -%}
                    {%- endif -%}
                  </div>
                {%- endif -%}

                <div class="ben__content">
                  {%- if block.settings.heading != blank -%}
                    <h3 class="ben__item-heading">{{ block.settings.heading | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <p class="ben__item-text">{{ block.settings.description | escape }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.benefits.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "settings": [
