      "options": [
        { "value": "2", "label": "t:sections.benefits.options.columns.2" },
        { "value": "3", "label": "t:sections.benefits.options.columns.3" },
        { "value": "4", "label": "t:sections.benefits.options.columns.4" }
      ]
    },
    {
      "type": "select",
      "id": "column_gap",
