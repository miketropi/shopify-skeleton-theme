    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.benefits.labels.padding_left",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.benefits.headers.margin"
