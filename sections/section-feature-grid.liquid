{%- liquid
  assign fg_scheme = settings.global_color_scheme
  if fg_scheme == blank or fg_scheme.settings == blank
    assign fg_scheme = settings.color_schemes['scheme-6']
  endif

  assign fgsm = section.settings.section_color_scheme_mode
  if fgsm == 'custom'
    assign picked_fg = section.settings.color_scheme
    if picked_fg != blank and picked_fg.settings != blank
      assign fg_scheme = picked_fg
    endif
  elsif fgsm == 'default'
  else
    assign picked_fg = section.settings.color_scheme
    if picked_fg != blank and picked_fg.settings != blank
      assign fg_scheme = picked_fg
    endif
  endif
-%}
{%- capture fg_scheme_vars -%}
  {%- render 'color-scheme-vars', scheme: fg_scheme, inline_only: true -%}
{%- endcapture -%}

{%- render 'section-styles', section: section -%}

<div
  class="section-{{ section.id }} section-feature-grid section-feature-grid--align-{{ section.settings.heading_alignment }} section-feature-grid--density-{{ section.settings.section_density }} section-feature-grid--card-{{ section.settings.card_style }} section-feature-grid--cols-{{ section.settings.columns }}{% if section.settings.entrance_animation %} section-feature-grid--animate{% endif %}{% if section.settings.full_width %} full-width{% endif %} shopify-section-wrapper"
  data-section-type="section-feature-grid"
  data-section-id="{{ section.id }}"
  style="{{ fg_scheme_vars }} --fg-item-count: {{ section.blocks.size }};"
  {{ section.shopify_attributes }}
>
  {%- if section.blocks.size > 0 -%}
    <div class="section-feature-grid__inner{% if section.settings.full_width %} section-content-width{% endif %}">
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="section-feature-grid__intro">
          <header class="section-feature-grid__header">
            {%- if section.settings.heading != blank -%}
              <h2 class="section-feature-grid__heading">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.subheading != blank -%}
              <div class="section-feature-grid__subheading rte">{{ section.settings.subheading }}</div>
            {%- endif -%}
          </header>
        </div>
      {%- endif -%}

      <ul class="section-feature-grid__list" role="list">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'feature' -%}
              <li
                class="section-feature-grid__item"
                style="--fg-i: {{ forloop.index0 }};"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.image != blank -%}
                  {%- assign card_image_alt = block.settings.image_alt | default: '' -%}
                  <div class="section-feature-grid__icon-wrap">
                    {{
                      block.settings.image
                      | image_url: width: 200
                      | image_tag:
                        loading: 'lazy',
                        class: 'section-feature-grid__icon',
                        widths: '100, 150, 200',
                        sizes: '80px',
                        alt: card_image_alt
                    }}
                  </div>
                {%- endif -%}

                <div class="section-feature-grid__content">
                  {%- if block.settings.kicker != blank -%}
                    <p class="section-feature-grid__kicker">{{ block.settings.kicker | escape }}</p>
                  {%- endif -%}

                  {%- if block.settings.title != blank -%}
                    {%- if section.settings.heading != blank -%}
                      <h3 class="section-feature-grid__item-title">{{ block.settings.title | escape }}</h3>
                    {%- else -%}
                      <h2 class="section-feature-grid__item-title">{{ block.settings.title | escape }}</h2>
                    {%- endif -%}
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <div class="section-feature-grid__item-text rte">{{ block.settings.text }}</div>
                  {%- endif -%}

                  {%- if block.settings.link != blank and block.settings.link_label != blank -%}
                    <a
                      class="section-feature-grid__link"
                      href="{{ block.settings.link }}"
                      {% if block.settings.open_in_new_tab %}
                        target="_blank" rel="noopener noreferrer"
                      {% endif %}
                    >
                      <span class="section-feature-grid__link-text">{{ block.settings.link_label | escape }}</span>
                      <span class="section-feature-grid__link-chevron" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                          <path d="M3 1.5 8.25 6 3 10.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                    </a>
                  {%- endif -%}
                </div>
              </li>
          {%- endcase -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.feature_grid.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.feature_grid.headers.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.feature_grid.labels.heading",
      "default": "Why shop with us"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:sections.feature_grid.labels.subheading",
      "default": "<p>We focus on the details that make shopping simple and products that last.</p>"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.feature_grid.labels.heading_alignment",
      "options": [
        { "value": "left", "label": "t:sections.feature_grid.options.heading_align.left" },
        { "value": "center", "label": "t:sections.feature_grid.options.heading_align.center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.feature_grid.headers.colour"
    },
    {
      "type": "select",
      "id": "section_color_scheme_mode",
      "label": "t:sections.feature_grid.section_color_scheme_mode",
      "options": [
        { "value": "default", "label": "t:sections.feature_grid.section_color_scheme_mode_default" },
        { "value": "custom", "label": "t:sections.feature_grid.section_color_scheme_mode_custom" }
      ],
      "default": "default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.feature_grid.color_scheme",
      "info": "t:sections.feature_grid.color_scheme_info",
      "default": "scheme-6",
      "visible_if": "{{ section.settings.section_color_scheme_mode == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:sections.feature_grid.headers.grid"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.feature_grid.labels.columns",
      "info": "t:sections.feature_grid.labels.columns_info",
      "options": [
        { "value": "auto", "label": "t:sections.feature_grid.options.columns.auto" },
        { "value": "2", "label": "t:sections.feature_grid.options.columns.2" },
        { "value": "3", "label": "t:sections.feature_grid.options.columns.3" },
        { "value": "4", "label": "t:sections.feature_grid.options.columns.4" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:sections.feature_grid.labels.card_style",
      "options": [
        { "value": "elevated", "label": "t:sections.feature_grid.options.card_style.elevated" },
        { "value": "soft", "label": "t:sections.feature_grid.options.card_style.soft" },
        { "value": "minimal", "label": "t:sections.feature_grid.options.card_style.minimal" }
      ],
      "default": "elevated"
    },
    {
      "type": "select",
      "id": "section_density",
      "label": "t:sections.feature_grid.labels.section_density",
      "options": [
        { "value": "compact", "label": "t:sections.feature_grid.options.density.compact" },
        { "value": "default", "label": "t:sections.feature_grid.options.density.default" },
        { "value": "spacious", "label": "t:sections.feature_grid.options.density.spacious" }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "entrance_animation",
      "label": "t:sections.feature_grid.labels.entrance_animation",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.feature_grid.headers.layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.feature_grid.labels.full_width",
      "info": "t:sections.feature_grid.labels.full_width_info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.feature_grid.headers.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.feature_grid.labels.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.feature_grid.labels.padding_right",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.feature_grid.labels.padding_bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.feature_grid.labels.padding_left",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.feature_grid.headers.margin"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.feature_grid.labels.margin_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.feature_grid.labels.margin_bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.feature_grid.headers.background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.feature_grid.labels.background_color",
      "default": "rgba(0,0,0,0)",
      "info": "t:sections.feature_grid.labels.background_color_info"
    },
    {
      "type": "header",
      "content": "t:sections.feature_grid.headers.border"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "t:sections.feature_grid.labels.border_width",
      "default": 0
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:sections.feature_grid.labels.border_style",
      "options": [
        { "value": "none", "label": "t:sections.feature_grid.options.border_style.none" },
        { "value": "solid", "label": "t:sections.feature_grid.options.border_style.solid" },
        { "value": "dashed", "label": "t:sections.feature_grid.options.border_style.dashed" },
        { "value": "dotted", "label": "t:sections.feature_grid.options.border_style.dotted" }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:sections.feature_grid.labels.border_color",
      "default": "rgba(0,0,0,0)",
      "info": "t:sections.feature_grid.labels.border_color_info"
    },
    {
      "type": "header",
      "content": "t:sections.feature_grid.headers.radius"
    },
    {
      "type": "range",
      "id": "border_radius_top_left",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "t:sections.feature_grid.labels.radius_tl",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius_top_right",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "t:sections.feature_grid.labels.radius_tr",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius_bottom_right",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "t:sections.feature_grid.labels.radius_br",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius_bottom_left",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "t:sections.feature_grid.labels.radius_bl",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:sections.feature_grid.blocks.feature.name",
      "limit": 9,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.feature_grid.blocks.feature.image",
          "info": "t:sections.feature_grid.blocks.feature.image_info"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "t:sections.feature_grid.blocks.feature.image_alt",
          "info": "t:sections.feature_grid.blocks.feature.image_alt_info"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "t:sections.feature_grid.blocks.feature.kicker"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.feature_grid.blocks.feature.title",
          "default": "Feature title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.feature_grid.blocks.feature.text",
          "default": "<p>Short, helpful copy that explains your value in one or two sentences.</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.feature_grid.blocks.feature.link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.feature_grid.blocks.feature.link_label"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "t:sections.feature_grid.blocks.feature.open_in_new_tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.feature_grid.name",
      "settings": {
        "padding_top": 40,
        "padding_right": 0,
        "padding_bottom": 40,
        "padding_left": 0,
        "margin_top": 0,
        "margin_bottom": 0,
        "background_color": "rgba(0,0,0,0)",
        "border_width": 0,
        "border_style": "solid",
        "border_radius_top_left": 0,
        "border_radius_top_right": 0,
        "border_radius_bottom_right": 0,
        "border_radius_bottom_left": 0,
        "border_color": "rgba(0,0,0,0)",
        "heading": "Why shop with us",
        "subheading": "<p>We focus on the details that make shopping simple and products that last.</p>",
        "heading_alignment": "center",
        "columns": "auto",
        "card_style": "elevated",
        "section_density": "default",
        "entrance_animation": true,
        "full_width": false,
        "section_color_scheme_mode": "default"
      },
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "14 Day Returns Policy",
            "text": "<p>Rick-free shopping with easy returns.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Free Shipping",
            "text": "<p>No extra costs, just the price you see.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "24/7 Support",
            "text": "<p>We're here to help you every step of the way.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Member Offers",
            "text": "<p>Special discounts and perks just for you.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
