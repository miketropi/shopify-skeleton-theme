<div
  class="section-{{ section.id }} section-main-customers-order"
  data-section-type="main-customers-order"
  data-section-id="{{ section.id }}"
  {% render 'color-scheme-vars' %}
>
  <h1>{{- 'customer.order.title' | t: name: order.name -}}</h1>

  {%- assign order_date_formatted = order.created_at | date: format: 'date' -%}
  <p>{{- 'customer.order.date_html' | t: date: order_date_formatted -}}</p>

  {%- if order.cancelled -%}
    {%- assign cancelled_date = order.cancelled_at | date: format: 'date' -%}
    <p class="customers-order__cancelled">
      {{- 'customer.order.cancelled_html' | t: date: cancelled_date, reason: order.cancel_reason_label -}}
    </p>
  {%- endif -%}

  <table class="customers-order__items">
    <thead>
      <tr>
        <th>{{- 'customer.order.product' | t -}}</th>
        <th>{{- 'customer.order.sku' | t -}}</th>
        <th>{{- 'customer.order.price' | t -}}</th>
        <th>{{- 'customer.order.quantity' | t -}}</th>
        <th>{{- 'customer.order.total' | t -}}</th>
      </tr>
    </thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr>
          <td>
            <a href="{{ line_item.product.url }}">{{- line_item.title | escape -}}</a>
            {%- if line_item.fulfillment -%}
              {%- assign fulfill_date = line_item.fulfillment.created_at | date: format: 'date' -%}
              <span class="customers-order__tracking">
                {{- 'customer.order.fulfilled_at_html' | t: date: fulfill_date -}}
                {%- if line_item.fulfillment.tracking_url -%}
                  <a href="{{ line_item.fulfillment.tracking_url }}" target="_blank" rel="noopener">
                    {{- line_item.fulfillment.tracking_company -}}
                  </a>
                {%- endif -%}
              </span>
            {%- endif -%}
          </td>
          <td>{{- line_item.sku | escape -}}</td>
          <td>{%- render 'price-display', price: line_item.final_price, variant: 'table' -%}</td>
          <td>{{- line_item.quantity -}}</td>
          <td>{%- render 'price-display', price: line_item.final_line_price, variant: 'table' -%}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>

  <div class="customers-order__summary">
    <p>{{- 'customer.order.subtotal' | t -}}: {% render 'price-display', price: order.subtotal_price, variant: 'account' %}</p>
    {%- for discount in order.cart_level_discount_applications -%}
      <p>{{- discount.title | escape -}}: -&nbsp;{% render 'price-display', price: discount.total_allocated_amount, variant: 'account' %}</p>
    {%- endfor -%}
    {%- for shipping_method in order.shipping_methods -%}
      <p>{{- shipping_method.title | escape -}}: {% render 'price-display', price: shipping_method.price, variant: 'account' %}</p>
    {%- endfor -%}
    {%- for tax_line in order.tax_lines -%}
      <p>{{- tax_line.title | escape -}} ({{ tax_line.rate | times: 100 }}%): {% render 'price-display', price: tax_line.price, variant: 'account' %}</p>
    {%- endfor -%}
    <p><strong>{{- 'customer.order.total' | t -}}: {% render 'price-display', price: order.total_price, variant: 'account', with_currency: true %}</strong></p>
  </div>
</div>

{% schema %}
{
  "name": "Order",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [{ "name": "Order" }]
}
{% endschema %}
