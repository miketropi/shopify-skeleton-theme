{%- liquid
  assign per_page = section.settings.results_per_page | default: 24 | plus: 0
  if per_page < 6
    assign per_page = 24
  elsif per_page > 48
    assign per_page = 48
  endif
  assign scope = section.settings.search_scope | default: 'all'
-%}

<div
  class="section-{{ section.id }} section-search"
  data-section-type="search"
  data-section-id="{{ section.id }}"
  {% render 'color-scheme-vars' %}
>
  <div class="section-search__inner">
    <header class="section-search__header">
      <h1 class="section-search__title">{{ 'search.title' | t }}</h1>
      {%- unless search.performed -%}
        <p class="section-search__intro">{{ 'search.intro' | t }}</p>
      {%- endunless -%}
    </header>

    <form
      class="section-search__form"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      accept-charset="UTF-8"
    >
      {%- if scope == 'product' -%}
        <input type="hidden" name="type" value="product">
      {%- endif -%}
      <div class="section-search__fields">
        <label class="section-search__label visually-hidden" for="SearchInput-{{ section.id }}">
          {{- 'search.label' | t -}}
        </label>
        <input
          id="SearchInput-{{ section.id }}"
          class="section-search__input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{% if scope == 'product' %}{{ 'search.placeholder_products' | t }}{% else %}{{ 'search.placeholder' | t }}{% endif %}"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        >
        <button type="submit" class="section-search__submit">
          {{- 'search.submit' | t -}}
        </button>
      </div>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <div class="section-search__empty" role="status">
          <p class="section-search__empty-text">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
          <a class="section-search__link" href="{{ routes.all_products_collection_url }}">
            {{- 'search.browse_products' | t -}}
          </a>
        </div>
      {%- else -%}
        <p class="section-search__summary">
          {{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}
        </p>

        {%- paginate search.results by per_page -%}
          <ul class="section-search__grid" role="list">
            {%- for result in search.results -%}
              <li class="section-search__item">
                {%- if result.object_type == 'product' -%}
                  {%- render 'product-card', product: result -%}
                {%- else -%}
                  {%- liquid
                    assign result_image = result.featured_image | default: result.image
                    assign type_key = 'search.result_type_' | append: result.object_type
                  -%}
                  <a class="section-search__content-card" href="{{ result.url }}">
                    <div class="section-search__content-media">
                      {%- if result_image != blank -%}
                        {{
                          result_image
                          | image_url: width: 600
                          | image_tag:
                            loading: 'lazy',
                            class: 'section-search__content-img',
                            sizes: '(min-width: 62em) 280px, (min-width: 36em) 40vw, 100vw',
                            widths: '240, 360, 480, 600'
                        }}
                      {%- else -%}
                        <span class="section-search__content-placeholder" aria-hidden="true"></span>
                      {%- endif -%}
                    </div>
                    <div class="section-search__content-body">
                      <span class="section-search__content-type">{{ type_key | t }}</span>
                      <span class="section-search__content-title">{{ result.title | escape }}</span>
                      {%- if result.object_type == 'article' -%}
                        {%- liquid
                          assign excerpt_source = result.excerpt | default: result.content
                        -%}
                        {%- if excerpt_source != blank -%}
                          <span class="section-search__content-excerpt">
                            {{- excerpt_source | strip_html | truncate: 120 -}}
                          </span>
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          {%- if paginate.pages > 1 -%}
            <nav class="section-search__pagination" aria-label="{{ 'general.pagination.label' | t }}">
              {{- paginate | default_pagination -}}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:general.search",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "min": 6,
      "max": 48,
      "step": 6,
      "default": 24,
      "label": "t:labels.search_results_per_page"
    },
    {
      "type": "select",
      "id": "search_scope",
      "label": "t:labels.search_scope",
      "options": [
        { "value": "all", "label": "t:options.search_scope.all" },
        { "value": "product", "label": "t:options.search_scope.product" }
      ],
      "default": "all",
      "info": "t:info.search_scope"
    }
  ]
}
{% endschema %}
