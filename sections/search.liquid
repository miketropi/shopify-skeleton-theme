{%- liquid
  assign per_page = section.settings.results_per_page | default: 24 | plus: 0
  if per_page < 6
    assign per_page = 24
  elsif per_page > 48
    assign per_page = 48
  endif
  assign scope = section.settings.search_scope | default: 'all'
  assign cols = section.settings.columns | default: 3
  assign image_ratio = section.settings.image_ratio | default: '3/4'
  assign show_vendor = section.settings.show_vendor
  assign show_secondary_image = section.settings.show_secondary_image
-%}

<div
  class="section-{{ section.id }} msrch"
  data-section-type="search"
  data-section-id="{{ section.id }}"
  style="--msrch-cols: {{ cols }}; --tcard-image-ratio: {{ image_ratio }};"
  {% render 'color-scheme-vars' %}
>
  <header class="msrch__header">
    <h1 class="msrch__title">{{ 'search.title' | t }}</h1>
    {%- unless search.performed -%}
      <p class="msrch__intro">{{ 'search.intro' | t }}</p>
    {%- endunless -%}
  </header>

  <form
    class="msrch__form"
    action="{{ routes.search_url }}"
    method="get"
    role="search"
    accept-charset="UTF-8"
  >
    {%- if scope == 'product' -%}
      <input type="hidden" name="type" value="product">
    {%- endif -%}
    <div class="msrch__fields">
      <label class="visually-hidden" for="SearchInput-{{ section.id }}">
        {{- 'search.label' | t -}}
      </label>
      <div class="msrch__input-wrap">
        <svg class="msrch__input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input
          id="SearchInput-{{ section.id }}"
          class="msrch__input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{% if scope == 'product' %}{{ 'search.placeholder_products' | t }}{% else %}{{ 'search.placeholder' | t }}{% endif %}"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        >
      </div>
      <button type="submit" class="msrch__submit">
        {{- 'search.submit' | t -}}
      </button>
    </div>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <div class="msrch__empty">
        <div class="msrch__empty-icon" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </div>
        <p class="msrch__empty-text">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
        <a class="msrch__empty-link" href="{{ routes.all_products_collection_url }}">
          {{- 'search.browse_products' | t -}}
        </a>
      </div>
    {%- else -%}
      <p class="msrch__summary">
        {{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}
      </p>

      {%- paginate search.results by per_page -%}
        <ul class="msrch__grid" role="list">
          {%- for result in search.results -%}
            <li class="msrch__grid-item">
              {%- if result.object_type == 'product' -%}
                {%- render 'tcard-product',
                  product: result,
                  show_secondary_image: show_secondary_image,
                  show_vendor: show_vendor,
                  show_quick_add: false
                -%}
              {%- else -%}
                {%- render 'tcard-content', result: result -%}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="msrch__pag" aria-label="{{ 'general.pagination.label' | t }}">
            {%- if paginate.previous -%}
              <a class="msrch__pag-arrow" href="{{ paginate.previous.url }}" aria-label="Previous page">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
              </a>
            {%- else -%}
              <span class="msrch__pag-arrow msrch__pag-arrow--disabled" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
              </span>
            {%- endif -%}

            <ol class="msrch__pag-list">
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <li><a class="msrch__pag-item" href="{{ part.url }}">{{ part.title }}</a></li>
                {%- else -%}
                  {%- if part.title == paginate.current_page -%}
                    <li><span class="msrch__pag-item msrch__pag-item--active" aria-current="page">{{ part.title }}</span></li>
                  {%- else -%}
                    <li><span class="msrch__pag-item msrch__pag-item--gap">{{ part.title }}</span></li>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </ol>

            {%- if paginate.next -%}
              <a class="msrch__pag-arrow" href="{{ paginate.next.url }}" aria-label="Next page">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            {%- else -%}
              <span class="msrch__pag-arrow msrch__pag-arrow--disabled" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </span>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:general.search",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.search.headers.results"
    },
    {
      "type": "range",
      "id": "results_per_page",
      "min": 6,
      "max": 48,
      "step": 6,
      "default": 24,
      "label": "t:labels.search_results_per_page"
    },
    {
      "type": "select",
      "id": "search_scope",
      "label": "t:labels.search_scope",
      "options": [
        { "value": "all", "label": "t:options.search_scope.all" },
        { "value": "product", "label": "t:options.search_scope.product" }
      ],
      "default": "all",
      "info": "t:info.search_scope"
    },
    {
      "type": "header",
      "content": "t:sections.search.headers.grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.search.labels.desktop_columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.search.labels.image_ratio",
      "info": "t:sections.search.info.image_ratio",
      "options": [
        { "value": "1/1", "label": "t:sections.search.options.image_ratio.square" },
        { "value": "4/5", "label": "t:sections.search.options.image_ratio.tall" },
        { "value": "3/4", "label": "t:sections.search.options.image_ratio.portrait" },
        { "value": "2/3", "label": "t:sections.search.options.image_ratio.classic" },
        { "value": "4/3", "label": "t:sections.search.options.image_ratio.landscape" }
      ],
      "default": "3/4"
    },
    {
      "type": "header",
      "content": "t:sections.search.headers.card_options"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.search.labels.show_vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "t:sections.search.labels.show_secondary_image",
      "default": true
    }
  ]
}
{% endschema %}
