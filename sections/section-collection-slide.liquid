      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.collection_slide.labels.padding_left",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.collection_slide.headers.margin"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.collection_slide.labels.margin_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.collection_slide.labels.margin_bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.collection_slide.headers.background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.collection_slide.labels.background_color",
      "default": "rgba(0,0,0,0)",
