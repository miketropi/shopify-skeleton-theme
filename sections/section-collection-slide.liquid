            { "value": "left center", "label": "t:sections.collection_slide.options.image_position.left_center" },
            { "value": "right center", "label": "t:sections.collection_slide.options.image_position.right_center" }
          ]
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "t:sections.collection_slide.blocks.collection_card.labels.custom_url",
          "info": "t:sections.collection_slide.blocks.collection_card.info.custom_url"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "t:sections.collection_slide.presets.name",
      "blocks": [
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        }
      ]
    }
  ]
}
{% endschema %}
