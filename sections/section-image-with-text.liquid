{%- liquid
  assign iwt_scheme = settings.global_color_scheme
  if iwt_scheme == blank or iwt_scheme.settings == blank
    assign iwt_scheme = settings.color_schemes['scheme-6']
  endif

  assign iwtsm = section.settings.section_color_scheme_mode
  if iwtsm == 'custom'
    assign picked_iwt = section.settings.color_scheme
    if picked_iwt != blank and picked_iwt.settings != blank
      assign iwt_scheme = picked_iwt
    endif
  endif

  assign position = section.settings.content_position | default: 'left'

  assign ratio = section.settings.column_ratio | default: '50' | plus: 0
  assign text_fr = ratio
  assign image_fr = 100 | minus: text_fr

  assign rad_key = section.settings.image_border_radius | default: 'none'
  case rad_key
    when 'none'
      assign img_radius = 0
    when 'small'
      assign img_radius = 8
    when 'medium'
      assign img_radius = 16
    when 'large'
      assign img_radius = 24
  endcase

  assign height_key = section.settings.section_height | default: 'auto'
  assign height_css = 'auto'
  assign is_fixed_height = false
  case height_key
    when 'small'
      assign height_css = '400px'
      assign is_fixed_height = true
    when 'medium'
      assign height_css = '560px'
      assign is_fixed_height = true
    when 'large'
      assign height_css = '720px'
      assign is_fixed_height = true
  endcase

  assign pad_key = section.settings.content_padding | default: 'large'
  case pad_key
    when 'small'
      assign content_pad = 24
    when 'medium'
      assign content_pad = 40
    else
      assign content_pad = 60
  endcase

  assign show_btn = false
  if section.settings.show_button and section.settings.button_label != blank and section.settings.button_link != blank
    assign show_btn = true
  endif
-%}
{%- capture iwt_scheme_vars -%}
  {%- render 'color-scheme-vars', scheme: iwt_scheme, inline_only: true -%}
{%- endcapture -%}

{%- render 'section-styles', section: section -%}

{% style %}
  html.js #shopify-section-{{ section.id }} .section-image-with-text:not(.section-image-with-text--revealed) .section-image-with-text__image-col,
  html.js #shopify-section-{{ section.id }} .section-image-with-text:not(.section-image-with-text--revealed) .section-image-with-text__content-col {
    opacity: 0;
  }
{% endstyle %}

<div
  class="section-{{ section.id }} section-image-with-text section-image-with-text--position-{{ position }} section-image-with-text--valign-{{ section.settings.content_vertical_alignment | default: 'middle' }} section-intro--heading-{{ section.settings.heading_size | default: 'large' }}{% if is_fixed_height %} section-image-with-text--fixed-height{% endif %}{% if section.settings.mobile_image != blank %} section-image-with-text--has-mobile{% endif %}{% if section.settings.entrance_animation %} section-image-with-text--animate{% endif %}{% if section.settings.full_width %} full-width{% endif %} shopify-section-wrapper"
  data-section-type="section-image-with-text"
  data-section-id="{{ section.id }}"
  data-image-with-text-entrance-scroll="{% if section.settings.entrance_animation %}true{% else %}false{% endif %}"
  style="
    {{ iwt_scheme_vars }}
    --iwt-text-fr: {{ text_fr }};
    --iwt-image-fr: {{ image_fr }};
    --iwt-img-radius: {{ img_radius }}px;
    --iwt-height: {{ height_css }};
    --iwt-content-pad: {{ content_pad }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="section-image-with-text__inner{% if section.settings.full_width %} section-content-width{% endif %}">
    <div class="section-image-with-text__row">
      <div class="section-image-with-text__image-col">
        {%- if section.settings.image != blank -%}
          {%- assign img_pos = section.settings.image_position | default: 'center center' -%}
          {%- assign img_style = 'object-position: ' | append: img_pos | append: ';' -%}
          {%- assign img_alt = section.settings.image.alt | default: '' | escape -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              loading: 'eager',
              class: 'section-image-with-text__image',
              widths: '600,800,1200,1500',
              sizes: '(min-width: 62em) 50vw, 100vw',
              alt: img_alt,
              style: img_style
          }}
          {%- if section.settings.mobile_image != blank -%}
            {%- assign mob_alt = section.settings.mobile_image.alt | default: '' | escape -%}
            {%- assign mob_style = 'object-position: ' | append: img_pos | append: ';' -%}
            {{
              section.settings.mobile_image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                class: 'section-image-with-text__image section-image-with-text__image--mobile',
                widths: '400,600,800',
                sizes: '100vw',
                alt: mob_alt,
                style: mob_style
            }}
          {%- endif -%}
        {%- else -%}
          <div class="section-image-with-text__image-placeholder" aria-hidden="true">
            {{ 'collection-1' | placeholder_svg_tag: 'section-image-with-text__placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <div
        class="section-image-with-text__content-col"
        style="--cs-background: {{ section.settings.content_background_color | default: '#F5F0EB' }};"
      >
        <div class="section-image-with-text__content">
          {%- if section.settings.eyebrow_text != blank -%}
            <p
              class="section-intro__eyebrow"
              {% if section.settings.eyebrow_color != blank -%}
                style="color: {{ section.settings.eyebrow_color }};"
              {%- endif %}
            >
              {{- section.settings.eyebrow_text | escape -}}
            </p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2
              class="section-intro__heading"
              {% if section.settings.heading_color != blank -%}
                style="color: {{ section.settings.heading_color }};"
              {%- endif %}
            >
              {{- section.settings.heading | escape -}}
            </h2>
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            <div
              class="section-image-with-text__description rte"
              {% if section.settings.description_color != blank -%}
                style="color: {{ section.settings.description_color }};"
              {%- endif %}
            >
              {{ section.settings.description }}
            </div>
          {%- endif -%}

          {%- if show_btn -%}
            <div class="section-image-with-text__button-row">
              <a
                href="{{ section.settings.button_link }}"
                class="section-image-with-text__btn section-image-with-text__btn--{{ section.settings.button_style | default: 'outlined' }}"
                {% if section.settings.open_new_tab %}
                  target="_blank"
                  rel="noopener noreferrer"
                {% endif %}
              >
                {{- section.settings.button_label | escape -}}
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

