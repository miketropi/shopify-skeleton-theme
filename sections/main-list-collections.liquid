{% comment %}
  All-collections template section. Shared markup lives in `snippets/mclst-list-inner.liquid`.
{% endcomment %}

{% render 'mclst-list-inner', section: section %}

{% schema %}
{
  "name": "t:sections.list_collections.name",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["list-collections"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.list_collections.headers.layout"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:sections.list_collections.labels.description"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.list_collections.labels.desktop_columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.list_collections.labels.image_ratio",
      "options": [
        { "value": "1/1", "label": "t:sections.list_collections.options.image_ratio.square" },
        { "value": "4/5", "label": "t:sections.list_collections.options.image_ratio.tall" },
        { "value": "3/4", "label": "t:sections.list_collections.options.image_ratio.portrait" },
        { "value": "2/3", "label": "t:sections.list_collections.options.image_ratio.classic" },
        { "value": "4/3", "label": "t:sections.list_collections.options.image_ratio.landscape" }
      ],
      "default": "1/1"
    },
    {
      "type": "header",
      "content": "t:sections.list_collections.headers.card_options"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.list_collections.labels.show_count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.list_collections.labels.show_description",
      "default": false
    }
  ]
}
{% endschema %}
