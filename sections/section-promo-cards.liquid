{%- liquid
  assign cs_scheme = settings.global_color_scheme
  if cs_scheme == blank or cs_scheme.settings == blank
    assign cs_scheme = settings.color_schemes['scheme-6']
  endif

  assign cssm = section.settings.section_color_scheme_mode
  if cssm == 'custom'
    assign picked_cs = section.settings.color_scheme
    if picked_cs != blank and picked_cs.settings != blank
      assign cs_scheme = picked_cs
    endif
  elsif cssm == 'default'
  else
    assign picked_cs = section.settings.color_scheme
    if picked_cs != blank and picked_cs.settings != blank 
      assign cs_scheme = picked_cs
    endif
  endif

  assign layout = section.settings.layout | default: 'grid'
  assign is_carousel = false
  if layout == 'carousel'
    assign is_carousel = true
  endif

  assign cols = section.settings.columns | default: '3' | plus: 0
  assign cols_tab = cols
  if cols_tab > 2
    assign cols_tab = 2
  endif

  assign gap_key = section.settings.card_gap | default: 'medium'
  assign gap_px = 20
  case gap_key
    when 'none'
      assign gap_px = 0
    when 'small'
      assign gap_px = 12
    when 'large'
      assign gap_px = 32
  endcase

  assign rad_key = section.settings.card_border_radius | default: 'medium'
  case rad_key
    when 'none'
      assign rad_px = 0
    when 'small'
      assign rad_px = 8
    when 'large'
      assign rad_px = 24
    else
      assign rad_px = 16
  endcase

  assign card_count = 0
  for block in section.blocks
    if block.type == 'promo_card'
      assign card_count = card_count | plus: 1
    endif
  endfor

  assign show_arrows = false
  if is_carousel and section.settings.show_navigation_arrows and card_count > 1
    assign show_arrows = true
  endif

  assign media_aspect_key = section.settings.media_aspect_ratio | default: 'auto'
  assign media_aspect_css = ''
  case media_aspect_key
    when 'square'
      assign media_aspect_css = '1 / 1'
    when 'portrait'
      assign media_aspect_css = '3 / 4'
    when 'landscape'
      assign media_aspect_css = '4 / 3'
    when 'wide'
      assign media_aspect_css = '16 / 9'
  endcase

  assign media_size_key = section.settings.media_size | default: 'medium'
  assign media_img_width = 1200
  assign media_img_widths = '300,450,600,800,1200'
  assign media_video_image_size = '1200x'
  case media_size_key
    when 'small'
      assign media_img_width = 600
      assign media_img_widths = '300,450,600'
      assign media_video_image_size = '600x'
    when 'large'
      assign media_img_width = 1600
      assign media_img_widths = '400,600,800,1200,1600'
      assign media_video_image_size = '1600x'
    when 'xlarge'
      assign media_img_width = 2400
      assign media_img_widths = '600,800,1200,1600,2400'
      assign media_video_image_size = '2400x'
  endcase
-%}
{%- capture cs_scheme_vars -%}
  {%- render 'color-scheme-vars', scheme: cs_scheme, inline_only: true -%}
{%- endcapture -%}

{%- render 'section-styles', section: section -%}

{% style %}
  html.js #shopify-section-{{ section.id }} .promo-cards:not(.promo-cards--revealed) .promo-cards__slide-target {
    opacity: 0;
  }
{% endstyle %}

<div
  class="section-{{ section.id }} promo-cards shopify-section-wrapper product-slider--heading-{{ section.settings.card_heading_size | default: 'large' }} promo-cards--layout-{{ layout }}{% if section.settings.full_width %} full-width promo-cards--full-width{% endif %}{% if media_aspect_css != blank %} promo-cards--media-aspect{% endif %}"
  data-section-type="section-promo-cards"
  data-section-id="{{ section.id }}"
  data-promo-cards-layout="{{ layout }}"
  data-promo-cards-gap="{{ gap_px }}"
  data-promo-cards-gap-mobile="{% if gap_key == 'none' %}0{% else %}12{% endif %}"
  data-promo-cards-columns="{{ cols }}"
  data-promo-cards-columns-tablet="{{ cols_tab }}"
  data-promo-cards-show-arrows="{% if show_arrows %}true{% else %}false{% endif %}"
  data-promo-cards-entrance-scroll="{% if section.settings.entrance_animate_on_scroll == false %}false{% else %}true{% endif %}"
  style="
    {{ cs_scheme_vars }}
    --promo-cards-gap: {{ gap_px }}px;
    --promo-cards-gap-mobile: 12px;
    --promo-cols-mobile: 1;
    --promo-cols-tablet: {{ cols_tab }};
    --promo-cols-desktop: {{ cols }};
    --promo-card-radius: {{ rad_px }}px;
    {% if media_aspect_css != blank %}--promo-media-aspect: {{ media_aspect_css }};{% endif %}
  "
  {{ section.shopify_attributes }}
>
  <div class="promo-cards__inner{% if section.settings.full_width %} section-content-width{% endif %}">
    {%- if card_count == 0 -%}
      <p class="promo-cards__empty">{{ 'sections.promo_cards.empty_state' | t }}</p>
    {%- elsif is_carousel -%}
      <div
        class="promo-cards__viewport"
        role="region"
        aria-roledescription="{{ 'sections.promo_cards.carousel' | t }}"
        aria-label="{{ 'sections.promo_cards.region_label' | t }}"
        tabindex="-1"
      >
        <div class="promo-cards__loading" data-promo-cards-loading aria-hidden="true">
          <span class="promo-cards__loading-inner">
            <span class="promo-cards__loading-dot"></span>
            <span class="promo-cards__loading-dot"></span>
            <span class="promo-cards__loading-dot"></span>
          </span>
        </div>

        {%- if show_arrows -%}
          <button
            type="button"
            class="promo-cards__nav-btn promo-cards__nav-btn--prev swiper-button-prev"
            data-promo-cards-prev
            aria-label="{{ 'sections.promo_cards.prev' | t }}"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          </button>
        {%- endif -%}

        <div class="promo-cards__swiper-clip">
          <div
            class="promo-cards__swiper swiper"
            data-promo-cards-swiper
            tabindex="0"
            aria-live="polite"
          >
            <ul class="swiper-wrapper promo-cards__track" role="list">
              {%- render 'promo-cards-block-items',
                section: section,
                card_radius_px: rad_px,
                media_aspect_css: media_aspect_css,
                media_img_width: media_img_width,
                media_img_widths: media_img_widths,
                media_video_image_size: media_video_image_size,
                item_tag: 'li',
                item_class: 'swiper-slide promo-cards__slide-target'
              -%}
            </ul>
          </div>
        </div>

        {%- if show_arrows -%}
          <button
            type="button"
            class="promo-cards__nav-btn promo-cards__nav-btn--next swiper-button-next"
            data-promo-cards-next
            aria-label="{{ 'sections.promo_cards.next' | t }}"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="promo-cards__grid" role="list">
        {%- render 'promo-cards-block-items',
          section: section,
          card_radius_px: rad_px,
          media_aspect_css: media_aspect_css,
          media_img_width: media_img_width,
          media_img_widths: media_img_widths,
          media_video_image_size: media_video_image_size,
          item_tag: 'div',
          item_class: 'promo-cards__cell promo-cards__slide-target',
          item_role: 'listitem'
        -%}
      </div>
    {%- endif -%}
  </div>
</div>

