{%- liquid
  assign sticky_header = section.settings.sticky_header | default: 'scroll-up'
  if sticky_header == 'scroll_up'
    assign sticky_header = 'scroll-up'
  endif

  assign desktop_header_layout = section.settings.desktop_header_layout | default: 'logo_nav_actions'
  assign layout_modifier = desktop_header_layout | replace: '_', '-'

  assign header_color_src = section.settings.color_scheme_source | default: 'custom'
  if header_color_src == 'global'
    assign scheme_default = settings.global_color_scheme
  else
    assign scheme_default = section.settings.color_scheme
  endif
  if scheme_default == blank or scheme_default.settings == blank
    assign scheme_default = settings.global_color_scheme
  endif
  if scheme_default == blank or scheme_default.settings == blank
    assign scheme_default = settings.color_schemes['scheme-6']
  endif

  if header_color_src == 'global'
    assign scheme_transparent = settings.global_color_scheme
  else
    assign scheme_transparent = section.settings.color_scheme_transparent
  endif
  if scheme_transparent == blank or scheme_transparent.settings == blank
    assign scheme_transparent = scheme_default
  endif
  if scheme_transparent == blank or scheme_transparent.settings == blank
    assign scheme_transparent = settings.color_schemes['scheme-6']
  endif

  assign header_menu = section.settings.menu
  if header_menu == blank
    assign header_menu = linklists['main-menu']
  endif
-%}
{%- capture header_scheme_solid -%}
  {%- render 'color-scheme-vars', scheme: scheme_default, prefix: 'solid', inline_only: true -%}
{%- endcapture -%}
{%- capture header_scheme_transparent -%}
  {%- render 'color-scheme-vars', scheme: scheme_transparent, prefix: 'transparent', inline_only: true -%}
{%- endcapture -%}
<header
  class="site-header site-header--layout-{{ layout_modifier }}"
  data-section-type="header"
  data-section-id="{{ section.id }}"
  data-sticky="{{ sticky_header | escape }}"
  data-scheme-default="{{ scheme_default.id }}"
  data-scheme-transparent="{{ scheme_transparent.id }}"
  style="
    --logo-width: {{ section.settings.logo_width }}px;
    --logo-mobile-width: {{ section.settings.logo_mobile_width }}px;
    {{ header_scheme_solid }}
    {{ header_scheme_transparent }}
  "
  {{ section.shopify_attributes }}
>
  <div class="site-header__inner site-header__inner--layout-{{ layout_modifier }}">
    <button
      type="button"
      class="header__menu-toggle"
      data-header-menu-toggle
      aria-expanded="false"
      aria-controls="HeaderNav-{{ section.id }}"
    >
      <span class="visually-hidden">{{ 'header.menu_toggle' | t }}</span>
      <span class="header__burger" aria-hidden="true">
        <span class="header__burger-line"></span>
        <span class="header__burger-line"></span>
        <span class="header__burger-line"></span>
      </span>
    </button>

    {%- case desktop_header_layout -%}
      {%- when 'logo_nav_center_actions' -%}
        <div class="header__heading">
          {% render 'header-logo', section: section %}
        </div>
        {% render 'header-site-nav', section: section, menu: header_menu %}
        {% render 'header-icons', section: section %}

      {%- when 'nav_logo_center_actions' -%}
        {% render 'header-site-nav', section: section, menu: header_menu %}
        <div class="header__heading">
          {% render 'header-logo', section: section %}
        </div>
        {% render 'header-icons', section: section %}

      {%- when 'two_row' -%}
        <div class="header__heading">
          {% render 'header-logo', section: section %}
        </div>
        {% render 'header-site-nav', section: section, menu: header_menu %}
        {% render 'header-icons', section: section %}

      {%- else -%}
        <div class="header__heading">
          {% render 'header-logo', section: section %}
        </div>
        <div class="header__nav-tray">
          {% render 'header-site-nav', section: section, menu: header_menu %}
          {% render 'header-icons', section: section %}
        </div>
    {%- endcase -%}
  </div>

  <div
    class="header__backdrop"
    data-header-backdrop
    inert
    aria-hidden="true"
  ></div>
</header>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "header",
      "content": "t:headers.colour"
    },
    {
      "type": "select",
      "id": "color_scheme_source",
      "label": "t:labels.section_color_scheme_source",
      "info": "t:info.section_color_scheme_source",
      "default": "global",
      "options": [
        { "value": "global", "label": "t:options.section_color_scheme_source.global" },
        { "value": "custom", "label": "t:options.section_color_scheme_source.custom" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.header_color_scheme",
      "info": "t:info.header_color_scheme_solid",
      "default": "scheme-6",
      "visible_if": "{{ section.settings.color_scheme_source == 'custom' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_transparent",
      "label": "t:labels.header_color_scheme_transparent",
      "info": "t:info.header_color_scheme_transparent",
      "default": "scheme-6",
      "visible_if": "{{ section.settings.color_scheme_source == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:headers.logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "image_picker",
      "id": "logo_retina",
      "label": "t:labels.logo_retina",
      "info": "t:info.logo_retina"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 40,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "t:labels.logo_width",
      "info": "t:info.logo_width_retina",
      "default": 120
    },
    {
      "type": "header",
      "content": "t:headers.mobile_logo"
    },
    {
      "type": "image_picker",
      "id": "logo_mobile",
      "label": "t:labels.logo_mobile",
      "info": "t:info.logo_mobile"
    },
    {
      "type": "image_picker",
      "id": "logo_mobile_retina",
      "label": "t:labels.logo_mobile_retina",
      "info": "t:info.logo_mobile_retina"
    },
    {
      "type": "range",
      "id": "logo_mobile_width",
      "min": 24,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:labels.logo_mobile_width",
      "info": "t:info.logo_mobile_width",
      "default": 80
    },
    {
      "type": "header",
      "content": "t:headers.header_layout"
    },
    {
      "type": "select",
      "id": "desktop_header_layout",
      "label": "t:labels.desktop_header_layout",
      "info": "t:info.desktop_header_layout",
      "default": "logo_nav_actions",
      "options": [
        { "value": "logo_nav_actions", "label": "t:options.desktop_header_layout.logo_nav_actions" },
        { "value": "logo_nav_center_actions", "label": "t:options.desktop_header_layout.logo_nav_center_actions" },
        { "value": "nav_logo_center_actions", "label": "t:options.desktop_header_layout.nav_logo_center_actions" },
        { "value": "two_row", "label": "t:options.desktop_header_layout.two_row" }
      ]
    },
    {
      "type": "select",
      "id": "sticky_header",
      "label": "t:labels.sticky_header",
      "info": "t:info.sticky_header",
      "default": "scroll-up",
      "options": [
        { "value": "none", "label": "t:options.sticky_header.none" },
        { "value": "always", "label": "t:options.sticky_header.always" },
        { "value": "scroll-up", "label": "t:options.sticky_header.scroll_up" }
      ]
    },
    {
      "type": "header",
      "content": "t:headers.navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu",
      "info": "t:info.header_menu_nested"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "paragraph",
      "content": "t:sections.header.drawer_utilities_order_note"
    }
  ],
  "blocks": [
    {
      "type": "drawer_richtext",
      "name": "t:sections.header.drawer_block_richtext",
      "settings": [
        {
          "type": "select",
          "id": "drawer_slot",
          "label": "t:sections.header.drawer_slot",
          "info": "t:sections.header.drawer_slot_info",
          "options": [
            { "value": "primary", "label": "t:sections.header.drawer_slot_primary" },
            { "value": "actions", "label": "t:sections.header.drawer_slot_actions" },
            { "value": "footer", "label": "t:sections.header.drawer_slot_footer" }
          ],
          "default": "primary"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.header.drawer_heading",
          "info": "t:sections.header.drawer_heading_info"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "t:sections.header.drawer_richtext_body"
        }
      ]
    },
    {
      "type": "drawer_social",
      "name": "t:sections.header.drawer_block_social",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.header.drawer_heading",
          "info": "t:sections.header.drawer_social_heading_info",
          "default": "Follow us"
        }
      ]
    },
    {
      "type": "drawer_localization",
      "name": "t:sections.header.drawer_block_localization",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.header.drawer_localization_info"
        },
        {
          "type": "checkbox",
          "id": "show_currency",
          "label": "t:sections.header_top_bar.localization_show_currency",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_language",
          "label": "t:sections.header_top_bar.localization_show_language",
          "default": true
        },
        {
          "type": "text",
          "id": "currency_heading",
          "label": "t:sections.header_top_bar.localization_currency_heading_setting",
          "info": "t:sections.header.drawer_localization_field_sr_heading_info",
          "default": "Country"
        },
        {
          "type": "text",
          "id": "language_heading",
          "label": "t:sections.header_top_bar.localization_language_heading_setting",
          "info": "t:sections.header.drawer_localization_field_sr_heading_info",
          "default": "Language"
        }
      ]
    },
    {
      "type": "drawer_account",
      "name": "t:sections.header.drawer_block_account",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.header.drawer_account_info"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.header.drawer_heading",
          "info": "t:sections.header.drawer_heading_info"
        },
        {
          "type": "text",
          "id": "signed_out_button_label",
          "label": "t:sections.header.drawer_account_signed_out_button_label",
          "info": "t:sections.header.drawer_account_signed_out_button_info",
          "default": "Log in"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.header",
      "blocks": [
        {
          "type": "drawer_social"
        },
        {
          "type": "drawer_localization"
        },
        {
          "type": "drawer_account"
        }
      ]
    }
  ]
}
{% endschema %}
