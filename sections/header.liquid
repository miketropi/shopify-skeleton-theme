{%- liquid
  assign sticky_header = section.settings.sticky_header | default: 'scroll-up'
  if sticky_header == 'scroll_up'
    assign sticky_header = 'scroll-up'
  endif

  assign scheme_default = section.settings.color_scheme
  if scheme_default == blank or scheme_default.settings == blank
    assign scheme_default = settings.global_color_scheme
  endif
  if scheme_default == blank or scheme_default.settings == blank
    assign scheme_default = settings.color_schemes['scheme-1']
  endif

  assign scheme_transparent = section.settings.color_scheme_transparent
  if scheme_transparent == blank or scheme_transparent.settings == blank
    assign scheme_transparent = scheme_default
  endif
-%}
{%- capture header_scheme_solid -%}
  {%- render 'color-scheme-vars', scheme: scheme_default, prefix: 'solid', inline_only: true -%}
{%- endcapture -%}
{%- capture header_scheme_transparent -%}
  {%- render 'color-scheme-vars', scheme: scheme_transparent, prefix: 'transparent', inline_only: true -%}
{%- endcapture -%}
<header
  class="site-header"
  data-section-type="header"
  data-section-id="{{ section.id }}"
  data-sticky="{{ sticky_header | escape }}"
  data-scheme-default="{{ scheme_default.id }}"
  data-scheme-transparent="{{ scheme_transparent.id }}"
  style="
    --logo-width: {{ section.settings.logo_width }}px;
    --logo-mobile-width: {{ section.settings.logo_mobile_width }}px;
    {{ header_scheme_solid }}
    {{ header_scheme_transparent }}
  "
  {{ section.shopify_attributes }}
>
  <div class="site-header__inner">
    <button
      type="button"
      class="header__menu-toggle"
      data-header-menu-toggle
      aria-expanded="false"
      aria-controls="HeaderNav-{{ section.id }}"
    >
      <span class="visually-hidden">{{ 'header.menu_toggle' | t }}</span>
      <span class="header__burger" aria-hidden="true">
        <span class="header__burger-line"></span>
        <span class="header__burger-line"></span>
        <span class="header__burger-line"></span>
      </span>
    </button>

    <div class="header__heading">
      {% render 'header-logo', section: section %}
    </div>

    <nav
      class="header__nav"
      id="HeaderNav-{{ section.id }}"
      data-header-nav
      aria-label="{{ 'header.navigation' | t }}"
    >
      <div class="header__offcanvas-head">
        <div class="header__offcanvas-head-main">
          <p
            class="header__offcanvas-brand{% if section.settings.logo != blank or section.settings.logo_mobile != blank %} header__offcanvas-brand--logo{% endif %}"
            id="HeaderOffcanvasTitle-{{ section.id }}"
          >
            {% render 'header-logo', section: section, variant: 'drawer' %}
          </p>
        </div>
        <button
          type="button"
          class="header__offcanvas-close"
          data-header-menu-close
          aria-label="{{ 'header.menu_close' | t }}"
        >
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="header__offcanvas-body">
        <ul class="header__menu" role="list">
          {% for link in section.settings.menu.links %}
            <li
              class="header__menu-item{% if link.links != blank %} header__menu-item--has-children{% endif %}"
            >
              {% if link.links != blank %}
                {% assign top_index = forloop.index %}
                <div class="header__menu-row">
                  <a class="header__menu-link header__menu-link--parent" href="{{ link.url }}">
                    {{- link.title | escape -}}
                  </a>
                  <button
                    type="button"
                    class="header__submenu-toggle"
                    data-header-submenu-toggle
                    aria-expanded="false"
                    aria-controls="HeaderSub-{{ section.id }}-{{ top_index }}"
                    aria-label="{{ 'header.submenu_toggle' | t: title: link.title | escape }}"
                  >
                    <span class="header__chevron" aria-hidden="true"></span>
                  </button>
                </div>
                <ul
                  class="header__submenu"
                  id="HeaderSub-{{ section.id }}-{{ top_index }}"
                  role="list"
                  hidden
                >
                  {% for child in link.links %}
                    <li
                      class="header__submenu-item{% if child.links != blank %} header__submenu-item--has-children{% endif %}"
                    >
                      {% if child.links != blank %}
                        <div class="header__submenu-row">
                          <a class="header__submenu-link header__submenu-link--parent" href="{{ child.url }}">
                            {{- child.title | escape -}}
                          </a>
                          <button
                            type="button"
                            class="header__submenu-toggle"
                            data-header-submenu-toggle
                            aria-expanded="false"
                            aria-controls="HeaderSub2-{{ section.id }}-{{ top_index }}-{{ forloop.index }}"
                            aria-label="{{ 'header.submenu_toggle' | t: title: child.title | escape }}"
                          >
                            <span class="header__chevron" aria-hidden="true"></span>
                          </button>
                        </div>
                        <ul
                          class="header__submenu-nested"
                          id="HeaderSub2-{{ section.id }}-{{ top_index }}-{{ forloop.index }}"
                          role="list"
                          hidden
                        >
                          {% for grandchild in child.links %}
                            <li class="header__submenu-item">
                              <a class="header__submenu-link header__submenu-link--deep" href="{{ grandchild.url }}">
                                {{- grandchild.title | escape -}}
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      {% else %}
                        <a class="header__submenu-link" href="{{ child.url }}">{{ child.title | escape }}</a>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              {% else %}
                <a class="header__menu-link" href="{{ link.url }}">{{ link.title | escape }}</a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </div>
    </nav>

    <div class="header__icons">
      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      <a
        href="{{ routes.cart_url }}"
        class="header__cart-link"
        data-cart-drawer-open
        aria-haspopup="dialog"
        aria-controls="CartDrawerPanel"
        aria-expanded="false"
        aria-label="{{ 'cart.drawer.toggle_cart' | t }}"
      >
        <sup data-header-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>
          {{- cart.item_count -}}
        </sup>

        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>
    </div>
  </div>

  <div
    class="header__backdrop"
    data-header-backdrop
    inert
    aria-hidden="true"
  ></div>
</header>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "header",
      "content": "t:headers.colour"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.header_color_scheme",
      "info": "t:info.header_color_scheme_solid",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_transparent",
      "label": "t:labels.header_color_scheme_transparent",
      "info": "t:info.header_color_scheme_transparent",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:headers.logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "image_picker",
      "id": "logo_retina",
      "label": "t:labels.logo_retina",
      "info": "t:info.logo_retina"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 40,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "t:labels.logo_width",
      "info": "t:info.logo_width_retina",
      "default": 120
    },
    {
      "type": "header",
      "content": "t:headers.mobile_logo"
    },
    {
      "type": "image_picker",
      "id": "logo_mobile",
      "label": "t:labels.logo_mobile",
      "info": "t:info.logo_mobile"
    },
    {
      "type": "image_picker",
      "id": "logo_mobile_retina",
      "label": "t:labels.logo_mobile_retina",
      "info": "t:info.logo_mobile_retina"
    },
    {
      "type": "range",
      "id": "logo_mobile_width",
      "min": 24,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:labels.logo_mobile_width",
      "info": "t:info.logo_mobile_width",
      "default": 80
    },
    {
      "type": "header",
      "content": "t:headers.header_layout"
    },
    {
      "type": "select",
      "id": "sticky_header",
      "label": "t:labels.sticky_header",
      "info": "t:info.sticky_header",
      "default": "scroll-up",
      "options": [
        { "value": "none", "label": "t:options.sticky_header.none" },
        { "value": "always", "label": "t:options.sticky_header.always" },
        { "value": "scroll-up", "label": "t:options.sticky_header.scroll_up" }
      ]
    },
    {
      "type": "header",
      "content": "t:headers.navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "info": "t:info.header_menu_nested"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
