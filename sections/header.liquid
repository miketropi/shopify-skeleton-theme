<header
  class="site-header"
  {% render 'color-scheme-vars' %}
>
  <h2 class="header__title">
    {{ shop.name | link_to: routes.root_url }}
  </h2>

  <div class="header__menu">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </div>

  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a
      href="{{ routes.cart_url }}"
      class="header__cart-link"
      data-cart-drawer-open
      aria-haspopup="dialog"
      aria-controls="CartDrawerPanel"
      aria-expanded="false"
      aria-label="{{ 'cart.drawer.toggle_cart' | t }}"
    >
      <sup data-header-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>
        {{- cart.item_count -}}
      </sup>

      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

{% stylesheet %}
  .site-header {
    min-height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    background-color: var(--cs-background);
    color: var(--cs-text);
    border-bottom: 1px solid var(--cs-border);
    padding-block: 0.75rem;
  }
  .site-header a {
    position: relative;
    text-decoration: none;
    color: var(--cs-text);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .site-header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }
  .site-header svg {
    width: 2rem;
  }
  .site-header .header__menu,
  .site-header .header__icons {
    display: flex;
    gap: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
