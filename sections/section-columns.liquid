{%- comment -%}
  sections/section-columns.liquid
  ────────────────────────────────────────────────────────────────────────────
  Multi-column layout section. Each block = one column (max 4). Supports 2–4
  columns, configurable gap, optional dividers, and CSS-only sticky scroll
  (shorter columns stick while tallest scrolls). No JS required.
  ────────────────────────────────────────────────────────────────────────────
{%- endcomment -%}

{%- liquid
  assign cs_scheme = settings.global_color_scheme
  if cs_scheme == blank or cs_scheme.settings == blank
    assign cs_scheme = settings.color_schemes['scheme-6']
  endif

  assign cssm = section.settings.section_color_scheme_mode
  if cssm == 'custom'
    assign picked_cs = section.settings.color_scheme
    if picked_cs != blank and picked_cs.settings != blank
      assign cs_scheme = picked_cs
    endif
  elsif cssm == 'default'
  else
    assign picked_cs = section.settings.color_scheme
    if picked_cs != blank and picked_cs.settings != blank
      assign cs_scheme = picked_cs
    endif
  endif

  assign cols = section.settings.columns | default: '3' | plus: 0
  assign cols_tab = cols
  if cols_tab > 2
    assign cols_tab = 2
  endif

  assign column_gap_key = section.settings.column_gap | default: 'medium'
  assign column_gap_px = 32
  case column_gap_key
    when 'none'
      assign column_gap_px = 0
    when 'small'
      assign column_gap_px = 16
    when 'large'
      assign column_gap_px = 48
  endcase

  assign row_gap_key = section.settings.row_gap | default: 'medium'
  assign row_gap_px = 32
  case row_gap_key
    when 'none'
      assign row_gap_px = 0
    when 'small'
      assign row_gap_px = 16
    when 'large'
      assign row_gap_px = 48
  endcase

  assign enable_sticky = section.settings.enable_sticky_scroll | default: false
  assign sticky_offset = section.settings.sticky_offset_top | default: 80
  assign vertical_alignment = section.settings.vertical_alignment | default: 'top'
  assign show_dividers = section.settings.show_dividers | default: false
  assign divider_color = section.settings.divider_color

  assign block_count = section.blocks.size
-%}

{%- capture cs_scheme_vars -%}
  {%- render 'color-scheme-vars', scheme: cs_scheme, inline_only: true -%}
{%- endcapture -%}

{%- render 'section-styles', section: section -%}

<div
  class="section-{{ section.id }} columns shopify-section-wrapper columns--cols-{{ cols }} columns--gap-{{ column_gap_key }} columns--row-gap-{{ row_gap_key }} columns--valign-{{ vertical_alignment }}{% if show_dividers %} columns--dividers{% endif %}{% if enable_sticky %} columns--sticky{% endif %}{% if section.settings.full_width %} full-width columns--full-width{% endif %}"
  data-section-id="{{ section.id }}"
  style="
    {{ cs_scheme_vars }}
    --columns-cols: {{ cols }};
    --columns-cols-tablet: {{ cols_tab }};
    --columns-gap: {{ column_gap_px }}px;
    --columns-row-gap: {{ row_gap_px }}px;
    --columns-sticky-offset: {{ sticky_offset }}px;
    {%- if divider_color != blank and divider_color != 'rgba(0,0,0,0)' and divider_color != 'rgba(0, 0, 0, 0)' -%}
      --columns-divider-color: {{ divider_color }};
    {%- endif -%}
  "
  {{ section.shopify_attributes }}
>
  <div class="columns__inner{% if section.settings.full_width %} section-content-width{% endif %}">
    {%- if block_count == 0 -%}
      <p class="columns__empty">{{ 'sections.columns.empty_state' | t }}</p>
    {%- else -%}
      <div class="columns__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign col_width = block.settings.column_width | default: 'auto'
            assign content_align = block.settings.content_alignment | default: 'left'
            assign col_bg = block.settings.column_background_color
            assign col_padding_key = block.settings.column_padding | default: 'none'
            assign col_radius_key = block.settings.column_border_radius | default: 'none'

            assign col_padding_px = 0
            case col_padding_key
              when 'small'
                assign col_padding_px = 16
              when 'medium'
                assign col_padding_px = 24
              when 'large'
                assign col_padding_px = 40
            endcase

            assign col_radius_px = 0
            case col_radius_key
              when 'small'
                assign col_radius_px = 8
              when 'medium'
                assign col_radius_px = 16
              when 'large'
                assign col_radius_px = 24
            endcase

            assign show_img = block.settings.show_image | default: false
            assign img_ratio_key = block.settings.image_ratio | default: 'auto'
            assign img_radius_key = block.settings.image_border_radius | default: 'none'

            assign img_radius_px = 0
            case img_radius_key
              when 'small'
                assign img_radius_px = 8
              when 'medium'
                assign img_radius_px = 16
              when 'large'
                assign img_radius_px = 24
            endcase

            assign heading_size = block.settings.heading_size | default: 'medium'
            assign heading_color = block.settings.heading_color
            assign desc_color = block.settings.description_color

            assign show_btn = block.settings.show_button | default: false
            assign btn_style = block.settings.button_style | default: 'filled'
            assign btn_label = block.settings.button_label
            assign btn_link = block.settings.button_link
            assign btn_new_tab = block.settings.open_new_tab | default: false
          -%}

          <div
            class="columns__item columns__item--width-{{ col_width }} columns__item--align-{{ content_align }} columns__item--padding-{{ col_padding_key }} columns__item--radius-{{ col_radius_key }} columns__item--heading-{{ heading_size }}"
            role="listitem"
            {{ block.shopify_attributes }}
            style="
              {%- if col_bg != blank and col_bg != 'rgba(0,0,0,0)' and col_bg != 'rgba(0, 0, 0, 0)' -%}
                --columns-item-bg: {{ col_bg }};
              {%- endif -%}
              --columns-item-padding: {{ col_padding_px }}px;
              --columns-item-radius: {{ col_radius_px }}px;
              --columns-img-radius: {{ img_radius_px }}px;
              {%- if heading_color != blank and heading_color != 'rgba(0,0,0,0)' and heading_color != 'rgba(0, 0, 0, 0)' -%}
                --columns-heading-color: {{ heading_color }};
              {%- endif -%}
              {%- if desc_color != blank and desc_color != 'rgba(0,0,0,0)' and desc_color != 'rgba(0, 0, 0, 0)' -%}
                --columns-desc-color: {{ desc_color }};
              {%- endif -%}
            "
          >
            {%- if show_img and block.settings.image != blank -%}
              <div class="columns__image-wrap columns__image-wrap--ratio-{{ img_ratio_key }}">
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    alt: block.settings.image.alt | default: block.settings.heading | default: '',
                    class: 'columns__image',
                    widths: '400,600,800,1200',
                    sizes: '(min-width: 62em) 33vw, (min-width: 48em) 50vw, 100vw'
                }}
              </div>
            {%- endif -%}

            {%- if block.settings.eyebrow_text != blank -%}
              <p class="columns__eyebrow">{{ block.settings.eyebrow_text | escape }}</p>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h3 class="columns__heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <div class="columns__description">
                {{ block.settings.description }}
              </div>
            {%- endif -%}

            {%- if show_btn and btn_label != blank and btn_link != blank -%}
              <div class="columns__action">
                <a
                  href="{{ btn_link }}"
                  class="columns__btn columns__btn--{{ btn_style }}"
                  {% if btn_new_tab %}
                    target="_blank"
                    rel="noopener noreferrer"
                  {% endif %}
                >
                  {{ btn_label | escape }}
                </a>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.columns.name",
  "tag": "section",
  "class": "section-columns",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.columns.headers.layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.columns.labels.columns",
      "default": "3",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    {
      "type": "select",
      "id": "column_gap",
      "label": "t:sections.columns.labels.column_gap",
      "default": "medium",
      "options": [
        { "value": "none", "label": "t:sections.columns.options.gap.none" },
        { "value": "small", "label": "t:sections.columns.options.gap.small" },
        { "value": "medium", "label": "t:sections.columns.options.gap.medium" },
        { "value": "large", "label": "t:sections.columns.options.gap.large" }
      ]
    },
    {
      "type": "select",
      "id": "row_gap",
      "label": "t:sections.columns.labels.row_gap",
      "default": "medium",
      "options": [
        { "value": "none", "label": "t:sections.columns.options.gap.none" },
        { "value": "small", "label": "t:sections.columns.options.gap.small" },
        { "value": "medium", "label": "t:sections.columns.options.gap.medium" },
        { "value": "large", "label": "t:sections.columns.options.gap.large" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_scroll",
      "label": "t:sections.columns.labels.enable_sticky_scroll",
      "default": false,
      "info": "t:sections.columns.info.enable_sticky_scroll"
    },
    {
      "type": "range",
      "id": "sticky_offset_top",
      "label": "t:sections.columns.labels.sticky_offset_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80,
      "info": "t:sections.columns.info.sticky_offset_top"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
