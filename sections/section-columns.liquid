          "label": "t:sections.columns.blocks.column.labels.open_new_tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.columns.presets.name",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
