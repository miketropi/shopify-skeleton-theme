      "type": "range",
      "id": "border_radius_bottom_left",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "t:sections.columns.labels.radius_bl",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.columns.blocks.column.name",
      "settings": [
        {
          "type": "header",
          "content": "t:sections.columns.blocks.column.headers.layout"
        },
        {
          "type": "select",
          "id": "column_width",
          "label": "t:sections.columns.blocks.column.labels.column_width",
