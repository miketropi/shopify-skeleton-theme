        },
        {
          "type": "select",
          "id": "button_style",
          "label": "t:sections.columns.blocks.column.labels.button_style",
          "default": "filled",
          "options": [
            { "value": "filled", "label": "t:sections.columns.options.button_style.filled" },
            { "value": "outlined", "label": "t:sections.columns.options.button_style.outlined" },
