{%- liquid
  assign show_hero    = section.settings.show_featured_image
  assign show_meta    = section.settings.show_meta
  assign show_tags    = section.settings.show_tags
  assign show_share   = section.settings.show_share
  assign show_nav     = section.settings.show_nav
  assign show_comments = section.settings.show_comments
  assign content_width = section.settings.content_width | default: 'narrow'
-%}

<article
  class="marticle marticle--{{ content_width }}"
  data-section-type="main-article"
  data-section-id="{{ section.id }}"
  {% render 'color-scheme-vars' %}
>
  {%- comment -%} ── Breadcrumb ── {%- endcomment -%}
  <nav class="marticle__breadcrumb" aria-label="{{ 'article.breadcrumb' | t }}">
    <a href="{{ blog.url }}">{{ blog.title }}</a>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    <span aria-current="page">{{ article.title | truncate: 40 }}</span>
  </nav>

  {%- comment -%} ── Hero image ── {%- endcomment -%}
  {%- if show_hero and article.image -%}
    <figure class="marticle__hero">
      {{
        article.image
        | image_url: width: 1600
        | image_tag:
            loading: 'eager',
            class: 'marticle__hero-img',
            sizes: '(min-width: 75em) 960px, (min-width: 48em) 80vw, 100vw',
            widths: '600, 900, 1200, 1600'
      }}
    </figure>
  {%- endif -%}

  {%- comment -%} ── Header ── {%- endcomment -%}
  <header class="marticle__header">
    {%- if article.tags.size > 0 and show_tags -%}
      <div class="marticle__tags marticle__tags--top">
        {%- for tag in article.tags limit: 3 -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="marticle__tag">{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <h1 class="marticle__title">{{ article.title | escape }}</h1>

    <div class="marticle__header-rule" aria-hidden="true"></div>

    {%- if show_meta -%}
      <div class="marticle__meta">
        {%- if article.author != blank -%}
          <span class="marticle__meta-item">
            <svg class="marticle__meta-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
            {{ article.author }}
          </span>
        {%- endif -%}
        <span class="marticle__meta-item">
          <svg class="marticle__meta-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
            {{ article.published_at | date: '%B %d, %Y' }}
          </time>
        </span>
        {%- if article.content != blank -%}
          {%- assign word_count = article.content | strip_html | split: ' ' | size -%}
          {%- assign read_time = word_count | divided_by: 200 | at_least: 1 -%}
          <span class="marticle__meta-item">
            <svg class="marticle__meta-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            {{ 'article.read_time' | t: minutes: read_time }}
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </header>

  {%- comment -%} ── Article body (editorial prose surface) ── {%- endcomment -%}
  <div class="marticle__prose">
    <div class="marticle__body rte">
      {{ article.content }}
    </div>
  </div>

  {%- comment -%} ── Footer: tags + share ── {%- endcomment -%}
  <footer class="marticle__footer">
    {%- if show_tags and article.tags.size > 0 -%}
      <div class="marticle__tags">
        {%- for tag in article.tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="marticle__tag">{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if show_share -%}
      {%- assign share_url = article.url | prepend: request.origin -%}
      <div class="marticle__share">
        <span class="marticle__share-label">{{ 'article.share' | t }}</span>
        <div class="marticle__share-links">
          <a href="https://x.com/intent/tweet?url={{ share_url | url_encode }}&text={{ article.title | url_encode }}" target="_blank" rel="noopener noreferrer" class="marticle__share-link" aria-label="{{ 'article.share_x' | t }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener noreferrer" class="marticle__share-link" aria-label="{{ 'article.share_facebook' | t }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9.198 21.5h4v-8.01h3.604l.396-3.98h-4V7.5a1 1 0 0 1 1-1h3v-4h-3a5 5 0 0 0-5 5v2.01h-2l-.396 3.98h2.396v8.01Z"/></svg>
          </a>
          <a href="mailto:?subject={{ article.title | url_encode }}&body={{ share_url | url_encode }}" class="marticle__share-link" aria-label="{{ 'article.share_email' | t }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </a>
          <button type="button" class="marticle__share-link" data-copy-url="{{ share_url }}" aria-label="{{ 'article.copy_link' | t }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </button>
        </div>
      </div>
    {%- endif -%}
  </footer>

  {%- comment -%} ── Prev / Next navigation ── {%- endcomment -%}
  {%- if show_nav -%}
    {%- if blog.previous_article or blog.next_article -%}
      <nav class="marticle__nav" aria-label="{{ 'article.nav_label' | t }}">
        {%- if blog.previous_article -%}
          <a href="{{ blog.previous_article.url }}" class="marticle__nav-link marticle__nav-link--prev">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            <div class="marticle__nav-text">
              <span class="marticle__nav-label">{{ 'article.prev_post' | t }}</span>
              <span class="marticle__nav-title">{{ blog.previous_article.title | truncate: 50 }}</span>
            </div>
          </a>
        {%- else -%}
          <span></span>
        {%- endif -%}

        {%- if blog.next_article -%}
          <a href="{{ blog.next_article.url }}" class="marticle__nav-link marticle__nav-link--next">
            <div class="marticle__nav-text">
              <span class="marticle__nav-label">{{ 'article.next_post' | t }}</span>
              <span class="marticle__nav-title">{{ blog.next_article.title | truncate: 50 }}</span>
            </div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        {%- else -%}
          <span></span>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} ── Comments ── {%- endcomment -%}
  {%- if show_comments and blog.comments_enabled? -%}
    <section class="marticle__comments" id="comments">
      <h2 class="marticle__comments-heading">{{ 'blog.article_comments' | t }}</h2>

      {%- paginate article.comments by 10 -%}
        {%- if article.comments_count > 0 -%}
          <div class="marticle__comments-list">
            {%- for comment in article.comments -%}
              <div class="marticle__comment">
                <div class="marticle__comment-avatar">
                  {{ comment.author | slice: 0 | upcase }}
                </div>
                <div class="marticle__comment-body">
                  <div class="marticle__comment-header">
                    <strong class="marticle__comment-author">{{ comment.author }}</strong>
                    <time class="marticle__comment-date" datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">
                      {{ comment.created_at | date: '%b %d, %Y' }}
                    </time>
                  </div>
                  <div class="marticle__comment-content">{{ comment.content }}</div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="marticle__comments-pagination" aria-label="{{ 'general.pagination.label' | t }}">
            {{ paginate | default_pagination: anchor: 'comments' }}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}

      {%- form 'new_comment', article -%}
        <div class="marticle__comment-form">
          <h3 class="marticle__comment-form-title">{{ 'blog.comment_form_title' | t }}</h3>

          {{ form.errors | default_errors }}

          <div class="marticle__form-row">
            <div class="marticle__form-field">
              <label for="comment-author">{{ 'blog.comment_form_name' | t }}</label>
              <input type="text" name="comment[author]" id="comment-author" value="{{ form.author }}" required>
            </div>
            <div class="marticle__form-field">
              <label for="comment-email">{{ 'blog.comment_form_email' | t }}</label>
              <input type="email" name="comment[email]" id="comment-email" value="{{ form.email }}" required>
            </div>
          </div>

          <div class="marticle__form-field">
            <label for="comment-body">{{ 'blog.comment_form_body' | t }}</label>
            <textarea name="comment[body]" id="comment-body" rows="4" required>{{ form.body }}</textarea>
          </div>

          <button type="submit" class="marticle__submit">{{ 'blog.comment_form_submit' | t }}</button>
        </div>
      {%- endform -%}
    </section>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "t:sections.article.name",
  "tag": "section",
  "class": "section-main-article",
  "settings": [
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.article.content_width",
      "default": "narrow",
      "options": [
        { "value": "narrow", "label": "t:sections.article.width_narrow" },
        { "value": "wide", "label": "t:sections.article.width_wide" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_featured_image",
      "label": "t:sections.article.show_featured_image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_meta",
      "label": "t:sections.article.show_meta",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:sections.article.show_tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "t:sections.article.show_share",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_nav",
      "label": "t:sections.article.show_nav",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_comments",
      "label": "t:sections.article.show_comments",
      "default": true
    }
  ],
  "presets": [{ "name": "t:sections.article.name" }]
}
{% endschema %}
