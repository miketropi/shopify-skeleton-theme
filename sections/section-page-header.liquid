      "default": 0
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:sections.page_header.labels.border_style",
      "options": [
        { "value": "none", "label": "t:sections.page_header.options.border_style.none" },
        { "value": "solid", "label": "t:sections.page_header.options.border_style.solid" },
        { "value": "dashed", "label": "t:sections.page_header.options.border_style.dashed" },
        { "value": "dotted", "label": "t:sections.page_header.options.border_style.dotted" }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:sections.page_header.labels.border_color",
