{%- liquid
  assign show_note = section.settings.show_note
-%}

<div
  class="section-{{ section.id }} mcart"
  data-section-type="main-cart"
  data-section-id="{{ section.id }}"
  {% render 'color-scheme-vars' %}
>
  <header class="mcart__header">
    <h1 class="mcart__title">{{ 'cart.title' | t }}</h1>
    {%- if cart.item_count > 0 -%}
      <a class="mcart__continue-link" href="{{ routes.all_products_collection_url }}">
        {{ 'cart.general.continue_shopping' | t }}
      </a>
    {%- endif -%}
  </header>

  {%- if cart.item_count > 0 -%}
    {%- form 'cart', cart, id: 'MainCartForm', class: 'mcart__form' -%}
      <div class="mcart__body">
        <div class="mcart__items-col">
          <ul class="mcart__items" role="list">
            {%- for item in cart.items -%}
              {%- liquid
                assign on_sale = false
                if item.original_line_price > item.final_line_price
                  assign on_sale = true
                endif
              -%}
              <li class="mcart__item" data-line-key="{{ item.key }}">
                <a href="{{ item.url }}" class="mcart__item-media" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}
                    {{
                      item.image
                      | image_url: width: 300
                      | image_tag:
                          loading: 'lazy',
                          alt: item.title,
                          class: 'mcart__item-img',
                          widths: '150,200,300',
                          sizes: '(min-width:48em) 120px, 100px'
                    }}
                  {%- else -%}
                    <div class="mcart__item-placeholder" aria-hidden="true">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                    </div>
                  {%- endif -%}
                </a>

                <div class="mcart__item-body">
                  <div class="mcart__item-info">
                    <a href="{{ item.url }}" class="mcart__item-title">{{ item.product.title | escape }}</a>
                    {%- if item.product.has_only_default_variant == false -%}
                      <p class="mcart__item-variant">{{ item.variant.title | escape }}</p>
                    {%- endif -%}
                    {%- if item.selling_plan_allocation -%}
                      <p class="mcart__item-plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                    {%- endif -%}
                    {%- unless item.properties == empty -%}
                      <ul class="mcart__item-props" role="list">
                        {%- for property in item.properties -%}
                          {%- assign prop_label = property.first -%}
                          {%- assign prop_value = property.last -%}
                          {%- if prop_value != blank and prop_label != '_' -%}
                            <li class="mcart__item-prop">
                              <span class="mcart__item-prop-key">{{ prop_label | escape }}:</span>
                              <span>{{ prop_value | escape }}</span>
                            </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    {%- endunless -%}

                    <div class="mcart__item-price-unit">
                      {%- if item.original_price > item.final_price -%}
                        <s class="mcart__price mcart__price--compare">{{ item.original_price | money }}</s>
                      {%- endif -%}
                      <span class="mcart__price{% if item.original_price > item.final_price %} mcart__price--sale{% endif %}">
                        {{ item.final_price | money }}
                      </span>
                    </div>
                  </div>

                  <div class="mcart__item-actions">
                    <div class="mcart__qty" role="group" aria-label="{{ 'cart.label.quantity' | t }}">
                      <button
                        type="button"
                        class="mcart__qty-btn"
                        data-cart-qty-minus
                        data-line-key="{{ item.key }}"
                        aria-label="{{ 'products.product.quantity_decrease' | t }}"
                      >
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/></svg>
                      </button>
                      <input
                        type="number"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        min="0"
                        step="1"
                        inputmode="numeric"
                        class="mcart__qty-input"
                        data-cart-qty
                        data-line-key="{{ item.key }}"
                        aria-label="{{ 'cart.label.quantity' | t }}: {{ item.title | escape }}"
                      >
                      <button
                        type="button"
                        class="mcart__qty-btn"
                        data-cart-qty-plus
                        data-line-key="{{ item.key }}"
                        aria-label="{{ 'products.product.quantity_increase' | t }}"
                      >
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                      </button>
                    </div>

                    <div class="mcart__item-total" aria-label="{{ 'cart.label.line_total' | t }}">
                      {%- if on_sale -%}
                        <s class="mcart__price mcart__price--compare">{{ item.original_line_price | money }}</s>
                      {%- endif -%}
                      <span class="mcart__price{% if on_sale %} mcart__price--sale{% endif %}">
                        {{ item.final_line_price | money }}
                      </span>
                    </div>
                  </div>

                  <a
                    href="{{ item.url_to_remove }}"
                    class="mcart__item-remove"
                    aria-label="{{ 'cart.label.remove' | t }}: {{ item.title | escape }}"
                  >
                    {{ 'cart.general.remove' | t }}
                  </a>
                </div>
              </li>
            {%- endfor -%}
          </ul>
        </div>

        <div class="mcart__sidebar">
          <div class="mcart__summary">
            <h2 class="mcart__summary-title">{{ 'cart.page.order_summary' | t }}</h2>

            <div class="mcart__summary-row">
              <span>{{ 'cart.general.subtotal' | t }}</span>
              <span class="mcart__summary-value">{{ cart.total_price | money_with_currency }}</span>
            </div>

            {%- if cart.cart_level_discount_applications.size > 0 -%}
              {%- for discount in cart.cart_level_discount_applications -%}
                <div class="mcart__summary-row mcart__summary-row--discount">
                  <span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                    {{ discount.title }}
                  </span>
                  <span class="mcart__summary-value mcart__summary-value--discount">
                    &minus;{{ discount.total_allocated_amount | money }}
                  </span>
                </div>
              {%- endfor -%}
            {%- endif -%}

            <p class="mcart__taxes-note">
              {{ 'cart.general.taxes_and_shipping_at_checkout_html' | t }}
            </p>

            {%- if show_note -%}
              <div class="mcart__note">
                <label class="mcart__note-label" for="CartNote-{{ section.id }}">
                  {{ 'cart.page.note_label' | t }}
                </label>
                <textarea
                  id="CartNote-{{ section.id }}"
                  class="mcart__note-textarea"
                  name="note"
                  rows="3"
                  placeholder="{{ 'cart.page.note_placeholder' | t }}"
                >{{ cart.note }}</textarea>
              </div>
            {%- endif -%}

            <button type="submit" name="checkout" class="mcart__checkout">
              {{ 'cart.general.checkout' | t }}
            </button>
          </div>
        </div>
      </div>
    {%- endform -%}
  {%- else -%}
    <div class="mcart__empty">
      <div class="mcart__empty-icon" aria-hidden="true">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      </div>
      <p class="mcart__empty-text">{{ 'cart.general.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="mcart__empty-btn">
        {{ 'cart.general.continue_shopping' | t }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.cart.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "t:sections.cart.labels.show_note",
      "default": true
    }
  ]
}
{% endschema %}
