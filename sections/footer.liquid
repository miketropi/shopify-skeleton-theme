{%- liquid
  assign footer_color_src = section.settings.color_scheme_source | default: 'global'
  if footer_color_src == 'global'
    assign footer_scheme = settings.global_color_scheme
  else
    assign footer_scheme = section.settings.color_scheme
  endif
  if footer_scheme == blank or footer_scheme.settings == blank
    assign footer_scheme = settings.global_color_scheme
  endif
  if footer_scheme == blank or footer_scheme.settings == blank
    assign footer_scheme = settings.color_schemes['scheme-6']
  endif

  assign logo_w = section.settings.logo_width | default: 120
  assign show_newsletter = section.settings.show_newsletter
  assign show_branding = section.settings.show_branding
  if settings.show_back_to_top == false
    assign show_back_to_top = false
  else
    assign show_back_to_top = true
  endif
  assign accordion_mobile = section.settings.link_columns_accordion_mobile

  assign show_social_block = false
  if section.settings.show_social_icons
    if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_pinterest != blank or settings.social_youtube != blank or settings.social_tiktok != blank or settings.social_x != blank
      assign show_social_block = true
    endif
  endif

  assign show_policies = false
  if section.settings.show_policy_links and shop.policies != empty
    assign show_policies = true
  endif

  assign footer_style = '--footer-logo-width: ' | append: logo_w | append: 'px;'
-%}
{%- capture footer_scheme_vars -%}
  {%- render 'color-scheme-vars', scheme: footer_scheme, inline_only: true -%}
{%- endcapture -%}

<footer
  class="site-footer{% if accordion_mobile %} site-footer--accordion-mobile{% endif %}"
  style="{{ footer_scheme_vars }}{{ footer_style }}"
  data-section-type="footer"
  data-section-id="{{ section.id }}"
  data-footer-accordion="{% if accordion_mobile %}true{% else %}false{% endif %}"
  {{ section.shopify_attributes }}
>
  <div class="site-footer__inner">
    {%- if show_newsletter -%}
      {%- render 'footer-newsletter', section: section -%}
      {%- if section.settings.show_newsletter_divider -%}
        <hr class="site-footer__divider" aria-hidden="true">
      {%- endif -%}
    {%- endif -%}

    <div class="site-footer__body">
      {%- if show_back_to_top -%}
        <button
          type="button"
          class="site-footer__back-to-top"
          data-footer-back-to-top
          hidden
          aria-label="{{ 'footer.back_to_top' | t }}"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
        </button>
      {%- endif -%}

      <div class="site-footer__main">
        {%- if show_branding -%}
          <div class="site-footer__brand">
            {%- if section.settings.logo != blank -%}
              <a class="site-footer__logo-link" href="{{ routes.root_url }}">
                {{
                  section.settings.logo
                  | image_url: width: 480
                  | image_tag:
                    class: 'site-footer__logo',
                    widths: '120,180,240,360,480',
                    sizes: '(max-width: 48em) 140px, 240px',
                    alt: shop.name,
                    loading: 'lazy'
                }}
              </a>
            {%- else -%}
              <h2 class="site-footer__brand-heading">
                <a class="site-footer__brand-heading-link" href="{{ routes.root_url }}">{{ shop.name }}</a>
              </h2>
            {%- endif -%}

            {%- if section.settings.tagline != blank -%}
              <div class="site-footer__tagline rte">{{ section.settings.tagline }}</div>
            {%- endif -%}

            {%- if show_social_block -%}
              <div class="site-footer__brand-social">
                <span class="site-footer__social-label">{{ 'footer.follow' | t }}</span>
                {% render 'footer-socials' %}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="site-footer__columns">
            {%- for block in section.blocks -%}
              {%- if block.type == 'link_column' -%}
                {%- render 'footer-link-column', block: block, section: section -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- render 'footer-store-info', section: section -%}
      </div>
    </div>
  </div>

  <div class="site-footer__bottom-bar">
    <div class="site-footer__bottom-inner">
      <div class="site-footer__bottom-start">
        {%- if show_policies -%}
          <nav class="site-footer__policies" aria-label="{{ 'footer.policies_aria' | t }}">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
              {%- endif -%}
            {%- endfor -%}
          </nav>
        {%- endif -%}

        <p class="site-footer__copyright">
          &copy;
          {{ 'now' | date: '%Y' }}
          <a href="{{ routes.root_url }}">{{ shop.name | escape }}</a>
          {%- if section.settings.copyright_note != blank -%}
            <span class="site-footer__copyright-note"> — {{ section.settings.copyright_note | escape }}</span>
          {%- endif -%}
          <span class="site-footer__powered"> · {{ powered_by_link }}</span>
        </p>
      </div>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="site-footer__payments" aria-label="{{ 'footer.payment_aria' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "section-footer",
  "max_blocks": 2,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme_source",
      "label": "t:labels.section_color_scheme_source",
      "info": "t:info.section_color_scheme_source",
      "default": "global",
      "options": [
        { "value": "global", "label": "t:options.section_color_scheme_source.global" },
        { "value": "custom", "label": "t:options.section_color_scheme_source.custom" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.footer.color_scheme",
      "info": "t:sections.footer.color_scheme_custom_intro",
      "default": "scheme-6",
      "visible_if": "{{ section.settings.color_scheme_source == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:sections.footer.headers.newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.footer.show_newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:sections.footer.newsletter_heading",
      "default": "Subscribe to our newsletter",
      "visible_if": "{{ section.settings.show_newsletter }}"
    },
    {
      "type": "select",
      "id": "newsletter_heading_size",
      "label": "t:sections.footer.newsletter_heading_size",
      "default": "large",
      "visible_if": "{{ section.settings.show_newsletter }}",
      "options": [
        { "value": "small", "label": "t:sections.footer.options.heading_size.small" },
        { "value": "medium", "label": "t:sections.footer.options.heading_size.medium" },
        { "value": "large", "label": "t:sections.footer.options.heading_size.large" },
        { "value": "xlarge", "label": "t:sections.footer.options.heading_size.xlarge" }
      ]
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "t:sections.footer.email_placeholder",
      "default": "Enter your email",
      "visible_if": "{{ section.settings.show_newsletter }}"
    },
    {
      "type": "text",
      "id": "subscribe_button_label",
      "label": "t:sections.footer.subscribe_button_label",
      "default": "Subscribe",
      "visible_if": "{{ section.settings.show_newsletter }}"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter_divider",
      "label": "t:sections.footer.show_newsletter_divider",
      "default": true,
      "visible_if": "{{ section.settings.show_newsletter }}"
    },
    {
      "type": "header",
      "content": "t:sections.footer.heading_brand"
    },
    {
      "type": "checkbox",
      "id": "show_branding",
      "label": "t:sections.footer.show_branding",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.footer.logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:sections.footer.logo_width",
      "min": 60,
      "max": 240,
      "step": 10,
      "unit": "px",
      "default": 120,
      "visible_if": "{{ section.settings.logo != blank }}"
    },
    {
      "type": "richtext",
      "id": "tagline",
      "label": "t:sections.footer.tagline",
      "info": "t:sections.footer.tagline_info"
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "t:sections.footer.show_social_icons",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "t:sections.footer.social_urls_theme_settings"
    },
    {
      "type": "header",
      "content": "t:sections.footer.headers.link_columns"
    },
    {
      "type": "checkbox",
      "id": "link_columns_accordion_mobile",
      "label": "t:sections.footer.link_columns_accordion_mobile",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "t:sections.footer.link_columns_blocks_info"
    },
    {
      "type": "header",
      "content": "t:sections.footer.headers.store_info"
    },
    {
      "type": "paragraph",
      "content": "t:sections.footer.store_info_info"
    },
    {
      "type": "text",
      "id": "store_info_heading",
      "label": "t:sections.footer.store_info_heading",
      "default": "Our store"
    },
    {
      "type": "text",
      "id": "support_label",
      "label": "t:sections.footer.support_label",
      "default": "24/7 support center:"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "t:sections.footer.phone_number"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "t:sections.footer.address"
    },
    {
      "type": "text",
      "id": "email_address",
      "label": "t:sections.footer.email_address"
    },
    {
      "type": "header",
      "content": "t:sections.footer.heading_bottom"
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "t:sections.footer.show_policy_links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_note",
      "label": "t:sections.footer.copyright_note",
      "info": "t:sections.footer.copyright_note_info"
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "t:sections.footer.blocks.link_column.name",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu"
        },
        {
          "type": "text",
          "id": "column_heading_override",
          "label": "t:sections.footer.blocks.link_column.column_heading_override",
          "info": "t:sections.footer.blocks.link_column.column_heading_override_info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.footer.name",
      "blocks": [
        { "type": "link_column" },
        { "type": "link_column" }
      ]
    }
  ]
}
{% endschema %}
