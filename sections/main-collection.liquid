{%- liquid
  assign cols = section.settings.columns | default: 3
  assign per_page = section.settings.per_page | default: 24
  assign show_vendor = section.settings.show_vendor
  assign show_secondary_image = section.settings.show_secondary_image
  assign show_quick_add = section.settings.show_quick_add
  assign hero_height = section.settings.hero_height | default: 'medium'
  assign image_ratio = section.settings.image_ratio | default: '3/4'
  assign show_filtering = section.settings.show_filtering
  assign show_sort = section.settings.show_sort

  assign active_count = 0
  if show_filtering
    for filter in collection.filters
      assign active_count = active_count | plus: filter.active_values.size
      if filter.type == 'price_range'
        if filter.min_value.value != nil or filter.max_value.value != nil
          assign active_count = active_count | plus: 1
        endif
      endif
    endfor
  endif

  assign current_sort = collection.sort_by | default: collection.default_sort_by
-%}

<div
  class="section-{{ section.id }} mcol"
  data-section-type="collection-grid"
  data-section-id="{{ section.id }}"
  data-collection-url="{{ collection.url }}"
  style="--mcol-cols: {{ cols }}; --mcol-image-ratio: {{ image_ratio }};"
  {% render 'color-scheme-vars' %}
>

  {%- if collection == blank -%}
    <div class="mcol__empty">
      <div class="mcol__empty-icon" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </div>
      <p class="mcol__empty-text">{{ 'collections.general.no_matches' | t | default: 'No products found in this collection.' }}</p>
    </div>
  {%- else -%}

    {%- comment -%} ── Hero ── {%- endcomment -%}
    <header class="mcol__hero mcol__hero--{{ hero_height }}{% unless collection.image %} mcol__hero--no-image{% endunless %}">
      {%- if collection.image -%}
        <div class="mcol__hero-media">
          {{ collection.image
            | image_url: width: 2000
            | image_tag:
                loading: 'eager',
                alt: '',
                class: 'mcol__hero-img',
                widths: '600,900,1200,1600,2000',
                sizes: '100vw'
          }}
        </div>
        <div class="mcol__hero-scrim"></div>
      {%- endif -%}

      <div class="mcol__hero-inner">
        <div class="mcol__hero-text">
          <h1 class="mcol__title">{{ collection.title }}</h1>
          {%- if collection.description != blank -%}
            <div class="mcol__desc rte">{{ collection.description }}</div>
          {%- endif -%}
        </div>
        <span class="mcol__count">
          {{ collection.products_count }}
          {{ collection.products_count | pluralize: 'product', 'products' }}
        </span>
      </div>
    </header>

    {%- comment -%} ── Toolbar ── {%- endcomment -%}
    <div class="mcol__toolbar">
      {%- if show_filtering and collection.filters.size > 0 -%}
        <button
          class="mcol__filter-toggle"
          type="button"
          data-filter-toggle
          aria-controls="mcol-filters-{{ section.id }}"
          aria-expanded="false"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
          {%- if active_count > 0 -%}
            {{ 'collections.filtering.filter_and_count' | t: count: active_count }}
          {%- else -%}
            {{ 'collections.filtering.filter' | t }}
          {%- endif -%}
        </button>
      {%- endif -%}

      <p class="mcol__toolbar-count">
        {{ 'collections.general.product_count' | t: count: collection.products_count }}
      </p>

      {%- if show_sort -%}
        <div class="mcol__sort">
          <label class="mcol__sort-label" for="mcol-sort-{{ section.id }}">
            {{ 'collections.filtering.sort_by' | t }}
          </label>
          <select class="mcol__sort-select" id="mcol-sort-{{ section.id }}" data-sort-select>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if current_sort == option.value %} selected{% endif %}>
                {{ option.name }}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ── Filter panel + Grid wrapper ── {%- endcomment -%}
    <div class="mcol__body{% if show_filtering and collection.filters.size > 0 %} mcol__body--has-filters{% endif %}">

      {%- if show_filtering and collection.filters.size > 0 -%}
        <div class="mcol__filter-backdrop" data-filter-backdrop></div>
        <aside
          class="mcol__filters"
          id="mcol-filters-{{ section.id }}"
          data-filter-panel
          aria-label="{{ 'collections.filtering.filter' | t }}"
        >
          <div class="mcol__filters-header">
            <span class="mcol__filters-heading">{{ 'collections.filtering.filter' | t }}</span>
            <button class="mcol__filters-close" type="button" data-filter-close aria-label="{{ 'collections.filtering.close_filters' | t }}">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>

          <form class="mcol__filters-form" data-filter-form>
            {%- for filter in collection.filters -%}
              <details class="mcol__filter-group" open>
                <summary class="mcol__filter-summary">
                  {{ filter.label }}
                  <svg class="mcol__filter-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </summary>

                <div class="mcol__filter-values">
                  {%- case filter.type -%}
                    {%- when 'list' or 'boolean' -%}
                      <ul class="mcol__filter-list" role="list">
                        {%- for value in filter.values -%}
                          {%- liquid
                            if value.active
                              assign filter_url = value.url_to_remove
                            else
                              assign filter_url = value.url_to_add
                            endif
                          -%}
                          <li>
                            <a
                              class="mcol__filter-option{% if value.active %} mcol__filter-option--active{% endif %}{% if value.count == 0 and value.active == false %} mcol__filter-option--disabled{% endif %}"
                              href="{{ filter_url }}"
                              {% if value.count == 0 and value.active == false %}aria-disabled="true"{% endif %}
                            >
                              <span class="mcol__filter-check" aria-hidden="true">
                                {%- if value.active -%}
                                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                {%- endif -%}
                              </span>
                              <span class="mcol__filter-label">{{ value.label }}</span>
                              <span class="mcol__filter-count">({{ value.count }})</span>
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>

                    {%- when 'price_range' -%}
                      {%- liquid
                        assign price_min = filter.min_value.value | default: '' | money_without_currency
                        assign price_max = filter.max_value.value | default: '' | money_without_currency
                        assign range_max = filter.range_max | money_without_currency
                      -%}
                      <div class="mcol__filter-price">
                        <div class="mcol__filter-price-field">
                          <label for="filter-price-min-{{ section.id }}">{{ 'collections.filtering.price_from' | t }}</label>
                          <input
                            type="number"
                            id="filter-price-min-{{ section.id }}"
                            class="mcol__filter-price-input"
                            name="{{ filter.min_value.param_name }}"
                            value="{{ price_min }}"
                            min="0"
                            max="{{ range_max }}"
                            placeholder="0"
                            data-price-range="min"
                          >
                        </div>
                        <span class="mcol__filter-price-sep" aria-hidden="true">&ndash;</span>
                        <div class="mcol__filter-price-field">
                          <label for="filter-price-max-{{ section.id }}">{{ 'collections.filtering.price_to' | t }}</label>
                          <input
                            type="number"
                            id="filter-price-max-{{ section.id }}"
                            class="mcol__filter-price-input"
                            name="{{ filter.max_value.param_name }}"
                            value="{{ price_max }}"
                            min="0"
                            max="{{ range_max }}"
                            placeholder="{{ range_max }}"
                            data-price-range="max"
                          >
                        </div>
                      </div>
                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}
          </form>

          {%- if active_count > 0 -%}
            <div class="mcol__filters-footer">
              <a class="mcol__filters-clear" href="{{ collection.url }}">
                {{ 'collections.filtering.clear_all' | t }}
              </a>
            </div>
          {%- endif -%}
        </aside>
      {%- endif -%}

      <div class="mcol__main">
        {%- comment -%} ── Active filter pills ── {%- endcomment -%}
        {%- if active_count > 0 -%}
          <div class="mcol__active-filters" aria-label="{{ 'collections.filtering.active_filters' | t }}">
            {%- for filter in collection.filters -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                  {%- liquid
                    assign pmin = filter.min_value.value | default: 0 | money
                    assign pmax = filter.max_value.value | default: filter.range_max | money
                  -%}
                  <a class="mcol__pill" href="{{ collection.url }}">
                    {{ filter.label }}: {{ pmin }} &ndash; {{ pmax }}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  </a>
                {%- endif -%}
              {%- else -%}
                {%- for value in filter.active_values -%}
                  <a class="mcol__pill" href="{{ value.url_to_remove }}" aria-label="{{ 'collections.filtering.remove_filter' | t: label: value.label }}">
                    {{ value.label }}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  </a>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
            <a class="mcol__pill mcol__pill--clear" href="{{ collection.url }}">
              {{ 'collections.filtering.clear_all' | t }}
            </a>
          </div>
        {%- endif -%}

        {%- comment -%} ── Grid ── {%- endcomment -%}
        {% paginate collection.products by per_page %}
          {%- if collection.products.size > 0 -%}
            <ul class="mcol__grid" role="list">
              {%- for product in collection.products -%}
                {%- liquid
                  assign on_sale = false
                  if product.compare_at_price > product.price
                    assign on_sale = true
                  endif
                  assign first_variant = product.first_available_variant | default: product.variants.first
                  assign has_multiple_variants = false
                  if product.has_only_default_variant == false
                    assign has_multiple_variants = true
                  endif
                  assign has_second = false
                  if show_secondary_image and product.images.size > 1
                    assign has_second = true
                  endif
                -%}

                <li class="mcol__grid-item">
                  <article class="mcol__card{% if has_second %} mcol__card--has-alt{% endif %}{% unless product.available %} mcol__card--unavailable{% endunless %}">

                    {%- liquid
                      assign primary_alt = product.featured_image.alt | default: product.title
                      if has_second
                        assign secondary_alt = product.images[1].alt | default: product.title
                      endif
                    -%}
                    <a class="mcol__card-media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                      {%- if product.featured_image != blank -%}
                        {{
                          product.featured_image
                          | image_url: width: 900
                          | image_tag:
                              loading: 'lazy',
                              alt: primary_alt,
                              class: 'mcol__card-img mcol__card-img--primary',
                              widths: '360,480,640,900',
                              sizes: '(min-width:75em) 25vw, (min-width:48em) 33vw, 50vw'
                        }}
                        {%- if has_second -%}
                          {{
                            product.images[1]
                            | image_url: width: 900
                            | image_tag:
                                loading: 'lazy',
                                alt: secondary_alt,
                                class: 'mcol__card-img mcol__card-img--secondary',
                                widths: '360,480,640,900',
                                sizes: '(min-width:75em) 25vw, (min-width:48em) 33vw, 50vw'
                          }}
                        {%- endif -%}
                      {%- else -%}
                        <div class="mcol__card-placeholder" aria-hidden="true">
                          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                        </div>
                      {%- endif -%}

                      {%- if on_sale -%}
                        <span class="mcol__badge mcol__badge--sale">{{ 'products.product.sale' | t | default: 'Sale' }}</span>
                      {%- elsif product.available == false -%}
                        <span class="mcol__badge mcol__badge--soldout">{{ 'products.product.sold_out' | t | default: 'Sold out' }}</span>
                      {%- endif -%}
                    </a>

                    <div class="mcol__card-body">
                      {%- if show_vendor and product.vendor != blank -%}
                        <span class="mcol__card-vendor">{{ product.vendor }}</span>
                      {%- endif -%}

                      <a class="mcol__card-title" href="{{ product.url }}">
                        {{ product.title | escape }}
                      </a>

                      <div class="mcol__card-prices">
                        <span class="mcol__price{% if on_sale %} mcol__price--sale{% endif %}">
                          {{ product.price | money }}
                        </span>
                        {%- if on_sale -%}
                          <s class="mcol__price mcol__price--compare">{{ product.compare_at_price | money }}</s>
                        {%- endif -%}
                      </div>

                      {%- if show_quick_add and first_variant -%}
                        {%- if has_multiple_variants -%}
                          <div class="mcol__card-atc">
                            <a href="{{ product.url }}" class="mcol__card-atc-btn mcol__card-atc-btn--options">
                              {{ 'products.product.choose_options' | t | default: 'Choose options' }}
                            </a>
                          </div>
                        {%- else -%}
                          <form
                            action="{{ routes.cart_add_url }}"
                            method="post"
                            data-ajax-add-to-cart
                            class="mcol__card-atc"
                          >
                            <input type="hidden" name="id" value="{{ first_variant.id }}">
                            <input type="hidden" name="quantity" value="1">
                            <button
                              type="submit"
                              class="mcol__card-atc-btn"
                              data-product-submit
                              data-product-available="{{ first_variant.available }}"
                              {% unless first_variant.available %}disabled{% endunless %}
                            >
                              {%- if first_variant.available -%}
                                {{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}
                              {%- else -%}
                                {{ 'products.product.sold_out' | t | default: 'Sold out' }}
                              {%- endif -%}
                            </button>
                          </form>
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                  </article>
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <div class="mcol__empty">
              <div class="mcol__empty-icon" aria-hidden="true">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              </div>
              <p class="mcol__empty-text">{{ 'collections.filtering.no_results' | t }}</p>
              <a class="mcol__empty-link" href="{{ collection.url }}">{{ 'collections.filtering.clear_and_browse' | t }}</a>
            </div>
          {%- endif -%}

          {%- comment -%} ── Pagination ── {%- endcomment -%}
          {%- if paginate.pages > 1 -%}
            <nav class="mcol__pag" aria-label="Pagination">
              {%- if paginate.previous -%}
                <a class="mcol__pag-arrow" href="{{ paginate.previous.url }}" aria-label="Previous page">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                </a>
              {%- else -%}
                <span class="mcol__pag-arrow mcol__pag-arrow--disabled" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                </span>
              {%- endif -%}

              <ol class="mcol__pag-list">
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <li><a class="mcol__pag-item" href="{{ part.url }}">{{ part.title }}</a></li>
                  {%- else -%}
                    {%- if part.title == paginate.current_page -%}
                      <li><span class="mcol__pag-item mcol__pag-item--active" aria-current="page">{{ part.title }}</span></li>
                    {%- else -%}
                      <li><span class="mcol__pag-item mcol__pag-item--gap">{{ part.title }}</span></li>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </ol>

              {%- if paginate.next -%}
                <a class="mcol__pag-arrow" href="{{ paginate.next.url }}" aria-label="Next page">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
              {%- else -%}
                <span class="mcol__pag-arrow mcol__pag-arrow--disabled" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </span>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {% endpaginate %}
      </div>
    </div>

  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:general.collection",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "select",
      "id": "hero_height",
      "label": "Hero height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Filtering & sorting"
    },
    {
      "type": "checkbox",
      "id": "show_filtering",
      "label": "Enable collection filtering",
      "info": "Filters must also be configured in Shopify admin under Online Store > Navigation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "info": "Choose the ratio that best matches your product photos",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/5", "label": "Tall (4:5)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "2/3", "label": "Classic (2:3)" },
        { "value": "4/3", "label": "Landscape (4:3)" }
      ],
      "default": "3/4"
    },
    {
      "type": "header",
      "content": "Card options"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add-to-cart",
      "default": true
    }
  ],
  "presets": [{ "name": "Collection" }]
}
{% endschema %}
