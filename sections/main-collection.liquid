{%- liquid
  assign cols = section.settings.columns | default: 3
  assign per_page = section.settings.per_page | default: 24
  assign show_vendor = section.settings.show_vendor
  assign show_secondary_image = section.settings.show_secondary_image
  assign show_quick_add = section.settings.show_quick_add
  assign show_hero = section.settings.show_hero
  assign hero_height = section.settings.hero_height | default: 'medium'
  assign hero_image = collection.image | default: section.settings.hero_fallback_image
  assign image_ratio = section.settings.image_ratio | default: '3/4'
  assign show_filtering = section.settings.show_filtering
  assign show_sort = section.settings.show_sort
  assign filter_offcanvas_position = section.settings.filter_offcanvas_position | default: 'left'
  assign filter_layout = section.settings.filter_layout | default: 'offcanvas'
  if filter_offcanvas_position != 'left' and filter_offcanvas_position != 'right'
    assign filter_offcanvas_position = 'left'
  endif
  if filter_layout != 'offcanvas' and filter_layout != 'toggle' and filter_layout != 'overlay' and filter_layout != 'sidebar'
    assign filter_layout = 'offcanvas'
  endif

  assign active_count = 0
  if show_filtering
    for filter in collection.filters
      assign active_count = active_count | plus: filter.active_values.size
      if filter.type == 'price_range'
        if filter.min_value.value != nil or filter.max_value.value != nil
          assign active_count = active_count | plus: 1
        endif
      endif
    endfor
  endif

  assign current_sort = collection.sort_by | default: collection.default_sort_by
-%}

<div
  class="section-{{ section.id }} mcol mcol--filter-layout-{{ filter_layout }}"
  data-section-type="collection-grid"
  data-section-id="{{ section.id }}"
  data-collection-url="{{ collection.url }}"
  data-filter-layout="{{ filter_layout }}"
  data-filter-offcanvas="{{ filter_offcanvas_position }}"
  style="--mcol-cols: {{ cols }}; --tcard-image-ratio: {{ image_ratio }};"
  {% render 'color-scheme-vars' %}
>

  {%- if collection == blank -%}
    <div class="mcol__empty">
      <div class="mcol__empty-icon" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </div>
      <p class="mcol__empty-text">{{ 'collections.general.no_matches' | t | default: 'No products found in this collection.' }}</p>
    </div>
  {%- else -%}

    {%- comment -%} ── Hero ── {%- endcomment -%}
    {%- if show_hero -%}
      <header class="mcol__hero mcol__hero--{{ hero_height }}{% unless hero_image %} mcol__hero--no-image{% endunless %}">
        {%- if hero_image -%}
          <div class="mcol__hero-media">
            {{ hero_image
              | image_url: width: 2000
              | image_tag:
                  loading: 'eager',
                  alt: '',
                  class: 'mcol__hero-img',
                  widths: '600,900,1200,1600,2000',
                  sizes: '100vw'
            }}
          </div>
          <div class="mcol__hero-scrim"></div>
        {%- endif -%}

        <div class="mcol__hero-inner">
          <div class="mcol__hero-text">
            <h1 class="mcol__title">{{ collection.title }}</h1>
            {%- if collection.description != blank -%}
              <div class="mcol__desc rte">{{ collection.description }}</div>
            {%- endif -%}
          </div>
          <span class="mcol__count">
            {{ collection.products_count }}
            {{ collection.products_count | pluralize: 'product', 'products' }}
          </span>
        </div>
      </header>
    {%- else -%}
      <div class="mcol__hero-minimal">
        <h1 class="mcol__title">{{ collection.title }}</h1>
      </div>
    {%- endif -%}

    {%- comment -%} ── Toolbar (+ overlay filter mount) ── {%- endcomment -%}
    {%- if show_filtering and collection.filters.size > 0 and filter_layout == 'overlay' -%}
      <div class="mcol__toolbar-stack">
    {%- endif -%}
    <div class="mcol__toolbar">
      {%- if show_filtering and collection.filters.size > 0 -%}
        <button
          class="mcol__filter-toggle{% if filter_layout == 'sidebar' %} mcol__filter-toggle--sidebar-only{% endif %}"
          type="button"
          data-filter-toggle
          aria-controls="mcol-filters-{{ section.id }}"
          aria-expanded="false"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
          {%- if active_count > 0 -%}
            {{ 'collections.filtering.filter_and_count' | t: count: active_count }}
          {%- else -%}
            {{ 'collections.filtering.filter' | t }}
          {%- endif -%}
        </button>
      {%- endif -%}

      <p class="mcol__toolbar-count">
        {{ 'collections.general.product_count' | t: count: collection.products_count }}
      </p>

      {%- if show_sort -%}
        <div class="mcol__sort">
          <label class="mcol__sort-label" for="mcol-sort-{{ section.id }}">
            {{ 'collections.filtering.sort_by' | t }}
          </label>
          <select class="mcol__sort-select" id="mcol-sort-{{ section.id }}" data-sort-select>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if current_sort == option.value %} selected{% endif %}>
                {{ option.name }}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
    </div>

    {%- if show_filtering and collection.filters.size > 0 and filter_layout == 'overlay' -%}
      <div class="mcol__filter-backdrop mcol__filter-backdrop--overlay" data-filter-backdrop aria-hidden="true"></div>
      {%- render 'mcol-filters-panel',
        section: section,
        collection: collection,
        active_count: active_count,
        filter_layout: filter_layout,
        filter_offcanvas_position: filter_offcanvas_position
      -%}
    </div>
    {%- endif -%}

    {%- comment -%} ── Filter panel (offcanvas / toggle) + Grid wrapper ── {%- endcomment -%}
    <div class="mcol__body{% if show_filtering and collection.filters.size > 0 %} mcol__body--has-filters{% endif %}{% if show_filtering and collection.filters.size > 0 and filter_layout == 'sidebar' %} mcol__body--sidebar-filters{% endif %}">

      {%- if show_filtering and collection.filters.size > 0 -%}
        {%- if filter_layout == 'offcanvas' or filter_layout == 'toggle' or filter_layout == 'sidebar' -%}
          {%- if filter_layout == 'offcanvas' -%}
            <div class="mcol__filter-backdrop" data-filter-backdrop aria-hidden="true"></div>
          {%- endif -%}
          {%- render 'mcol-filters-panel',
            section: section,
            collection: collection,
            active_count: active_count,
            filter_layout: filter_layout,
            filter_offcanvas_position: filter_offcanvas_position
          -%}
        {%- endif -%}
      {%- endif -%}

      <div class="mcol__main">
        {%- comment -%} ── Active filter pills ── {%- endcomment -%}
        {%- if active_count > 0 -%}
          <div class="mcol__active-filters" aria-label="{{ 'collections.filtering.active_filters' | t }}">
            {%- for filter in collection.filters -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                  {%- liquid
                    assign pmin_cents = filter.min_value.value | default: 0
                    assign pmax_cents = filter.max_value.value | default: filter.range_max
                  -%}
                  <a class="mcol__pill" href="{{ filter.url_to_remove }}" aria-label="{{ 'collections.filtering.remove_filter' | t: label: filter.label }}">
                    {{ filter.label }}:
                    {%- render 'price-display', price: pmin_cents, variant: 'pill' %}
                    &ndash;
                    {%- render 'price-display', price: pmax_cents, variant: 'pill' %}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  </a>
                {%- endif -%}
              {%- else -%}
                {%- for value in filter.active_values -%}
                  <a class="mcol__pill" href="{{ value.url_to_remove }}" aria-label="{{ 'collections.filtering.remove_filter' | t: label: value.label }}">
                    {{ value.label }}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  </a>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
            <a class="mcol__pill mcol__pill--clear" href="{{ collection.url }}">
              {{ 'collections.filtering.clear_all' | t }}
            </a>
          </div>
        {%- endif -%}

        {%- comment -%} ── Grid ── {%- endcomment -%}
        {% paginate collection.products by per_page %}
          {%- if collection.products.size > 0 -%}
            <ul class="mcol__grid" role="list">
              {%- for product in collection.products -%}
                <li class="mcol__grid-item">
                  {%- render 'tcard-product',
                    product: product,
                    show_secondary_image: show_secondary_image,
                    show_vendor: show_vendor,
                    show_quick_add: show_quick_add
                  -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <div class="mcol__empty">
              <div class="mcol__empty-icon" aria-hidden="true">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              </div>
              <p class="mcol__empty-text">{{ 'collections.filtering.no_results' | t }}</p>
              <a class="mcol__empty-link" href="{{ collection.url }}">{{ 'collections.filtering.clear_and_browse' | t }}</a>
            </div>
          {%- endif -%}

          {%- comment -%} ── Pagination ── {%- endcomment -%}
          {%- if paginate.pages > 1 -%}
            <nav class="mcol__pag" aria-label="Pagination">
              {%- if paginate.previous -%}
                <a class="mcol__pag-arrow" href="{{ paginate.previous.url }}" aria-label="Previous page">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                </a>
              {%- else -%}
                <span class="mcol__pag-arrow mcol__pag-arrow--disabled" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                </span>
              {%- endif -%}

              <ol class="mcol__pag-list">
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <li><a class="mcol__pag-item" href="{{ part.url }}">{{ part.title }}</a></li>
                  {%- else -%}
                    {%- if part.title == paginate.current_page -%}
                      <li><span class="mcol__pag-item mcol__pag-item--active" aria-current="page">{{ part.title }}</span></li>
                    {%- else -%}
                      <li><span class="mcol__pag-item mcol__pag-item--gap">{{ part.title }}</span></li>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </ol>

              {%- if paginate.next -%}
                <a class="mcol__pag-arrow" href="{{ paginate.next.url }}" aria-label="Next page">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
              {%- else -%}
                <span class="mcol__pag-arrow mcol__pag-arrow--disabled" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </span>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {% endpaginate %}
      </div>
    </div>

  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:general.collection",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "Show hero banner",
      "info": "Displays the collection image, description, and product count in a hero section",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "hero_fallback_image",
      "label": "Default hero image",
      "info": "Used when a collection has no image set"
    },
    {
      "type": "select",
      "id": "hero_height",
      "label": "Hero height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Filtering & sorting"
    },
    {
      "type": "checkbox",
      "id": "show_filtering",
      "label": "Enable collection filtering",
      "info": "Filters must also be configured in Shopify admin under Online Store > Navigation",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_layout",
      "label": "t:sections.main_collection.filter_layout.label",
      "info": "t:sections.main_collection.filter_layout.info",
      "options": [
        { "value": "offcanvas", "label": "t:sections.main_collection.filter_layout.offcanvas" },
        { "value": "toggle", "label": "t:sections.main_collection.filter_layout.toggle" },
        { "value": "overlay", "label": "t:sections.main_collection.filter_layout.overlay" },
        { "value": "sidebar", "label": "t:sections.main_collection.filter_layout.sidebar" }
      ],
      "default": "offcanvas"
    },
    {
      "type": "select",
      "id": "filter_offcanvas_position",
      "label": "t:sections.main_collection.filter_offcanvas_position.label",
      "visible_if": "{{ section.settings.filter_layout == 'offcanvas' }}",
      "options": [
        { "value": "left", "label": "t:sections.main_collection.filter_offcanvas_position.left" },
        { "value": "right", "label": "t:sections.main_collection.filter_offcanvas_position.right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "info": "Choose the ratio that best matches your product photos",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/5", "label": "Tall (4:5)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "2/3", "label": "Classic (2:3)" },
        { "value": "4/3", "label": "Landscape (4:3)" }
      ],
      "default": "3/4"
    },
    {
      "type": "header",
      "content": "Card options"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add-to-cart",
      "default": true
    }
  ],
  "presets": [{ "name": "Collection" }]
}
{% endschema %}
