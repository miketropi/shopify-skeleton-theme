{%- liquid
  assign cl_scheme = settings.global_color_scheme
  if cl_scheme == blank or cl_scheme.settings == blank
    assign cl_scheme = settings.color_schemes['scheme-6']
  endif

  assign clsm = section.settings.section_color_scheme_mode
  if clsm == 'custom'
    assign picked_cl = section.settings.color_scheme
    if picked_cl != blank and picked_cl.settings != blank
      assign cl_scheme = picked_cl
    endif
  elsif clsm == 'default'
  else
    assign picked_cl = section.settings.color_scheme
    if picked_cl != blank and picked_cl.settings != blank
      assign cl_scheme = picked_cl
    endif
  endif

  assign valid_count = 0
  for block in section.blocks
    if block.type == 'collection_entry'
      assign bx = block.settings.collection
      assign bu = block.settings.custom_url
      if bx != blank or bu != blank
        assign valid_count = valid_count | plus: 1
      endif
    elsif block.type == 'all_collections'
      assign ac_max = block.settings.max_collections | default: 24 | times: 1
      if ac_max < 1
        assign ac_max = 1
      elsif ac_max > 50
        assign ac_max = 50
      endif
      assign ac_emitted = 0
      for collection in collections
        if block.settings.exclude_all_collection and collection.handle == 'all'
          continue
        endif
        if block.settings.exclude_frontpage and collection.handle == 'frontpage'
          continue
        endif
        if block.settings.hide_empty and collection.products_count == 0
          continue
        endif
        if ac_emitted >= ac_max
          break
        endif
        assign ac_emitted = ac_emitted | plus: 1
        assign valid_count = valid_count | plus: 1
      endfor
    endif
  endfor

  assign dft = section.settings.default_active_index | default: 1
  if dft < 1
    assign dft = 1
  endif
  if valid_count > 0 and dft > valid_count
    assign dft = valid_count
  endif
  assign default_zero = dft | minus: 1

  assign img_w = section.settings.image_column_width | default: '50'
  assign img_ratio = section.settings.image_ratio | default: 'landscape'
  case img_ratio
    when 'square'
      assign ratio_css = '1 / 1'
    when 'portrait'
      assign ratio_css = '3 / 4'
    else
      assign ratio_css = '4 / 3'
  endcase

  assign rad_key = section.settings.image_border_radius | default: 'medium'
  case rad_key
    when 'none'
      assign rad_px = 0
    when 'small'
      assign rad_px = 8
    when 'large'
      assign rad_px = 24
    else
      assign rad_px = 16
  endcase

  assign fade_ms = section.settings.hover_transition_speed | default: '300'
  case fade_ms
    when '150'
      assign fade_s = 0.15
    when '500'
      assign fade_s = 0.5
    else
      assign fade_s = 0.3
  endcase

  assign has_intro = false
  if section.settings.eyebrow_text != blank or section.settings.heading != blank or section.settings.description != blank
    assign has_intro = true
  endif
-%}
{%- capture cl_scheme_vars -%}
  {%- render 'color-scheme-vars', scheme: cl_scheme, inline_only: true -%}
{%- endcapture -%}

{%- render 'section-styles', section: section -%}

{% style %}
  html.js #shopify-section-{{ section.id }} .coll-list:not(.coll-list--revealed) .coll-list__media-motion,
  html.js #shopify-section-{{ section.id }} .coll-list:not(.coll-list--revealed) .coll-list__item {
    opacity: 0;
  }
{% endstyle %}

<div
  class="section-{{ section.id }} coll-list shopify-section-wrapper product-slider--heading-{{ section.settings.heading_size | default: 'large' }} coll-list--title-{{ section.settings.title_size | default: 'large' }}{% if section.settings.entry_divider %} coll-list--dividers{% endif %}{% if section.settings.full_width %} full-width coll-list--full-width{% endif %}"
  data-section-type="section-collection-list"
  data-section-id="{{ section.id }}"
  data-coll-list-entrance-scroll="{% if section.settings.entrance_animate_on_scroll == false %}false{% else %}true{% endif %}"
  style="
    {{ cl_scheme_vars }}
    --coll-list-img-col: {{ img_w }}%;
    --coll-list-aspect: {{ ratio_css }};
    --coll-list-img-radius: {{ rad_px }}px;
    --coll-list-fade: {{ fade_s }}s;
    {%- if section.settings.entry_title_use_scheme_colors == false -%}
      --coll-list-active-title: {{ section.settings.active_title_color | default: '#1A1A1A' }};
      --coll-list-inactive-title: {{ section.settings.inactive_title_color | default: '#999999' }};
    {%- endif -%}
  "
  {{ section.shopify_attributes }}
>
  <div class="coll-list__shell{% if section.settings.full_width %} section-content-width{% endif %}">
    {%- if valid_count > 0 -%}
      <div class="coll-list__body">
        <div class="coll-list__media">
          <div class="coll-list__media-motion">
            <div class="coll-list__media-stack">
            {%- assign media_i = -1 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'collection_entry' -%}
                {%- assign coll = block.settings.collection -%}
                {%- assign custom_url = block.settings.custom_url -%}
                {%- if coll != blank or custom_url != blank -%}
                  {%- assign media_i = media_i | plus: 1 -%}
                  {%- assign img = block.settings.custom_image | default: coll.featured_image -%}
                  {%- assign is_active_media = false -%}
                  {%- if media_i == default_zero -%}
                    {%- assign is_active_media = true -%}
                  {%- endif -%}
                  <div
                    class="coll-list__media-item{% if is_active_media %} is-active{% endif %}"
                    data-coll-list-media
                    data-coll-list-index="{{ media_i }}"
                    aria-hidden="{% if is_active_media %}false{% else %}true{% endif %}"
                  >
                    {%- if img != blank -%}
                      {%- assign img_loading = 'lazy' -%}
                      {%- if is_active_media -%}
                        {%- assign img_loading = 'eager' -%}
                      {%- endif -%}
                      {{
                        img
                        | image_url: width: 1600
                        | image_tag:
                          loading: img_loading,
                          class: 'coll-list__media-img',
                          widths: '400,600,800,1200,1600',
                          sizes: '(min-width: 62em) min(55vw, 720px), (min-width: 48em) 40vw, 100vw',
                          alt: ''
                      }}
                    {%- else -%}
                      <div class="coll-list__media-placeholder" aria-hidden="true">
                        {{ 'image' | placeholder_svg_tag: 'coll-list__media-placeholder-svg' }}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- elsif block.type == 'all_collections' -%}
                {%- liquid
                  assign ac_max = block.settings.max_collections | default: 24 | times: 1
                  if ac_max < 1
                    assign ac_max = 1
                  elsif ac_max > 50
                    assign ac_max = 50
                  endif
                -%}
                {%- assign ac_media_first = true -%}
                {%- assign ac_emitted = 0 -%}
                {%- for collection in collections -%}
                  {%- if block.settings.exclude_all_collection and collection.handle == 'all' -%}
                    {%- continue -%}
                  {%- endif -%}
                  {%- if block.settings.exclude_frontpage and collection.handle == 'frontpage' -%}
                    {%- continue -%}
                  {%- endif -%}
                  {%- if block.settings.hide_empty and collection.products_count == 0 -%}
                    {%- continue -%}
                  {%- endif -%}
                  {%- if ac_emitted >= ac_max -%}
                    {%- break -%}
                  {%- endif -%}
                  {%- assign ac_emitted = ac_emitted | plus: 1 -%}
                  {%- assign media_i = media_i | plus: 1 -%}
                  {%- assign img = collection.featured_image -%}
                  {%- assign is_active_media = false -%}
                  {%- if media_i == default_zero -%}
                    {%- assign is_active_media = true -%}
                  {%- endif -%}
                  {%- assign ac_img_alt_e = collection.title | escape -%}
                  <div
                    class="coll-list__media-item{% if is_active_media %} is-active{% endif %}"
                    data-coll-list-media
                    data-coll-list-index="{{ media_i }}"
                    aria-hidden="{% if is_active_media %}false{% else %}true{% endif %}"
                    {% if ac_media_first -%}
                      {{ block.shopify_attributes }}
                      {%- assign ac_media_first = false -%}
                    {%- endif %}
                  >
                    {%- if img != blank -%} 
                      {%- assign img_loading = 'lazy' -%}
                      {%- if is_active_media -%}
                        {%- assign img_loading = 'eager' -%} 
                      {%- endif -%}
                      {{
                        img
                        | image_url: width: 1600
                        | image_tag:
                          loading: img_loading,
                          class: 'coll-list__media-img',
                          widths: '400,600,800,1200,1600',
                          sizes: '(min-width: 62em) min(55vw, 720px), (min-width: 48em) 40vw, 100vw',
                          alt: ac_img_alt_e
                      }}
                    {%- else -%}
                      <div class="coll-list__media-placeholder" aria-hidden="true">
                        {{ 'image' | placeholder_svg_tag: 'coll-list__media-placeholder-svg' }}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
            </div>
          </div>
        </div>

        <ul class="coll-list__entries" role="list">
          {%- if has_intro -%}
            <li class="coll-list__item coll-list__item--intro">
              <header class="coll-list__intro product-slider__intro-copy">
                {%- if section.settings.eyebrow_text != blank -%}
                  <p class="product-slider__eyebrow">{{ section.settings.eyebrow_text | escape }}</p>
                {%- endif -%}
                {%- if section.settings.heading != blank -%}
                  <h2 class="product-slider__heading">{{ section.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if section.settings.description != blank -%}
                  <div class="coll-list__description rte">{{ section.settings.description }}</div>
                {%- endif -%}
              </header>
            </li>
          {%- endif -%}
          {%- assign entry_i = -1 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'collection_entry' -%}
              {%- assign coll = block.settings.collection -%}
              {%- assign custom_url = block.settings.custom_url -%}
              {%- if coll != blank or custom_url != blank -%}
                {%- assign entry_i = entry_i | plus: 1 -%}
                {%- assign href = custom_url | default: coll.url -%}
                {%- assign title = block.settings.custom_title | default: coll.title | default: href -%}
                {%- assign open_tab = block.settings.open_new_tab -%}
                {%- assign is_active_row = false -%}
                {%- if entry_i == default_zero -%}
                  {%- assign is_active_row = true -%}
                {%- endif -%}
                <li
                  class="coll-list__item{% if is_active_row %} is-active{% endif %}"
                  data-coll-list-item
                  data-coll-list-index="{{ entry_i }}"
                  {{ block.shopify_attributes }}
                >
                  <a
                    class="coll-list__entry"
                    href="{{ href }}"
                    data-coll-list-entry
                    data-coll-list-index="{{ entry_i }}"
                    {% if open_tab %}
                      target="_blank" rel="noopener noreferrer"
                    {% endif %}
                  >
                    <span class="coll-list__entry-main">
                      <span class="coll-list__entry-title">{{ title | escape }}</span>
                      {%- if section.settings.show_product_count -%}
                        {%- if block.settings.custom_product_count != blank -%}
                          <span class="coll-list__entry-count">
                            {{ block.settings.custom_product_count | escape }}
                          </span>
                        {%- elsif coll != blank -%}
                          <span class="coll-list__entry-count">
                            {{ 'collections.general.product_count' | t: count: coll.products_count }}
                          </span>
                        {%- endif -%}
                      {%- endif -%}
                    </span>
                    {%- if section.settings.show_arrow_icon -%}
                      <span class="coll-list__arrow" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M5 12h14"/>
                          <path d="m12 5 7 7-7 7"/>
                        </svg>
                      </span>
                    {%- endif -%}
                  </a>
                </li>
              {%- endif -%}
            {%- elsif block.type == 'all_collections' -%}
              {%- liquid
                assign ac_max = block.settings.max_collections | default: 24 | times: 1
                if ac_max < 1
                  assign ac_max = 1
                elsif ac_max > 50
                  assign ac_max = 50
                endif
              -%}
              {%- assign ac_entry_first = true -%}
              {%- assign ac_emitted = 0 -%}
              {%- for collection in collections -%}
                {%- if block.settings.exclude_all_collection and collection.handle == 'all' -%}
                  {%- continue -%}
                {%- endif -%}
                {%- if block.settings.exclude_frontpage and collection.handle == 'frontpage' -%}
                  {%- continue -%}
                {%- endif -%}
                {%- if block.settings.hide_empty and collection.products_count == 0 -%}
                  {%- continue -%}
                {%- endif -%}
                {%- if ac_emitted >= ac_max -%}
                  {%- break -%}
                {%- endif -%}
                {%- assign ac_emitted = ac_emitted | plus: 1 -%}
                {%- assign entry_i = entry_i | plus: 1 -%}
                {%- assign href = collection.url -%}
                {%- assign title = collection.title | default: href -%}
                {%- assign open_tab = block.settings.open_new_tab -%}
                {%- assign is_active_row = false -%}
                {%- if entry_i == default_zero -%}
                  {%- assign is_active_row = true -%}
                {%- endif -%}
                <li
                  class="coll-list__item{% if is_active_row %} is-active{% endif %}"
                  data-coll-list-item
                  data-coll-list-index="{{ entry_i }}"
                  {% if ac_entry_first -%}
                    {{ block.shopify_attributes }}
                    {%- assign ac_entry_first = false -%}
                  {%- endif %}
                >
                  <a
                    class="coll-list__entry"
                    href="{{ href }}"
                    data-coll-list-entry
                    data-coll-list-index="{{ entry_i }}"
                    {% if open_tab %}
                      target="_blank" rel="noopener noreferrer"
                    {% endif %}
                  >
                    <span class="coll-list__entry-main">
                      <span class="coll-list__entry-title">{{ title | escape }}</span>
                      {%- if section.settings.show_product_count -%}
                        <span class="coll-list__entry-count">
                          {{ 'collections.general.product_count' | t: count: collection.products_count }}
                        </span>
                      {%- endif -%}
                    </span>
                    {%- if section.settings.show_arrow_icon -%}
                      <span class="coll-list__arrow" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M5 12h14"/>
                          <path d="m12 5 7 7-7 7"/>
                        </svg>
                      </span>
                    {%- endif -%}
                  </a>
                </li>
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- else -%}
      {%- if has_intro -%}
        <ul class="coll-list__entries coll-list__entries--empty" role="list">
          <li class="coll-list__item coll-list__item--intro">
            <header class="coll-list__intro product-slider__intro-copy">
              {%- if section.settings.eyebrow_text != blank -%}
                <p class="product-slider__eyebrow">{{ section.settings.eyebrow_text | escape }}</p>
              {%- endif -%}
              {%- if section.settings.heading != blank -%}
                <h2 class="product-slider__heading">{{ section.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if section.settings.description != blank -%}
                <div class="coll-list__description rte">{{ section.settings.description }}</div>
              {%- endif -%}
            </header>
          </li>
        </ul>
      {%- endif -%}
      <p class="coll-list__empty">{{ 'sections.collection_list.empty' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.collection_list.headers.content"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "t:sections.collection_list.labels.eyebrow_text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collection_list.labels.heading",
      "default": "Essential collections"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.collection_list.labels.heading_size",
      "default": "large",
      "options": [
        { "value": "small", "label": "t:sections.collection_list.options.heading_size.small" },
        { "value": "medium", "label": "t:sections.collection_list.options.heading_size.medium" },
        { "value": "large", "label": "t:sections.collection_list.options.heading_size.large" },
        { "value": "xlarge", "label": "t:sections.collection_list.options.heading_size.xlarge" }
      ]
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.collection_list.labels.description"
    },
    {
      "type": "range",
      "id": "default_active_index",
      "label": "t:sections.collection_list.labels.default_active_index",
      "info": "t:sections.collection_list.info.default_active_index",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "t:sections.collection_list.headers.layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.collection_list.labels.full_width",
      "info": "t:sections.collection_list.info.full_width",
      "default": false
    },
    {
      "type": "select",
      "id": "image_column_width",
      "label": "t:sections.collection_list.labels.image_column_width",
      "default": "50",
      "options": [
        { "value": "40", "label": "40%" },
        { "value": "50", "label": "50%" },
        { "value": "60", "label": "60%" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.collection_list.labels.image_ratio",
      "default": "landscape",
      "options": [
        { "value": "square", "label": "t:sections.collection_list.options.image_ratio.square" },
        { "value": "landscape", "label": "t:sections.collection_list.options.image_ratio.landscape" },
        { "value": "portrait", "label": "t:sections.collection_list.options.image_ratio.portrait" }
      ]
    },
    {
      "type": "select",
      "id": "image_border_radius",
      "label": "t:sections.collection_list.labels.image_border_radius",
      "default": "medium",
      "options": [
        { "value": "none", "label": "t:sections.collection_list.options.radius.none" },
        { "value": "small", "label": "t:sections.collection_list.options.radius.small" },
        { "value": "medium", "label": "t:sections.collection_list.options.radius.medium" },
        { "value": "large", "label": "t:sections.collection_list.options.radius.large" }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.collection_list.headers.entry_style"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "t:sections.collection_list.labels.show_product_count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrow_icon",
      "label": "t:sections.collection_list.labels.show_arrow_icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "entry_divider",
      "label": "t:sections.collection_list.labels.entry_divider",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "entry_title_use_scheme_colors",
      "label": "t:sections.collection_list.labels.entry_title_use_scheme_colors",
      "info": "t:sections.collection_list.info.entry_title_use_scheme_colors",
      "default": true
    },
    {
      "type": "color",
      "id": "active_title_color",
      "label": "t:sections.collection_list.labels.active_title_color",
      "default": "#1A1A1A",
      "visible_if": "{{ section.settings.entry_title_use_scheme_colors == false }}"
    },
    {
      "type": "color",
      "id": "inactive_title_color",
      "label": "t:sections.collection_list.labels.inactive_title_color",
      "default": "#999999",
      "visible_if": "{{ section.settings.entry_title_use_scheme_colors == false }}"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "t:sections.collection_list.labels.title_size",
      "default": "large",
      "options": [
        { "value": "small", "label": "t:sections.collection_list.options.title_size.small" },
        { "value": "medium", "label": "t:sections.collection_list.options.title_size.medium" },
        { "value": "large", "label": "t:sections.collection_list.options.title_size.large" }
      ]
    },
    {
      "type": "select",
      "id": "hover_transition_speed",
      "label": "t:sections.collection_list.labels.hover_transition_speed",
      "default": "300",
      "options": [
        { "value": "150", "label": "t:sections.collection_list.options.transition.fast" },
        { "value": "300", "label": "t:sections.collection_list.options.transition.normal" },
        { "value": "500", "label": "t:sections.collection_list.options.transition.slow" }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.collection_list.headers.animation"
    },
    {
      "type": "checkbox",
      "id": "entrance_animate_on_scroll",
      "label": "t:sections.collection_list.labels.entrance_animate_on_scroll",
      "info": "t:sections.collection_list.info.entrance_animate_on_scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.collection_list.headers.colour"
    },
    {
      "type": "select",
      "id": "section_color_scheme_mode",
      "label": "t:sections.collection_list.section_color_scheme_mode",
      "options": [
        { "value": "default", "label": "t:sections.collection_list.section_color_scheme_mode_default" },
        { "value": "custom", "label": "t:sections.collection_list.section_color_scheme_mode_custom" }
      ],
      "default": "default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.collection_list.color_scheme",
      "info": "t:sections.collection_list.color_scheme_info",
      "default": "scheme-6",
      "visible_if": "{{ section.settings.section_color_scheme_mode == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:sections.collection_list.headers.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.collection_list.labels.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.collection_list.labels.padding_right",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.collection_list.labels.padding_bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 80,
