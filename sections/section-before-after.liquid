        { "value": "30", "label": "t:sections.before_after.options.column_layout.30" },
        { "value": "40", "label": "t:sections.before_after.options.column_layout.40" },
        { "value": "50", "label": "t:sections.before_after.options.column_layout.50" }
      ]
    },
    {
      "type": "select",
      "id": "image_border_radius",
      "label": "t:sections.before_after.labels.image_border_radius",
      "default": "medium",
      "options": [
        { "value": "none", "label": "t:sections.before_after.options.radius.none" },
        { "value": "small", "label": "t:sections.before_after.options.radius.small" },
        { "value": "medium", "label": "t:sections.before_after.options.radius.medium" },
        { "value": "large", "label": "t:sections.before_after.options.radius.large" }
      ]
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.before_after.labels.full_width",
      "info": "t:sections.before_after.info.full_width",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.before_after.headers.slider"
    },
    {
      "type": "select",
      "id": "media_size",
      "label": "t:sections.before_after.labels.media_size",
      "info": "t:sections.before_after.info.media_size",
      "default": "medium",
      "options": [
        { "value": "small", "label": "t:sections.before_after.options.media_size.small" },
        { "value": "medium", "label": "t:sections.before_after.options.media_size.medium" },
        { "value": "large", "label": "t:sections.before_after.options.media_size.large" },
        { "value": "xlarge", "label": "t:sections.before_after.options.media_size.xlarge" }
      ]
    },
    {
      "type": "image_picker",
      "id": "before_image",
