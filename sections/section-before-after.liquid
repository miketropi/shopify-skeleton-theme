{%- liquid
  assign ba_scheme = settings.global_color_scheme
  if ba_scheme == blank or ba_scheme.settings == blank
    assign ba_scheme = settings.color_schemes['scheme-6']
  endif

  assign basm = section.settings.section_color_scheme_mode
  if basm == 'custom'
    assign picked_ba = section.settings.color_scheme
    if picked_ba != blank and picked_ba.settings != blank
      assign ba_scheme = picked_ba
    endif
  elsif basm == 'default'
  else
    assign picked_ba = section.settings.color_scheme
    if picked_ba != blank and picked_ba.settings != blank
      assign ba_scheme = picked_ba
    endif
  endif

  assign col_key = section.settings.column_layout | default: '40'
  assign intro_fr = '4fr'
  assign slider_fr = '6fr'
  case col_key
    when '30'
      assign intro_fr = '3fr'
      assign slider_fr = '7fr'
    when '50'
      assign intro_fr = '5fr'
      assign slider_fr = '5fr'
  endcase

  assign rad_key = section.settings.image_border_radius | default: 'medium'
  case rad_key
    when 'none'
      assign rad_px = 0
    when 'small'
      assign rad_px = 8
    when 'large'
      assign rad_px = 24
    else
      assign rad_px = 16
  endcase

  assign media_size_key = section.settings.media_size | default: 'medium'
  assign media_img_width = 1200
  assign media_img_widths = '400,600,800,1200,1600'
  case media_size_key
    when 'small'
      assign media_img_width = 600
      assign media_img_widths = '300,450,600'
    when 'large'
      assign media_img_width = 1600
      assign media_img_widths = '400,600,800,1200,1600'
    when 'xlarge'
      assign media_img_width = 2400
      assign media_img_widths = '600,800,1200,1600,2400'
  endcase

  assign initial_pos = section.settings.initial_position | default: 50
  assign divider_c = section.settings.divider_color | default: '#FFFFFF'

  assign handle_interaction = section.settings.handle_interaction | default: 'drag'
  if handle_interaction != 'follow_cursor'
    assign handle_interaction = 'drag'
  endif

  assign aspect_value = '4 / 3'
  if section.settings.before_image != blank and section.settings.before_image.aspect_ratio
    assign aspect_value = section.settings.before_image.aspect_ratio
  endif

  assign has_intro = false
  if section.settings.eyebrow_text != blank or section.settings.heading != blank or section.settings.description != blank
    assign has_intro = true
  endif

  assign show_cta = false
  if section.settings.button_label != blank and section.settings.button_link != blank
    assign show_cta = true
  endif

  assign intro_btn_style = section.settings.button_style | default: 'primary'
  if intro_btn_style == 'filled'
    assign intro_btn_style = 'primary'
  elsif intro_btn_style == 'outlined'
    assign intro_btn_style = 'outline'
  endif
  if intro_btn_style != 'primary' and intro_btn_style != 'outline' and intro_btn_style != 'ghost'
    assign intro_btn_style = 'primary'
  endif
-%}
{%- capture ba_scheme_vars -%}
  {%- render 'color-scheme-vars', scheme: ba_scheme, inline_only: true -%}
{%- endcapture -%}

{%- render 'section-styles', section: section -%}

<div
  class="section-{{ section.id }} before-after shopify-section-wrapper section-intro--heading-{{ section.settings.heading_size | default: 'large' }} before-after--interaction-{{ handle_interaction }}{% if section.settings.full_width %} full-width before-after--full-width{% endif %}"
  data-section-type="section-before-after"
  data-section-id="{{ section.id }}"
  data-before-after-initial="{{ initial_pos }}"
  data-before-after-interaction="{{ handle_interaction }}"
  data-before-after-entrance-scroll="{% if section.settings.entrance_animate_on_scroll == false %}false{% else %}true{% endif %}"
  style="
    {{ ba_scheme_vars }}
    --before-after-intro-fr: {{ intro_fr }};
    --before-after-slider-fr: {{ slider_fr }};
    --before-after-img-radius: {{ rad_px }}px;
    --before-after-divider: {{ divider_c }};
    --before-after-aspect: {{ aspect_value }};
  "
  {{ section.shopify_attributes }}
>
  <div class="before-after__inner{% if section.settings.full_width %} section-content-width{% endif %}">
    <div class="before-after__grid">
      {%- if has_intro or show_cta -%}
        <div class="before-after__intro-col" data-before-after-reveal>
          <div class="before-after__intro section-intro__copy">
            {%- if section.settings.eyebrow_text != blank -%}
              <p class="section-intro__eyebrow">{{ section.settings.eyebrow_text | escape }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="section-intro__heading">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.description != blank -%}
              <div class="before-after__description rte">{{ section.settings.description }}</div>
            {%- endif -%}
            {%- if show_cta -%}
              <div class="home-slider__actions">
                <a
                  class="before-after__btn before-after__btn--{{ intro_btn_style }}"
                  href="{{ section.settings.button_link }}"
                >
                  {{ section.settings.button_label | escape }}
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- render 'before-after-slider',
        section: section,
        initial_position: initial_pos,
        img_radius_px: rad_px,
        divider_color: divider_c,
        media_img_width: media_img_width,
        media_img_widths: media_img_widths
      -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.before_after.name",
  "tag": "section",
  "class": "section-before-after",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.before_after.headers.intro"
    },
    {
