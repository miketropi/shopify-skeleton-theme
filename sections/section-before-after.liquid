      "id": "eyebrow_text",
      "label": "t:sections.before_after.labels.eyebrow_text",
      "default": "Real Results. Visible Change"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.before_after.labels.heading",
      "default": "Before & After Skin Results"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.before_after.labels.heading_size",
      "default": "large",
      "options": [
        { "value": "small", "label": "t:sections.before_after.options.heading_size.small" },
        { "value": "medium", "label": "t:sections.before_after.options.heading_size.medium" },
        { "value": "large", "label": "t:sections.before_after.options.heading_size.large" },
        { "value": "xlarge", "label": "t:sections.before_after.options.heading_size.xlarge" }
      ]
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.before_after.labels.description",
      "default": "See the difference with skincare designed to improve texture and enhance radiance."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.before_after.labels.button_label",
      "default": "Explore Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.before_after.labels.button_link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.before_after.labels.button_style",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "t:sections.home_slider.options.button_style.primary" },
        { "value": "outline", "label": "t:sections.home_slider.options.button_style.outline" },
        { "value": "ghost", "label": "t:sections.home_slider.options.button_style.ghost" }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.before_after.headers.layout"
    },
    {
      "type": "select",
      "id": "column_layout",
      "label": "t:sections.before_after.labels.column_layout",
      "default": "40",
