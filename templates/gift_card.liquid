{% layout none %}

<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    {%- assign gift_value = gift_card.initial_value | money_without_trailing_zeros -%}
    <title>{{ 'gift_cards.issued.title' | t: value: gift_value, shop: shop.name }}</title>

    {{ content_for_header }}

    {{ 'critical.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="gift-card">
    <div class="gift-card__wrapper">
      <header class="gift-card__header">
        <a href="{{ routes.root_url }}" class="gift-card__shop-name">
          {{- shop.name | escape -}}
        </a>
      </header>

      <main class="gift-card__main">
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="gift-card__tag">{{- 'gift_cards.issued.expired' | t -}}</p>
        {%- endif -%}

        <h1 class="gift-card__title">
          {{- 'gift_cards.issued.subtext' | t -}}
        </h1>

        {%- if gift_card.image -%}
          {{
            gift_card.image
            | image_url: width: 600
            | image_tag: loading: 'eager', class: 'gift-card__image'
          }}
        {%- endif -%}

        <div class="gift-card__price">
          {%- if gift_card.balance != gift_card.initial_value -%}
            <p class="gift-card__balance">
              {%- render 'price-display', price: gift_card.balance, variant: 'gift' -%}
              <span class="gift-card__balance-note">{{ 'gift_cards.issued.remaining_suffix' | t }}</span>
            </p>
          {%- endif -%}
          <p class="gift-card__initial-value">
            {%- render 'price-display', price: gift_card.initial_value, variant: 'gift', omit_zero_cents: true -%}
          </p>
        </div>

        <div class="gift-card__code-wrapper">
          <input
            type="text"
            class="gift-card__code"
            id="GiftCardDigits"
            value="{{ gift_card.code | format_code }}"
            aria-label="{{ 'gift_cards.issued.gift_card_code' | t }}"
            readonly
          >
          <button
            class="gift-card__copy btn"
            data-copy-target="GiftCardDigits"
            type="button"
          >
            {{- 'gift_cards.issued.copy_code' | t -}}
          </button>
        </div>

        <a
          href="{{ shop.url }}"
          class="gift-card__shop-link btn btn--primary"
          target="_blank"
          rel="noopener"
        >
          {{- 'gift_cards.issued.shop_link' | t -}}
        </a>
      </main>
    </div>
    <script>
      (function () {
        var btn = document.querySelector('[data-copy-target]');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-copy-target');
          var el = id ? document.getElementById(id) : null;
          if (!el) return;
          el.select();
          el.setSelectionRange(0, 99999);
          try {
            navigator.clipboard.writeText(el.value);
          } catch (e) {
            document.execCommand('copy');
          }
        });
      })();
    </script>
  </body>
</html>
