[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Color schemes",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:info.colors_intro"
      },
      {
        "type": "select",
        "id": "color_mode",
        "label": "t:labels.color_mode",
        "options": [
          {
            "value": "preset",
            "label": "t:options.color_mode.preset"
          },
          {
            "value": "custom",
            "label": "t:options.color_mode.custom"
          }
        ],
        "default": "preset"
      },
      {
        "type": "header",
        "content": "t:headers.custom_colors",
        "visible_if": "{{ settings.color_mode == 'custom' }}"
      },
      {
        "type": "paragraph",
        "content": "t:info.colors_custom",
        "visible_if": "{{ settings.color_mode == 'custom' }}"
      },
      {
        "type": "header",
        "content": "Surface",
        "visible_if": "{{ settings.color_mode == 'custom' }}"
      },
      {
        "type": "color",
        "id": "custom_color_background",
        "label": "t:labels.custom_background",
        "default": "#ffffff",
        "visible_if": "{{ settings.color_mode == 'custom' }}"
      },
      {
        "type": "color",
        "id": "custom_color_background_secondary",
        "label": "t:labels.custom_background_secondary",
        "default": "#f5f3ef",
        "visible_if": "{{ settings.color_mode == 'custom' }}"
      },
      {
        "type": "color",
        "id": "custom_color_border",
        "label": "t:labels.custom_border",
        "default": "#e8e6e1",
        "visible_if": "{{ settings.color_mode == 'custom' }}"
      },
      {
        "type": "header",
        "content": "Text",
        "visible_if": "{{ settings.color_mode == 'custom' }}"
      },
      {
        "type": "color",
        "id": "custom_color_text",
        "label": "t:labels.custom_text",
        "default": "#1a1a1a",
        "visible_if": "{{ settings.color_mode == 'custom' }}"
      },
      {
        "type": "color",
        "id": "custom_color_text_secondary",
        "label": "t:labels.custom_text_secondary",
        "default": "#9e9b96",
        "visible_if": "{{ settings.color_mode == 'custom' }}"
      },
      {
        "type": "color",
        "id": "custom_color_heading",
